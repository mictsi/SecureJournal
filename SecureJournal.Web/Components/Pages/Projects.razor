@page "/projects"
@attribute [Authorize]
@inject ISecureJournalAppService JournalApp
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>My Projects</PageTitle>

<PageHeader Title="My projects"
            Description="Choose a project, find a record, or capture what happened next.">
    <Actions>
        <button type="button" class="sk-button sk-button--secondary" disabled="@(SelectedProject is null || _currentUser?.Role == AppRole.Auditor)" @onclick="RefreshSelectedProjectEntries">
            <svg class="sk-button__icon" aria-hidden="true" focusable="false" width="16" height="16"><use href="#sk-icon-refresh" /></svg>
            Refresh entries
        </button>
    </Actions>
</PageHeader>

<PageAlerts Message="@_message" Error="@_error" />

<div class="my-projects-shell">
    <aside class="panel-card my-project-directory-card">
        @if (SelectedProject is { } currentProject)
        {
            <div class="my-project-picker-summary">
                <div class="my-project-picker-current">
                    <span class="my-project-directory-subtitle">Current project</span>
                    <strong>@currentProject.Name</strong>
                </div>
                <button type="button"
                        class="sk-button sk-button--secondary sk-button--sm"
                        aria-expanded="@(_projectPickerOpen ? "true" : "false")"
                        aria-controls="project-picker-directory"
                        @ref="_projectPickerToggle"
                        @onclick="() => _projectPickerOpen = !_projectPickerOpen">
                    @(_projectPickerOpen ? "Close picker" : "Change project")
                </button>
            </div>
        }

        <div id="project-picker-directory" class="my-project-picker-content @(_projectPickerOpen || SelectedProject is null ? "is-open" : string.Empty)">
        <div class="my-project-directory-header">
            <div>
                <h3>Projects</h3>
                <p class="my-project-directory-copy">Browse the projects you can access</p>
            </div>
            <span class="my-project-directory-total">@FilteredProjectCount of @_projects.Count</span>
        </div>

        <div class="my-project-directory-toolbar">
            <label class="sk-visually-hidden" for="projectListSearch">Search projects</label>
            <input id="projectListSearch"
                   class="sk-input"
                   type="text"
                   value="@_projectSearchText"
                   @oninput="OnProjectFilterChanged"
                   placeholder="Search projects..." />
        </div>

        @if (_projects.Count == 0)
        {
            <div class="my-project-directory-empty">
                <h3>Your workspace is ready</h3>
                <p>Projects appear here when you have access.</p>
                @if (_currentUser?.Role == AppRole.Administrator)
                {
                    <a class="sk-button sk-button--primary" href="/admin/projects/create">Create your first project</a>
                }
                else
                {
                    <p>Ask an administrator to add you to a project group.</p>
                }
            </div>
        }
        else if (FilteredProjectCount == 0)
        {
            <div class="my-project-directory-empty">
                <p>No projects match the current search text.</p>
                <button class="sk-button sk-button--secondary sk-button--sm" type="button" @onclick="ClearProjectSearch">Clear search</button>
            </div>
        }
        else
        {
            <div class="my-project-directory-list">
                @foreach (var project in VisibleProjects)
                {
                    <button type="button"
                            class="my-project-directory-item @(_selectedProjectId == project.ProjectId ? "is-active" : string.Empty)"
                            aria-pressed="@(_selectedProjectId == project.ProjectId ? "true" : "false")"
                            @onclick="() => SelectProject(project.ProjectId)">
                        <span class="my-project-avatar" aria-hidden="true">@ProjectInitial(project)</span>
                        <span class="my-project-directory-item-body">
                            <span class="my-project-directory-name">@project.Name</span>
                            <span class="my-project-directory-subtitle">@project.Code</span>
                            <span class="my-project-chip-list">
                                @if (project.AssignedGroups.Count == 0)
                                {
                                    <span class="my-project-chip is-empty">No groups</span>
                                }
                                else
                                {
                                    @foreach (var groupName in project.AssignedGroups.Take(3))
                                    {
                                        <span class="my-project-chip">@groupName</span>
                                    }
                                    @if (project.AssignedGroups.Count > 3)
                                    {
                                        <span class="my-project-chip">+@(project.AssignedGroups.Count - 3) more</span>
                                    }
                                }
                            </span>
                        </span>
                    </button>
                }
            </div>

            <div class="my-project-directory-footer">
                @if (ProjectListTotalPages > 1)
                {
                <div class="my-project-directory-footer-row">
                    <span>Page @_projectListPage of @ProjectListTotalPages</span>
                    <div class="sk-cluster">
                        <button type="button" class="sk-button sk-button--secondary sk-button--sm" disabled="@(_projectListPage <= 1)" @onclick="GoToPreviousProjectListPage">Previous</button>
                        <button type="button" class="sk-button sk-button--secondary sk-button--sm" disabled="@(_projectListPage >= ProjectListTotalPages)" @onclick="GoToNextProjectListPage">Next</button>
                    </div>
                </div>
                }
                <div class="my-project-directory-footer-row">
                    <span>@VisibleProjectRangeLabel()</span>
                    @if (FilteredProjectCount > _projectListPageSizeOptions[0])
                    {
                    <div class="my-project-page-size">
                        <label class="project-page-size-label" for="projectListPageSize">Page size</label>
                        <div class="sk-select-wrapper">
                            <select id="projectListPageSize" class="sk-select sk-select--sm project-page-size-select" @onchange="OnProjectListPageSizeChanged">
                            @foreach (var pageSize in _projectListPageSizeOptions)
                            {
                                <option value="@pageSize" selected="@(pageSize == _projectListPageSize)">@pageSize</option>
                            }
                        </select>
                        </div>
                    </div>
                    }
                </div>
            </div>
        }
        </div>
    </aside>

    @if (_projects.Count > 0)
    {
    <div class="my-project-detail-column">

        @if (SelectedProject is null)
        {
            <section class="panel-card my-project-empty-card">
                <h3>Select a project</h3>
                <p>Choose a project from the directory to review details and browse journal entries.</p>
            </section>
        }
        else
        {
            <section class="panel-card my-project-journal-card">
                <div class="panel-card-header my-project-section-header">
                    <div>
                        <p class="my-project-section-kicker">@SelectedProject.Code · Project journal</p>
                        <h3>@JournalEntriesPanelTitle</h3>
                        <p class="my-project-section-copy">A shared record of decisions, updates, and events.</p>
                    </div>
                    <div class="panel-card-header-actions">
                        @if (_selectedProjectId.HasValue && _currentUser?.Role != AppRole.Auditor)
                        {
                            <a href="@NewEntryUrl" class="sk-button sk-button--primary"><svg class="sk-button__icon" aria-hidden="true" focusable="false" width="16" height="16"><use href="#sk-icon-plus" /></svg>New entry</a>
                        }
                    </div>
                </div>

                @if (_currentUser?.Role == AppRole.Auditor)
                {
                    <p>Auditors can use this page to identify projects but cannot directly read journal entries. Use <a href="/audit">Audit Search</a> for evidence and activity.</p>
                }
                else
                {
                    <div class="my-project-journal-toolbar">
                        <div class="sk-field my-project-journal-search">
                            <label class="sk-field__label" for="projectJournalSearch">Search</label>
                            <input id="projectJournalSearch"
                                   class="sk-input"
                                   type="search"
                                   value="@_searchText"
                                   @oninput="OnSearchChanged"
                                   placeholder="Search subject, description, notes..." />
                        </div>
                        <div class="sk-field">
                            <label class="sk-field__label" for="projectJournalPageSize">Entries per page</label>
                            <div class="sk-select-wrapper">
                                <select id="projectJournalPageSize" class="sk-select" @onchange="OnPageSizeChanged">
                                @foreach (var pageSize in _pageSizeOptions)
                                {
                                    <option value="@pageSize" selected="@(pageSize == _pageSize)">@pageSize</option>
                                }
                            </select>
                            </div>
                        </div>
                        <div class="sk-field">
                            <label class="sk-field__label" for="projectJournalSort">Sort by date</label>
                            <div class="sk-select-wrapper">
                                <select id="projectJournalSort" class="sk-select" @onchange="OnSortOrderChanged">
                                <option value="@DateSortNewest" selected="@(_dateSortOrder == DateSortNewest)">Newest first</option>
                                <option value="@DateSortOldest" selected="@(_dateSortOrder == DateSortOldest)">Oldest first</option>
                            </select>
                            </div>
                        </div>
                    </div>
                    <div class="my-project-journal-tools">
                        <p class="sj-muted" role="status">@FilteredEntries.Count() @(FilteredEntries.Count() == 1 ? "entry" : "entries")</p>
                        @if (!string.IsNullOrWhiteSpace(_searchText))
                        {
                            <button type="button" class="sk-button sk-button--secondary sk-button--sm" @onclick="ClearEntrySearch">Clear search</button>
                        }
                        @if (_currentUser?.Role == AppRole.Administrator)
                        {
                            <label class="sk-checkbox">
                                    <input id="projectIncludeDeleted"
                                           class="sk-checkbox__input"
                                           type="checkbox"
                                           checked="@_includeSoftDeleted"
                                           @onchange="OnIncludeSoftDeletedChanged" />
                                <span class="sk-checkbox__box" aria-hidden="true"></span>
                                <span class="sk-checkbox__content">
                                    <span class="sk-checkbox__label">Show deleted entries</span>
                                </span>
                            </label>
                        }
                    </div>

                    @if (!_entries.Any())
                    {
                        <div class="sk-empty-state">
                            <svg class="sk-empty-state__icon" aria-hidden="true" focusable="false" width="48" height="48"><use href="#sk-icon-book" /></svg>
                            <h3 class="sk-empty-state__heading">Start this project's story</h3>
                            <p class="sk-empty-state__body">Record a decision, milestone, or update. Each entry becomes part of the project's history.</p>
                            <a href="@NewEntryUrl" class="sk-button sk-button--primary">Create the first entry</a>
                        </div>
                    }
                    else if (!FilteredEntries.Any())
                    {
                        <div class="sk-empty-state">
                            <h3 class="sk-empty-state__heading">No matching entries</h3>
                            <p class="sk-empty-state__body">Try a shorter phrase. Search looks in subjects, descriptions, and notes.</p>
                            <button type="button" class="sk-button sk-button--secondary" @onclick="ClearEntrySearch">Clear search</button>
                        </div>
                    }
                    else
                    {
                        @* Genuinely tabular data: it was previously built from divs with an
                           aria-hidden header row, so the column names never reached a screen
                           reader and every cell lost its association with its header. *@
                        <div class="sk-table entry-list" role="region" aria-labelledby="entry-list-caption" tabindex="0">
                            <table role="table">
                                <caption id="entry-list-caption" class="sk-visually-hidden">
                                    Journal entries
                                    <span class="sk-table__caption-detail">@VisibleEntries.Count() shown</span>
                                </caption>
                                <thead role="rowgroup">
                                    <tr role="row">
                                        <th scope="col" role="columnheader" class="entry-col-created">Created (UTC)</th>
                                        <th scope="col" role="columnheader" class="entry-col-subject">Subject</th>
                                        <th scope="col" role="columnheader" class="entry-col-status">Status</th>
                                        <th scope="col" role="columnheader" class="entry-col-actions"><span class="sk-visually-hidden">Actions</span></th>
                                    </tr>
                                </thead>
                                <tbody role="rowgroup">
                                    @foreach (var entry in VisibleEntries)
                                    {
                                        <tr role="row" class="@(entry.IsSoftDeleted ? "is-soft-deleted" : string.Empty)">
                                            <td role="cell" class="entry-col-created">
                                                <time datetime="@entry.CreatedAtUtc.ToString("o")" title="@entry.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm:ss 'UTC'")">@entry.CreatedAtUtc.ToString("dd MMM yyyy")</time><span class="entry-mobile-zone" aria-hidden="true"> UTC</span>
                                                <span class="entry-created-by">by @entry.CreatedBy</span>
                                            </td>
                                            <th scope="row" role="rowheader" class="entry-col-subject">
                                                <a class="sk-link" href="@GetEntryDetailsUrl(entry)">@entry.Subject</a>
                                            </th>
                                            <td role="cell" class="entry-col-status">
                                                @if (entry.IsSoftDeleted)
                                                {
                                                    <span class="sk-badge sk-badge--warning">Soft-deleted</span>
                                                }
                                                else
                                                {
                                                    <span class="sk-badge sk-badge--success">Active</span>
                                                }
                                            </td>
                                            <td role="cell" class="entry-col-actions">
                                                <div class="sk-cluster sk-cluster--end sk-cluster--gap-8">
                                                    <a href="@GetEntryDetailsUrl(entry)" class="sk-button sk-button--secondary sk-button--sm">
                                                        View<span class="sk-visually-hidden"> @entry.Subject</span>
                                                    </a>
                                                    @if (!entry.IsSoftDeleted)
                                                    {
                                                        <button type="button" class="sk-button sk-button--secondary sk-button--sm" @onclick="() => SoftDeleteAsync(entry)">
                                                            Delete<span class="sk-visually-hidden"> @entry.Subject</span>
                                                        </button>
                                                    }
                                                    else if (_currentUser?.Role == AppRole.Administrator)
                                                    {
                                                        <button type="button" class="sk-button sk-button--success sk-button--sm" @onclick="() => Restore(entry.RecordId)">
                                                            Restore<span class="sk-visually-hidden"> @entry.Subject</span>
                                                        </button>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div class="pager-bar">
                            <div class="sj-muted">Page @_currentPage of @TotalPages (@FilteredEntries.Count() matching)</div>
                            <div class="sk-cluster">
                                <button type="button" class="sk-button sk-button--secondary sk-button--sm" disabled="@(_currentPage <= 1)" @onclick="PreviousPage">Previous</button>
                                <button type="button" class="sk-button sk-button--secondary sk-button--sm" disabled="@(_currentPage >= TotalPages)" @onclick="NextPage">Next</button>
                            </div>
                        </div>
                    }
                }
            </section>
        }
    </div>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "projectId")]
    public Guid? ProjectId { get; set; }

    [SupplyParameterFromQuery(Name = "saved")]
    public Guid? SavedEntryId { get; set; }

    private const string DateSortNewest = "newest";
    private const string DateSortOldest = "oldest";
    private readonly int[] _pageSizeOptions = [5, 10, 20, 50];
    private readonly int[] _projectListPageSizeOptions = [10, 20, 50, 100];

    private UserContext? _currentUser;
    private List<ProjectOverview> _projects = new();
    private List<JournalEntryView> _entries = new();
    private Guid? _selectedProjectId;
    private bool _includeSoftDeleted;
    private string _searchText = string.Empty;
    private int _pageSize = 20;
    private int _currentPage = 1;
    private string _dateSortOrder = DateSortNewest;
    private string _projectSearchText = string.Empty;
    private int _projectListPageSize = 20;
    private int _projectListPage = 1;
    private string? _message;
    private string? _error;
    private Guid? _lastSavedEntryId;
    private bool _projectPickerOpen;
    private bool _focusProjectPicker;
    private ElementReference _projectPickerToggle;

    private ProjectOverview? SelectedProject
        => _selectedProjectId is { } id
            ? _projects.FirstOrDefault(p => p.ProjectId == id)
            : null;

    private IReadOnlyList<ProjectOverview> FilteredProjects
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_projectSearchText))
            {
                return _projects;
            }

            var term = _projectSearchText.Trim();
            return _projects
                .Where(p =>
                    p.Code.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    p.Name.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    p.Description.Contains(term, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
    }

    private int FilteredProjectCount => FilteredProjects.Count;

    private int ProjectListTotalPages
    {
        get
        {
            var count = FilteredProjectCount;
            return Math.Max(1, (int)Math.Ceiling(count / (double)_projectListPageSize));
        }
    }

    private IEnumerable<ProjectOverview> VisibleProjects
    {
        get
        {
            var page = Math.Clamp(_projectListPage, 1, ProjectListTotalPages);
            return FilteredProjects
                .Skip((page - 1) * _projectListPageSize)
                .Take(_projectListPageSize);
        }
    }

    private IEnumerable<JournalEntryView> FilteredEntries
        => _entries.Where(e =>
            string.IsNullOrWhiteSpace(_searchText) ||
            e.Subject.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ||
            e.Description.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ||
            e.Notes.Contains(_searchText, StringComparison.OrdinalIgnoreCase));

    private IEnumerable<JournalEntryView> SortedEntries
        => _dateSortOrder == DateSortOldest
            ? FilteredEntries.OrderBy(e => e.CreatedAtUtc)
            : FilteredEntries.OrderByDescending(e => e.CreatedAtUtc);

    private IEnumerable<JournalEntryView> VisibleEntries
        => SortedEntries.Skip((_currentPage - 1) * _pageSize).Take(_pageSize);

    private int TotalPages
    {
        get
        {
            var count = FilteredEntries.Count();
            return Math.Max(1, (int)Math.Ceiling(count / (double)_pageSize));
        }
    }

    private string JournalEntriesPanelTitle
        => SelectedProject is { } project
            ? project.Name
            : "Project Journal Entries";

    private string NewEntryUrl => _selectedProjectId is { } id ? $"/journal?projectId={id:D}" : "/journal";

    protected override void OnParametersSet()
    {
        if (_currentUser is null || _currentUser.Role == AppRole.Auditor)
        {
            return;
        }

        var nextProjectId = ProjectId is { } id && _projects.Any(project => project.ProjectId == id)
            ? id
            : _projects.FirstOrDefault()?.ProjectId;
        if (nextProjectId != _selectedProjectId)
        {
            _selectedProjectId = nextProjectId;
            _searchText = string.Empty;
            _currentPage = 1;
            _message = null;
            RefreshSelectedProjectEntries();
        }

        if (SavedEntryId != _lastSavedEntryId)
        {
            _lastSavedEntryId = SavedEntryId;
            _message = SavedEntryId is { } savedId && _entries.FirstOrDefault(entry => entry.RecordId == savedId) is { } savedEntry
                ? $"“{savedEntry.Subject}” was saved to this project."
                : null;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (!await JournalApp.HasCurrentUserAsync())
        {
            Navigation.NavigateTo("/", forceLoad: false);
            return;
        }

        await LoadPageAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusProjectPicker)
        {
            _focusProjectPicker = false;
            await _projectPickerToggle.FocusAsync(preventScroll: true);
        }
    }

    private async Task LoadPageAsync()
    {
        _currentUser = await JournalApp.GetCurrentUserAsync();
        if (_currentUser.Role == AppRole.Auditor)
        {
            Navigation.NavigateTo("/audit", replace: true);
            return;
        }

        _projects = JournalApp.GetProjects().Where(p => p.HasAccessForCurrentUser).ToList();
        _projectListPage = 1;

        if (ProjectId.HasValue && _projects.Any(p => p.ProjectId == ProjectId.Value))
        {
            _selectedProjectId = ProjectId.Value;
        }
        else if (!_selectedProjectId.HasValue || _projects.All(p => p.ProjectId != _selectedProjectId.Value))
        {
            _selectedProjectId = _projects.FirstOrDefault()?.ProjectId;
        }

        if (_currentUser?.Role != AppRole.Auditor)
        {
            RefreshSelectedProjectEntries();
        }
        else
        {
            _entries.Clear();
        }
    }

    private void OnProjectFilterChanged(ChangeEventArgs args)
    {
        _projectSearchText = args.Value?.ToString() ?? string.Empty;
        _projectListPage = 1;
    }

    private void OnProjectListPageSizeChanged(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var next) && _projectListPageSizeOptions.Contains(next))
        {
            _projectListPageSize = next;
            _projectListPage = 1;
        }
    }

    private void GoToPreviousProjectListPage()
    {
        if (_projectListPage > 1)
        {
            _projectListPage--;
        }
    }

    private void GoToNextProjectListPage()
    {
        if (_projectListPage < ProjectListTotalPages)
        {
            _projectListPage++;
        }
    }

    private void SelectProject(Guid projectId)
    {
        _focusProjectPicker = _projectPickerOpen;
        _projectPickerOpen = false;
        _message = null;
        _selectedProjectId = projectId;
        _searchText = string.Empty;
        _currentPage = 1;
        RefreshSelectedProjectEntries();
        Navigation.NavigateTo($"/projects?projectId={projectId:D}");
    }

    private void RefreshSelectedProjectEntries()
    {
        _error = null;

        if (!_selectedProjectId.HasValue || _currentUser?.Role == AppRole.Auditor)
        {
            _entries = new List<JournalEntryView>();
            _currentPage = 1;
            return;
        }

        try
        {
            _entries = JournalApp.GetJournalEntries(_selectedProjectId.Value, includeSoftDeleted: _includeSoftDeleted).ToList();
            _currentPage = Math.Min(_currentPage, TotalPages);
            _currentPage = Math.Max(_currentPage, 1);
        }
        catch (Exception ex)
        {
            _entries = new List<JournalEntryView>();
            _error = ex.Message;
            _currentPage = 1;
        }
    }

    private async Task SoftDeleteAsync(JournalEntryView entry)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"Delete “{entry.Subject}”? The entry will be hidden from the project journal. Its history is retained, and an administrator can restore it."))
        {
            return;
        }

        _message = null;
        _error = null;

        try
        {
            var deleted = JournalApp.SoftDeleteJournalEntry(entry.RecordId);
            _message = deleted ? $"“{entry.Subject}” was deleted. An administrator can restore it." : "Entry was already deleted or not found.";
            RefreshSelectedProjectEntries();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private void Restore(Guid recordId)
    {
        _message = null;
        _error = null;

        try
        {
            var restored = JournalApp.RestoreJournalEntry(recordId);
            _message = restored ? "Entry restored." : "Entry was already active or not found.";
            RefreshSelectedProjectEntries();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private void OnSearchChanged(ChangeEventArgs args)
    {
        _searchText = args.Value?.ToString() ?? string.Empty;
        _currentPage = 1;
    }

    private void ClearProjectSearch()
    {
        _projectSearchText = string.Empty;
        _projectListPage = 1;
    }

    private void ClearEntrySearch()
    {
        _searchText = string.Empty;
        _currentPage = 1;
    }

    private void OnPageSizeChanged(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var next) && _pageSizeOptions.Contains(next))
        {
            _pageSize = next;
            _currentPage = 1;
        }
    }

    private void OnSortOrderChanged(ChangeEventArgs args)
    {
        var selected = args.Value?.ToString();
        _dateSortOrder = selected == DateSortOldest ? DateSortOldest : DateSortNewest;
        _currentPage = 1;
    }

    private void OnIncludeSoftDeletedChanged(ChangeEventArgs args)
    {
        _includeSoftDeleted = args.Value switch
        {
            bool b => b,
            string s when bool.TryParse(s, out var parsed) => parsed,
            _ => false
        };

        _currentPage = 1;
        RefreshSelectedProjectEntries();
    }

    private void PreviousPage()
    {
        if (_currentPage > 1)
        {
            _currentPage--;
        }
    }

    private void NextPage()
    {
        if (_currentPage < TotalPages)
        {
            _currentPage++;
        }
    }

    private string VisibleProjectRangeLabel()
    {
        if (FilteredProjectCount == 0)
        {
            return "Showing 0 projects";
        }

        var start = ((_projectListPage - 1) * _projectListPageSize) + 1;
        var end = Math.Min(_projectListPage * _projectListPageSize, FilteredProjectCount);
        return $"Showing {start}-{end} of {FilteredProjectCount} projects";
    }

    private static string GetEntryDetailsUrl(JournalEntryView entry)
        => $"/projects/entry/{entry.RecordId:D}?projectId={entry.ProjectId:D}";

    private static string ProjectInitial(ProjectOverview project)
    {
        var source = string.IsNullOrWhiteSpace(project.Code) ? project.Name : project.Code;
        return string.IsNullOrWhiteSpace(source) ? "P" : source.Trim()[0].ToString().ToUpperInvariant();
    }

}
