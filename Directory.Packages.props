<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="HtmlSanitizer" Version="9.2.1039" />
    <PackageVersion Include="Markdig" Version="1.5.0" />
    <PackageVersion Include="Microsoft.ApplicationInsights.AspNetCore" Version="3.2.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Data.SqlClient.Extensions.Azure" Version="7.1.1" />
    <PackageVersion Include="Microsoft.Data.Sqlite.Core" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.13" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageVersion Include="TinyMCE" Version="8.10.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <!-- Keep transitive runtime and tooling dependencies on current stable releases. -->
  <ItemGroup>
    <PackageVersion Include="AngleSharp" Version="1.8.5" />
    <PackageVersion Include="AngleSharp.Css" Version="1.2.1" />
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
    <PackageVersion Include="Humanizer.Core" Version="3.0.10" />
    <PackageVersion Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Bcl.Cryptography" Version="10.0.13" />
    <!-- 18.10+ require net11; 18.9.6 is the newest stable net10-compatible tooling. -->
    <PackageVersion Include="Microsoft.Build.Framework" Version="18.9.6" />
    <PackageVersion Include="Microsoft.NET.StringTools" Version="18.9.6" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Common" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Workspaces.Common" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.9.0" />
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <PackageVersion Include="Microsoft.Data.SqlClient.SNI.runtime" Version="7.1.0" />
    <PackageVersion Include="Microsoft.Identity.Client" Version="4.91.1" />
    <PackageVersion Include="Microsoft.Identity.Client.Broker" Version="4.91.1" />
    <PackageVersion Include="Microsoft.Identity.Client.Extensions.Msal" Version="4.91.1" />
    <PackageVersion Include="Microsoft.Identity.Client.NativeInterop" Version="0.20.7" />
    <PackageVersion Include="Microsoft.IdentityModel.Abstractions" Version="8.23.0" />
    <PackageVersion Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.23.0" />
    <PackageVersion Include="Microsoft.IdentityModel.Logging" Version="8.23.0" />
    <PackageVersion Include="Microsoft.IdentityModel.Protocols" Version="8.23.0" />
    <PackageVersion Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.23.0" />
    <PackageVersion Include="Microsoft.IdentityModel.Tokens" Version="8.23.0" />
    <PackageVersion Include="OpenTelemetry" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Api" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Api.ProviderBuilderExtensions" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.SqlClient" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.PersistentStorage.Abstractions" Version="1.1.3" />
    <PackageVersion Include="OpenTelemetry.PersistentStorage.FileSystem" Version="1.1.3" />
    <PackageVersion Include="SQLite" Version="3.54.1" />
    <PackageVersion Include="System.CodeDom" Version="10.0.13" />
    <PackageVersion Include="System.Composition" Version="10.0.13" />
    <PackageVersion Include="System.Composition.AttributedModel" Version="10.0.13" />
    <PackageVersion Include="System.Composition.Convention" Version="10.0.13" />
    <PackageVersion Include="System.Composition.Hosting" Version="10.0.13" />
    <PackageVersion Include="System.Composition.Runtime" Version="10.0.13" />
    <PackageVersion Include="System.Composition.TypedParts" Version="10.0.13" />
    <PackageVersion Include="System.Configuration.ConfigurationManager" Version="10.0.13" />
    <PackageVersion Include="System.IdentityModel.Tokens.Jwt" Version="8.23.0" />
    <PackageVersion Include="System.Memory.Data" Version="10.0.13" />
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="10.0.13" />
    <PackageVersion Include="xunit.analyzers" Version="2.2.0" />
  </ItemGroup>
</Project>
