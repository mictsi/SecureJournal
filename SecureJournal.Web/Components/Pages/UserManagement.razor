@page "/admin/users"
@using System.Security.Cryptography
@attribute [Authorize(Roles = "Administrator")]
@inject ISecureJournalAppService JournalApp
@inject NavigationManager Navigation
@inject ILogger<UserManagement> Logger
@inject IJSRuntime JS

<PageTitle>User Management</PageTitle>

<PageHeader Title="User management"
            Description="Find a person, then manage their access or account settings.">
    <Actions>
        <button type="button" class="sk-button sk-button--primary" @onclick="NavigateToCreateUser">
            <svg class="sk-button__icon" aria-hidden="true" focusable="false" width="16" height="16"><use href="#sk-icon-plus" /></svg>
            Create user
        </button>
    </Actions>
</PageHeader>

<PageAlerts Message="@_message" Error="@_error" />
<NavigationLock ConfirmExternalNavigation="@HasUnsavedChanges" OnBeforeInternalNavigation="ConfirmLeaveAsync" />

@if (_currentUser is null){<p role="status">Loading user management…</p>}
else if (_currentUser.Role != AppRole.Administrator){<p role="alert">Administrator access is required.</p>}
else if (!HasRequestedRecord)
{
<section class="sj-directory management-directory" aria-label="Find users">
    <form class="panel-card management-search" role="search" @onsubmit="SearchDirectory" @onsubmit:preventDefault>
        <div class="sk-field-row sj-directory-toolbar">
            <div class="sk-field management-search-field">
                <label class="sk-field__label" for="userSearch">Search users</label>
                <div class="sk-field__control"><input id="userSearch" class="sk-input" type="search" @bind="_searchDraft" @bind:event="oninput" placeholder="Name or username" /></div>
            </div>
            <div class="sk-field-row__actions"><div class="sk-field-row__action-group">
                <button type="submit" class="sk-button sk-button--primary">Search</button>
                <button type="button" class="sk-button sk-button--secondary" @onclick="ShowAllDirectory">Show all users</button>
            </div></div>
        </div>
    </form>
    @if (!_showResults)
    {
        <div class="management-start">
            <h2>Find a person to get started</h2>
            <p>Search for a specific person, or choose <strong>Show all users</strong> to browse. Open a result to manage its details.</p>
        </div>
    }
    else
    {
        <div class="management-results-toolbar">
            <p role="status" aria-live="polite">@_userPage.TotalCount @(_userPage.TotalCount == 1 ? "user" : "users") found</p>
            <div class="management-sort">
                <label for="userSort">Sort by</label>
                <div class="sk-select-wrapper"><select id="userSort" class="sk-select" @onchange="OnDirectorySortChanged"><option value="displayName" selected="@(_userQuery.SortField == "displayName")">Name</option>
<option value="username" selected="@(_userQuery.SortField == "username")">Username</option></select></div>
                <button type="button" class="sk-button sk-button--secondary" @onclick="ToggleDirectorySortDirection" aria-label="@(_userQuery.SortDirection == SortDirection.Asc ? "Sort descending" : "Sort ascending")">@(_userQuery.SortDirection == SortDirection.Asc ? "A–Z" : "Z–A")</button>
            </div>
        </div>
        @if (!string.IsNullOrWhiteSpace(_userQuery.FilterText))
        {
            <div class="management-active-filter"><span>Search: <strong>@_userQuery.FilterText</strong></span><button type="button" class="sk-button sk-button--ghost" @onclick="ShowAllDirectory" aria-label="Clear search filter">Clear search</button></div>
        }
        @if (_userPage.TotalCount == 0)
        {
            <section class="panel-card management-empty"><h2>No users found</h2><p>@(string.IsNullOrWhiteSpace(_userQuery.FilterText) ? "Create a user to start building your directory." : $"Nothing matched ‘{_userQuery.FilterText}’. Try another search or clear the filter.")</p></section>
        }
        else
        {
            <div class="sj-directory-results" aria-label="Users results">
                @foreach (var user in _userPage.Items)
                {
                    <a class="sj-result-card user-directory-item" href="@DirectoryUrl(user.UserId)">
                        <span class="management-result-identity"><span class="user-avatar" aria-hidden="true">@UserInitial(user)</span><span class="management-result-copy"><strong>@user.DisplayName</strong><span>@user.Username</span></span></span>
<span class="management-result-meta">@foreach (var role in UserRoles(user)){<span class="sk-badge sk-badge--neutral">@RoleLabel(role)</span>}<span class="sk-badge @(user.IsDisabled ? "sk-badge--danger" : "sk-badge--success")">@(user.IsDisabled ? "Disabled" : "Active")</span></span>
                        <span class="management-open">Open person<span aria-hidden="true"> →</span></span>
                    </a>
                }
            </div>
            <nav class="management-pagination" aria-label="Users pages">
                <p>Page @_userPage.Page of @_userPage.TotalPages · @VisibleUserRangeLabel()</p>
                <div class="management-pagination-actions">
                    <div class="management-page-size"><label for="userPageSize">Per page</label><div class="sk-select-wrapper"><select id="userPageSize" class="sk-select" @onchange="OnDirectoryPageSizeChanged">@foreach (var size in _pageSizeOptions){<option value="@size" selected="@(size == _userQuery.PageSize)">@size</option>}</select></div></div>
                    <button type="button" class="sk-button sk-button--secondary" @onclick="PreviousDirectoryPage" disabled="@(_userPage.Page <= 1)">Previous</button>
                    <button type="button" class="sk-button sk-button--secondary" @onclick="NextDirectoryPage" disabled="@(_userPage.Page >= _userPage.TotalPages)">Next</button>
                </div>
            </nav>
        }
    }
</section>
}
else
{
 <div class="sj-workspace user-workspace">
  <nav class="sj-workspace-nav" aria-label="User navigation"><a class="sk-link sj-workspace-back" href="@DirectoryUrl()">← Back to user results</a></nav>
  @if (SelectedUser is null){<section class="panel-card management-empty"><h2>User unavailable</h2><p>This account may have been removed. Return to your results to choose another person.</p></section>}
  else
  {
<div class="panel-card management-identity">
                                    <div class="user-account-summary">
                                        <div class="user-panel-summary-identity">
                                            <span class="user-avatar user-avatar-large" aria-hidden="true">@UserInitial(SelectedUser)</span>
                                            <div class="user-panel-summary-copy">
                                                <h2>@SelectedUser.DisplayName</h2>
                                                <span>@SelectedUser.Username</span>
                                            </div>
                                        </div>

                                        <dl class="sk-dl user-panel-stat-grid">
                                            <div class="sk-dl__group">
                                                <dt class="sk-dl__term">Status</dt>
                                                <dd class="sk-dl__detail">
                                                    <span class="sk-status @(SelectedUser.IsDisabled ? "sk-status--danger" : "sk-status--success")">
                                                        <span class="sk-status__dot" aria-hidden="true"></span>
                                                        <span class="sk-status__label">@(SelectedUser.IsDisabled ? "Disabled" : "Active")</span>
                                                    </span>
                                                </dd>
                                            </div>
                                            <div class="sk-dl__group">
                                                <dt class="sk-dl__term">Access</dt>
                                                <dd class="sk-dl__detail">@(SelectedUser.IsLocalAccount ? "Local" : "External")</dd>
                                            </div>
                                            <div class="sk-dl__group">
                                                <dt class="sk-dl__term">Roles</dt>
                                                <dd class="sk-dl__detail">@UserRoles(SelectedUser).Count</dd>
                                            </div>
                                            <div class="sk-dl__group">
                                                <dt class="sk-dl__term">Groups</dt>
                                                <dd class="sk-dl__detail">@SelectedUser.Groups.Count</dd>
                                            </div>
                                        </dl>
                                    </div>
                                </div>
   <nav class="management-sections" aria-label="User settings">
    <button type="button" class="sk-button @(_activeSection == "access" ? "sk-button--primary" : "sk-button--secondary")" @onclick='() => _activeSection = "access"' aria-pressed="@(_activeSection == "access")">Roles &amp; groups @if (_rolesDirty || _groupsDirty){<span aria-label="Unsaved changes">•</span>}</button>
    <button type="button" class="sk-button @(_activeSection == "security" ? "sk-button--primary" : "sk-button--secondary")" @onclick='() => _activeSection = "security"' aria-pressed="@(_activeSection == "security")">Password &amp; account @if (!string.IsNullOrEmpty(_resetPasswordRequest.NewPassword)){<span aria-label="Unsaved password">•</span>}</button>
   </nav>
   @if (_activeSection == "access")
   {
<section class="panel-card user-roles-card">
                                <div class="panel-card-header user-section-header">
                                    <div>
                                        <p class="user-section-kicker">Roles &amp; Permissions</p>
                                        <h2>Roles</h2>
                                        <p class="user-section-copy">Manage user roles and access levels.</p>
                                    </div>
                                </div>

                                <div class="user-role-stack">
                                    @foreach (var role in _roles)
                                    {
                                        <label class="user-role-option @RoleOptionClass(_editedRoles.Contains(role))">
                                            <input class="sk-checkbox__input"
                                                   type="checkbox"
                                                   checked="@_editedRoles.Contains(role)"
                                                   @onchange="args => ToggleRoleLocal(role, args)" />
                                            <span class="sk-checkbox__box" aria-hidden="true"></span>
                                            <span class="user-role-option-body">
                                                <span class="user-role-option-title">@RoleLabel(role)</span>
                                                <span class="user-role-option-description">@RoleDescription(role)</span>
                                            </span>
                                        </label>
                                    }
                                </div>

                                <div class="user-section-actions">
                                    <button type="button" class="sk-button sk-button--primary" @onclick="SaveRolesAsync" disabled="@(!_rolesDirty || _isSaving)">Save Roles</button>
                                    <button type="button" class="sk-button sk-button--secondary" @onclick="ResetRoleEdits" disabled="@(!_rolesDirty || _isSaving)">Reset Roles</button>
                                </div>
                            </section>
<section class="panel-card management-membership">
 <div class="management-panel-heading"><div><h2>Group access</h2><p>@SelectedUser.Groups.Count @(SelectedUser.Groups.Count == 1 ? "group" : "groups") currently assigned</p></div><button type="button" class="sk-button sk-button--secondary" @onclick="ToggleGroupBrowser" aria-expanded="@_showGroupBrowser" aria-controls="manageUserGroupBrowser">@(_showGroupBrowser ? "Close access editor" : "Edit group access")</button></div>
 <div class="management-pills">@if (SelectedUser.Groups.Count == 0){<span class="sj-muted">None assigned yet.</span>}else{@foreach(var name in SelectedUser.Groups){<span class="sk-badge sk-badge--neutral">@name</span>}}</div>
 @if (_showGroupBrowser)
 {
  <div id="manageUserGroupBrowser" class="management-membership-browser">
   <form class="sk-field-row management-filter-row" role="search" @onsubmit="ApplyMembershipFilterAsync" @onsubmit:preventDefault><div class="sk-field"><label class="sk-field__label" for="manageUserGroupSearch">Filter groups</label><div class="sk-field__control"><input id="manageUserGroupSearch" class="sk-input" @bind="_membershipSearchDraft" @bind:event="oninput" placeholder="Filter by name" /></div></div><div class="sk-field"><label class="sk-field__label" for="manageUserGroupAssigned">Membership</label><div class="sk-field__control sk-select-wrapper"><select id="manageUserGroupAssigned" class="sk-select" @onchange="OnGroupAssignedFilterChanged"><option value="all" selected="@(!_groupQuery.Assigned.HasValue)">Everyone</option><option value="assigned" selected="@(_groupQuery.Assigned == true)">Assigned</option><option value="unassigned" selected="@(_groupQuery.Assigned == false)">Not assigned</option></select></div></div><div class="sk-field"><label class="sk-field__label" for="manageUserGroupPageSize">Per page</label><div class="sk-field__control sk-select-wrapper"><select id="manageUserGroupPageSize" class="sk-select" @onchange="OnGroupPageSizeChanged">@foreach(var option in _pageSizeOptions){<option value="@option" selected="@(option == _groupQuery.PageSize)">@option</option>}</select></div></div><div class="sk-field-row__actions"><div class="sk-field-row__action-group"><button type="submit" class="sk-button sk-button--secondary">Apply filter</button><button type="button" class="sk-button sk-button--ghost" @onclick="ClearMembershipFilterAsync">Clear filter</button></div></div></form>
   <p role="status" aria-live="polite">@_groupPage.TotalCount available @(_groupPage.TotalCount == 1 ? "choice" : "choices"). Select changes, then save.</p>
   @if (_groupPage.TotalCount == 0){<p>No matches. Try another name or remove the filter.</p>}
   <div class="management-membership-list">@foreach(var group in _groupPage.Items){<label class="management-membership-choice"><input type="checkbox" aria-label="@($"Assign {group.Name} to {SelectedUser.DisplayName}")" checked="@IsGroupAssigned(group)" @onchange="args => ToggleGroupLocal(group, args)" disabled="@_isSaving" /><span><strong>@group.Name</strong><span>@PlainDescription(group.Description)</span></span><span class="management-choice-state">@(IsGroupAssigned(group) ? "Assigned" : "Not assigned")</span></label>}</div>
   <nav class="management-pagination" aria-label="Group access pages"><span>Page @_groupPage.Page of @_groupPage.TotalPages</span><div class="management-pagination-actions"><button type="button" class="sk-button sk-button--secondary" @onclick="GoToPreviousGroupPageAsync" disabled="@(_groupPage.Page <= 1)">Previous</button><button type="button" class="sk-button sk-button--secondary" @onclick="GoToNextGroupPageAsync" disabled="@(_groupPage.Page >= _groupPage.TotalPages)">Next</button></div></nav>
  </div>
 }
 @if (_showGroupBrowser || _groupsDirty){<div class="management-savebar"><span role="status">@(_groupsDirty ? "Unsaved access changes" : "No pending changes")</span><div class="sk-cluster"><button type="button" class="sk-button sk-button--secondary" @onclick="ResetGroupEdits" disabled="@(!_groupsDirty || _isSaving)">Discard changes</button><button type="button" class="sk-button sk-button--primary" @onclick="SaveGroupsAsync" disabled="@(!_groupsDirty || _isSaving)">@(_isSaving ? "Saving…" : "Save group access")</button></div></div>}
</section>
   }
   else
   {
<div class="panel-card user-security-card">
                                    <div class="panel-card-header user-section-header">
                                        <div>
                                            <p class="user-section-kicker">Security</p>
                                            <h2>Reset password</h2>
                                            <p class="user-section-copy">Update password and security settings.</p>
                                        </div>
                                    </div>

                                    @if (!SelectedUser.IsLocalAccount)
                                    {
                                        <p>Password reset is available for local accounts only.</p>
                                    }
                                    else
                                    {
                                        <EditForm Model="_resetPasswordRequest" OnValidSubmit="ResetSelectedUserPasswordAsync">
                                            <DataAnnotationsValidator />
                                            <ValidationSummary />

                                            <div class="sk-stack sk-stack--gap-16">
                                                <div class="sk-field">
                                                    <label class="sk-field__label" for="manageResetPassword">New Password</label>
                                                    <InputText id="manageResetPassword"
                                                               type="password"
                                                               class="sk-input"
                                                               @bind-Value="_resetPasswordRequest.NewPassword" @oninput="args => _resetPasswordRequest.NewPassword = args.Value?.ToString() ?? string.Empty" />
                                                </div>
                                                <div class="sk-field">
                                                    <label class="sk-field__label" for="manageResetPasswordConfirm">Confirm New Password</label>
                                                    <InputText id="manageResetPasswordConfirm"
                                                               type="password"
                                                               class="sk-input"
                                                               @bind-Value="_confirmResetPassword" @oninput="args => _confirmResetPassword = args.Value?.ToString() ?? string.Empty" />
                                                </div>
                                            </div>

                                            <div class="sk-field__hint">Minimum length @_localPasswordMinLength. Local accounts only.</div>

                                            <div class="user-section-actions">
                                                <button type="button" class="sk-button sk-button--secondary" @onclick="GenerateSuggestedPassword" disabled="@_isSaving">Generate Password</button>
                                                <button type="submit" class="sk-button sk-button--primary" disabled="@_isSaving">Update Password</button>
                                                <button type="button" class="sk-button sk-button--secondary" @onclick="ResetLocalPasswordForm" disabled="@_isSaving">Clear</button>
                                            </div>
                                        </EditForm>
                                    }
                                </div>
<div class="panel-card management-danger">
                                    <div class="panel-card-header user-section-header">
                                        <div>
                                            <p class="user-section-kicker user-danger-kicker">Danger Zone</p>
                                            <h2>Account access</h2>
                                            <p class="user-section-copy">Enable or disable access, or delete the account.</p>
                                        </div>
                                    </div>

                                    <div class="user-danger-actions">
                                        <div class="user-danger-copy">
                                            <strong>@(SelectedUser.IsDisabled ? "Enable or keep disabled" : "Delete or disable")</strong>
                                            <span>
                                                @(IsSelectedCurrentUser
                                                    ? "You cannot disable or delete the currently signed-in administrator."
                                                    : "Once deleted, this user account cannot be recovered.")
                                            </span>
                                        </div>
                                        <div class="sk-cluster">
                                            <button type="button"
                                                    class="sk-button @(SelectedUser.IsDisabled ? "sk-button--success" : "sk-button--secondary")"
                                                    @onclick="ToggleSelectedUserEnabledAsync"
                                                    disabled="@(_isSaving || IsSelectedCurrentUser)">
                                                @(SelectedUser.IsDisabled ? "Enable User" : "Disable User")
                                            </button>
                                            <button type="button" class="sk-button sk-button--danger" @onclick="DeleteSelectedUserAsync" disabled="@(_isSaving || IsSelectedCurrentUser)">Delete User</button>
                                        </div>
                                    </div>
                                </div>
   }
  }
 </div>
}

@code {
    [SupplyParameterFromQuery(Name = "userId")] public string? RequestedId { get; set; }
    [SupplyParameterFromQuery(Name = "q")] public string? SearchQuery { get; set; }
    [SupplyParameterFromQuery(Name = "all")] public string? BrowseAllQuery { get; set; }
    [SupplyParameterFromQuery(Name = "page")] public string? RequestedPageQuery { get; set; }
    [SupplyParameterFromQuery(Name = "size")] public string? RequestedPageSizeQuery { get; set; }
    [SupplyParameterFromQuery(Name = "sort")] public string? RequestedSort { get; set; }
    [SupplyParameterFromQuery(Name = "desc")] public string? SortDescendingQuery { get; set; }
    private bool BrowseAll => bool.TryParse(BrowseAllQuery, out var value) && value;
    private bool SortDescending => bool.TryParse(SortDescendingQuery, out var value) && value;
    private int? RequestedPage => int.TryParse(RequestedPageQuery, out var value) ? value : null;
    private int? RequestedPageSize => int.TryParse(RequestedPageSizeQuery, out var value) ? value : null;
    private string _searchDraft = string.Empty;
    private string _membershipSearchDraft = string.Empty;
    private bool _showResults;
    private bool _allowNavigation;
    private string? _appliedRoute;
    private string _activeSection = "access";
    private bool HasRequestedRecord => !string.IsNullOrWhiteSpace(RequestedId);

    private const string GeneratedPasswordAlphabet = "ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz23456789!@$?_-";

    private readonly AppRole[] _roles = [AppRole.Administrator, AppRole.ProjectUser, AppRole.Auditor];
    private readonly int[] _pageSizeOptions = [10, 20, 50];

    private UserContext? _currentUser;
    private PagedResult<UserOverview> _userPage = new(Array.Empty<UserOverview>(), 0, 1, 10, 1);
    private PagedResult<GroupAccessRow> _groupPage = new(Array.Empty<GroupAccessRow>(), 0, 1, 10, 1);
    private UserListQuery _userQuery = new() { PageSize = 10, SortField = "username" };
    private UserGroupMembershipQuery _groupQuery = new() { PageSize = 10, SortField = "name" };
    private Guid? _selectedUserId;
    private UserOverview? _selectedUser;

    private HashSet<AppRole> _originalRoles = [];
    private HashSet<AppRole> _editedRoles = [];
    private readonly Dictionary<Guid, bool> _pendingGroupAssignments = [];
    private bool _showGroupBrowser;

    private AdminResetPasswordRequest _resetPasswordRequest = new();
    private string _confirmResetPassword = string.Empty;
    private int _localPasswordMinLength = 8;
    private bool _isSaving;
    private string? _message;
    private string? _error;

    private bool _rolesDirty => !_editedRoles.SetEquals(_originalRoles);
    private bool _groupsDirty => _pendingGroupAssignments.Count > 0;
    private bool HasUnsavedChanges => _rolesDirty || _groupsDirty ||
        !string.IsNullOrEmpty(_resetPasswordRequest.NewPassword) || !string.IsNullOrEmpty(_confirmResetPassword);

    private UserOverview? SelectedUser => _selectedUser;

    private bool IsSelectedCurrentUser
        => SelectedUser?.UserId == _currentUser?.UserId;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (!await JournalApp.HasCurrentUserAsync())
            {
                Navigation.NavigateTo("/", forceLoad: false);
                return;
            }

            _currentUser = await JournalApp.GetCurrentUserAsync();
            _localPasswordMinLength = JournalApp.GetLocalPasswordMinLength();

        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "User management page initialization failed");
            _error = $"Failed to load user management: {ex.Message}";
        }
    }

    private Task LoadUsersAsync()
    {
        _userPage = _showResults ? JournalApp.GetUsers(_userQuery) : new PagedResult<UserOverview>(Array.Empty<UserOverview>(), 0, 1, _userQuery.PageSize, 1);
        _userQuery.Page = _userPage.Page;
        if (_selectedUserId is { } id) _selectedUser = _userPage.Items.FirstOrDefault(user => user.UserId == id) ?? _selectedUser;
        return LoadGroupsAsync();
    }

    private Task LoadGroupsAsync()
    {
        if (!_selectedUserId.HasValue)
        {
            _groupPage = new PagedResult<GroupAccessRow>(Array.Empty<GroupAccessRow>(), 0, 1, _groupQuery.PageSize, 1);
            return Task.CompletedTask;
        }

        _groupQuery.UserId = _selectedUserId.Value;
        _groupPage = JournalApp.GetUserGroups(_groupQuery);
        return Task.CompletedTask;
    }

    private async Task<bool> ConfirmDiscardAsync()
        => !HasUnsavedChanges || await JS.InvokeAsync<bool>("confirm",
            $"Discard unsaved changes for '{SelectedUser?.Username}'? Role, group, and password changes have not been saved.");

    private async Task ConfirmLeaveAsync(LocationChangingContext context)
    {
        if (_allowNavigation) return;
        if (_isSaving || !await ConfirmDiscardAsync())
        {
            context.PreventNavigation();
        }
    }

    private void RefreshSelectedUser()
    {
        _selectedUser = JournalApp.GetUsers().FirstOrDefault(user => user.UserId == _selectedUserId);
        _selectedUserId = _selectedUser?.UserId;
    }

    private void InitializeSelectedUserEdits()
    {
        var selected = SelectedUser;
        if (selected is null)
        {
            _originalRoles.Clear();
            _editedRoles.Clear();
            _pendingGroupAssignments.Clear();
            _showGroupBrowser = false;
            _resetPasswordRequest.UserId = Guid.Empty;
            ResetLocalPasswordForm();
            return;
        }

        _originalRoles = selected.Roles.Count > 0 ? selected.Roles.ToHashSet() : [selected.Role];
        _editedRoles = _originalRoles.ToHashSet();
        _pendingGroupAssignments.Clear();
        _groupQuery = new UserGroupMembershipQuery
        {
            PageSize = _groupQuery.PageSize,
            SortField = "name"
        };
        _showGroupBrowser = false;
        _resetPasswordRequest.UserId = selected.UserId;
        _resetPasswordRequest.NewPassword = string.Empty;
        _confirmResetPassword = string.Empty;
    }

    private async Task SaveRolesAsync()
    {
        var selectedUser = SelectedUser;
        if (selectedUser is null)
        {
            _error = "Select a user first.";
            return;
        }

        if (!_rolesDirty)
        {
            _message = "No role changes to save.";
            _error = null;
            return;
        }

        try
        {
            _isSaving = true;
            _message = null;
            _error = null;

            foreach (var role in _editedRoles.Except(_originalRoles).ToList())
            {
                JournalApp.AddUserToRole(new UserRoleMembershipRequest { UserId = selectedUser.UserId, Role = role });
            }

            foreach (var role in _originalRoles.Except(_editedRoles).ToList())
            {
                JournalApp.RemoveUserFromRole(new UserRoleMembershipRequest { UserId = selectedUser.UserId, Role = role });
            }

            RefreshSelectedUser();
            await LoadUsersAsync();
            // Saving roles must leave the independent group/password drafts intact.
            _originalRoles = SelectedUser is { } updated
                ? (updated.Roles.Count > 0 ? updated.Roles.ToHashSet() : [updated.Role])
                : [];
            _editedRoles = _originalRoles.ToHashSet();
            _message = $"Roles updated for user '{selectedUser.Username}'.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Saving user roles failed");
            _error = ex.Message;
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task SaveGroupsAsync()
    {
        var selectedUser = SelectedUser;
        if (selectedUser is null)
        {
            _error = "Select a user first.";
            return;
        }

        if (!_groupsDirty)
        {
            _message = "No group membership changes to save.";
            _error = null;
            return;
        }

        try
        {
            _isSaving = true;
            _message = null;
            _error = null;

            foreach (var (groupId, shouldBeAssigned) in _pendingGroupAssignments)
            {
                if (shouldBeAssigned)
                {
                    JournalApp.AssignUserToGroup(new AssignUserToGroupRequest { UserId = selectedUser.UserId, GroupId = groupId });
                }
                else
                {
                    JournalApp.RemoveUserFromGroup(new AssignUserToGroupRequest { UserId = selectedUser.UserId, GroupId = groupId });
                }
            }

            _pendingGroupAssignments.Clear();
            RefreshSelectedUser();
            await LoadUsersAsync();
            await LoadGroupsAsync();
            _message = $"Group memberships updated for user '{selectedUser.Username}'.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Saving user groups failed");
            _error = ex.Message;
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void ToggleRoleLocal(AppRole role, ChangeEventArgs args)
    {
        var isChecked = ParseCheckboxValue(args);
        if (isChecked)
        {
            _editedRoles.Add(role);
            return;
        }

        _editedRoles.Remove(role);
    }

    private void ToggleGroupLocal(GroupAccessRow group, ChangeEventArgs args)
    {
        var isChecked = ParseCheckboxValue(args);
        if (isChecked == group.IsAssigned)
        {
            _pendingGroupAssignments.Remove(group.GroupId);
            return;
        }

        _pendingGroupAssignments[group.GroupId] = isChecked;
    }

    private bool IsGroupAssigned(GroupAccessRow row)
        => _pendingGroupAssignments.TryGetValue(row.GroupId, out var value) ? value : row.IsAssigned;

    private void ResetRoleEdits()
    {
        _editedRoles = _originalRoles.ToHashSet();
    }

    private Task ResetGroupEdits()
    {
        _pendingGroupAssignments.Clear();
        return LoadGroupsAsync();
    }

    private void ToggleGroupBrowser()
    {
        _showGroupBrowser = !_showGroupBrowser;
    }

    private void NavigateToCreateUser()
        => Navigation.NavigateTo("/admin/users/create");

    private async Task ToggleSelectedUserEnabledAsync()
    {
        var selectedUser = SelectedUser;
        if (selectedUser is null)
        {
            _error = "Select a user first.";
            return;
        }

        var shouldEnable = selectedUser.IsDisabled;
        var actionVerb = shouldEnable ? "enable" : "disable";
        var confirmed = await JS.InvokeAsync<bool>(
            "confirm",
            shouldEnable
                ? $"Enable user '{selectedUser.Username}'?"
                : $"Disable user '{selectedUser.Username}'? This blocks all app access.");
        if (!confirmed)
        {
            return;
        }

        try
        {
            _isSaving = true;
            _message = null;
            _error = null;

            var changed = shouldEnable
                ? await JournalApp.EnableUserAsync(selectedUser.UserId)
                : await JournalApp.DisableUserAsync(selectedUser.UserId);
            RefreshSelectedUser();
            await LoadUsersAsync();
            _message = changed
                ? $"User '{selectedUser.Username}' was {actionVerb}d."
                : $"User '{selectedUser.Username}' is already {actionVerb}d.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Toggle user enabled state failed");
            _error = ex.Message;
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task DeleteSelectedUserAsync()
    {
        var selectedUser = SelectedUser;
        if (selectedUser is null)
        {
            _error = "Select a user first.";
            return;
        }

        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Delete user '{selectedUser.Username}'? This cannot be undone.");
        if (!confirmed)
        {
            return;
        }

        try
        {
            _isSaving = true;
            _message = null;
            _error = null;

            await JournalApp.DeleteUserAsync(selectedUser.UserId);
            _selectedUser = null;
            _selectedUserId = null;
            InitializeSelectedUserEdits();
            await LoadUsersAsync();
            _allowNavigation = true;
            Navigation.NavigateTo(DirectoryUrl(), replace: true);
            _message = $"User '{selectedUser.Username}' was deleted.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Delete user failed");
            _error = ex.Message;
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task ResetSelectedUserPasswordAsync()
    {
        var selectedUser = SelectedUser;
        if (selectedUser is null)
        {
            _error = "Select a user first.";
            return;
        }

        if (!selectedUser.IsLocalAccount)
        {
            _error = "Password reset is supported for local users only.";
            return;
        }

        if (_resetPasswordRequest.NewPassword != _confirmResetPassword)
        {
            _error = "New password and confirm password must match.";
            return;
        }

        try
        {
            _isSaving = true;
            _message = null;
            _error = null;

            _resetPasswordRequest.UserId = selectedUser.UserId;
            var result = await JournalApp.ResetLocalUserPasswordAsync(_resetPasswordRequest);
            if (!result.Success)
            {
                _error = result.Message;
                return;
            }

            _message = result.Message;
            ResetLocalPasswordForm();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Reset selected user password failed");
            _error = ex.Message;
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void GenerateSuggestedPassword()
    {
        var chars = new char[Math.Max(_localPasswordMinLength, 14)];
        for (var index = 0; index < chars.Length; index++)
        {
            chars[index] = GeneratedPasswordAlphabet[RandomNumberGenerator.GetInt32(GeneratedPasswordAlphabet.Length)];
        }

        var password = new string(chars);
        _resetPasswordRequest.NewPassword = password;
        _confirmResetPassword = password;
    }

