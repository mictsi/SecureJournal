@page "/admin/groups/create"
@attribute [Authorize(Roles = "Administrator")]
@inject NavigationManager Navigation

<PageTitle>Group Management</PageTitle>

<PageHeader Title="Group management" Description="Redirecting to the consolidated group management page." />

<section class="panel-card redirect-card">
    <p>Taking you there now...</p>
</section>

@code {
    protected override void OnInitialized()
    {
        Navigation.NavigateTo("/admin/groups", forceLoad: false);
    }
}
