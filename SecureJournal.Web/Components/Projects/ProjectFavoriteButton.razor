<button type="button" class="sk-button sk-button--secondary sk-button--sm project-favorite-toggle @(IsFavorite ? "is-favorite" : null)"
        aria-pressed="@(IsFavorite ? "true" : "false")" aria-label="@ActionLabel" title="@ActionLabel"
        disabled="@Disabled" @onclick="OnToggle">
    <svg aria-hidden="true" focusable="false" width="18" height="18" viewBox="0 0 24 24">
        <path d="m12 3 2.78 5.63 6.22.91-4.5 4.38 1.06 6.2L12 17.19l-5.56 2.93 1.06-6.2L3 9.54l6.22-.91Z" />
    </svg>
    <span>@(IsFavorite ? "Favorited" : "Favorite")</span>
</button>

@code {
    [Parameter, EditorRequired] public string ProjectName { get; set; } = string.Empty;
    [Parameter] public bool IsFavorite { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback OnToggle { get; set; }
    private string ActionLabel => IsFavorite ? $"Remove {ProjectName} from favorites" : $"Add {ProjectName} to favorites";
}
