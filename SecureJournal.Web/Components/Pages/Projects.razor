@page "/projects"
@attribute [Authorize]
@inject ISecureJournalAppService JournalApp
@inject NavigationManager Navigation
@inject IJSRuntime JS
@using SecureJournal.Web.Components.Journal
@using SecureJournal.Web.Components.Projects

<PageTitle>@(SelectedProject?.Name ?? "My projects")</PageTitle>
<span class="sk-visually-hidden" role="status" aria-live="polite">@_favoriteStatus</span>

@if (SelectedProject is { } project)
{
    <div class="sj-workspace" role="region" @ref="_workspaceFocus" tabindex="-1" aria-label="@($"{project.Name} journal")">
        <nav class="sj-workspace-nav" aria-label="Project navigation">
            <a class="sk-link" href="@ProjectsUrl(null)"><span aria-hidden="true">←</span>Back to projects</a>
            <span>@project.Code</span>
        </nav>

        <PageHeader Title="@project.Name" Description="@(string.IsNullOrWhiteSpace(project.Description) ? "A shared record of decisions, updates, and events." : project.Description)">
            <Actions>
                <ProjectFavoriteButton ProjectName="@project.Name" IsFavorite="@_favoriteProjectIds.Contains(project.ProjectId)"
                                       Disabled="@_favoritesLoadFailed" OnToggle="() => ToggleFavorite(project)" />
                <a href="@NewEntryUrl" class="sk-button sk-button--primary"><svg class="sk-button__icon" aria-hidden="true" focusable="false" width="16" height="16"><use href="#sk-icon-plus" /></svg>New entry</a>
            </Actions>
        </PageHeader>

        <PageAlerts Message="@_message" Error="@(_projectSelectionError ?? _error ?? _favoritesError)" />

        <section class="panel-card project-journal-controls" aria-label="Find journal entries">
            <form class="sk-field-row sj-directory-toolbar" role="search" aria-label="Search journal entries" @onsubmit="SearchEntries" @onsubmit:preventDefault>
                <div class="sk-field">
                    <label class="sk-field__label" for="projectJournalSearch">Search entries</label>
                    <div class="sk-field__control">
                        <input id="projectJournalSearch" class="sk-input" type="search" @bind="_entrySearchInput" @bind:event="oninput" placeholder="Subject, description, or notes" />
                    </div>
                </div>
                <div class="sk-field-row__actions">
                    <div class="sk-field-row__action-group">
                        <button type="submit" class="sk-button sk-button--primary">Search</button>
                        <button type="button" class="sk-button sk-button--secondary" @onclick="RefreshSelectedProjectEntries">Refresh</button>
                    </div>
                </div>
            </form>
            <div class="project-journal-options">
                <div class="project-sort-control">
                    <label class="sk-field__label" for="projectJournalSort">Order</label>
                    <div class="sk-select-wrapper">
                        <select id="projectJournalSort" class="sk-select sk-select--sm" value="@_dateSortOrder" @onchange="OnSortOrderChanged">
                            <option value="newest">Newest first</option>
                            <option value="oldest">Oldest first</option>
                        </select>
                    </div>
                </div>
                @if (_currentUser?.Role == AppRole.Administrator)
                {
                    <label class="sk-checkbox">
                        <input id="projectIncludeDeleted" class="sk-checkbox__input" type="checkbox" checked="@_includeSoftDeleted" @onchange="OnIncludeSoftDeletedChanged" />
                        <span class="sk-checkbox__box" aria-hidden="true"></span>
                        <span class="sk-checkbox__content"><span class="sk-checkbox__label">Include deleted entries</span></span>
                    </label>
                }
            </div>
        </section>

        @if (!string.IsNullOrWhiteSpace(_searchText))
        {
            <div class="sj-filter-chips" aria-label="Active entry filters">
                <button class="sk-button sk-button--secondary sk-button--sm" type="button" @onclick="ClearEntrySearch" aria-label="@($"Remove entry search: {_searchText}")">Search: @_searchText <span aria-hidden="true">×</span></button>
            </div>
        }

        <section aria-labelledby="project-entries-heading" class="project-entry-results">
            <div class="sj-results-summary">
                <h2 id="project-entries-heading" class="sj-subheading">Journal entries</h2>
                <div class="project-entry-view" role="group" aria-label="Entry reading view">
                    <button type="button" class="sk-button sk-button--sm @(!_quickRead ? "sk-button--primary" : "sk-button--secondary")" aria-pressed="@(!_quickRead ? "true" : "false")" @onclick="() => SetReadingView(false)">Compact list</button>
                    <button type="button" class="sk-button sk-button--sm @(_quickRead ? "sk-button--primary" : "sk-button--secondary")" aria-pressed="@(_quickRead ? "true" : "false")" @onclick="() => SetReadingView(true)">Quick read</button>
                </div>
                <p class="sj-muted" role="status">@EntryRangeLabel</p>
            </div>
            @if (_entriesLoadFailed)
            {
                <div class="panel-card sk-empty-state">
                    <h3 class="sk-empty-state__heading">Entries could not be loaded</h3>
                    <p class="sk-empty-state__body">Try loading this project again.</p>
                    <button type="button" class="sk-button sk-button--secondary" @onclick="RefreshSelectedProjectEntries">Try again</button>
                </div>
            }
            else if (_entries.Count == 0)
            {
                <div class="panel-card sk-empty-state">
                    <h3 class="sk-empty-state__heading">Add the first entry</h3>
                    <p class="sk-empty-state__body">Record a decision, milestone, or update for this project.</p>
                    <a href="@NewEntryUrl" class="sk-button sk-button--primary">New entry</a>
                </div>
            }
            else if (FilteredEntryCount == 0)
            {
                <div class="panel-card sk-empty-state">
                    <h3 class="sk-empty-state__heading">No entries match “@_searchText”</h3>
                    <p class="sk-empty-state__body">Try a shorter phrase, or clear the search to see all entries.</p>
                    <button type="button" class="sk-button sk-button--secondary" @onclick="ClearEntrySearch">Clear search</button>
                </div>
            }
            else
            {
                @if (_quickRead)
                {
                    <div class="quick-reader @(SelectedReaderEntry is not null ? "has-selection" : null)">
                        <section class="quick-reader-list" aria-labelledby="quick-reader-list-heading" tabindex="-1" @ref="_readerListFocus">
                            <div class="quick-reader-list-heading">
                                <h3 id="quick-reader-list-heading">Entries</h3>
                                <span class="sj-muted">Page @_currentPage of @TotalPages</span>
                            </div>
                            <ul class="quick-reader-list-items" aria-label="Choose an entry to read">
                                @foreach (var entry in VisibleEntries)
                                {
                                    <li @key="entry.RecordId">
                                        <button type="button" class="quick-reader-item @(entry.RecordId == _selectedReaderEntryId ? "is-selected" : null)"
                                                aria-current="@(entry.RecordId == _selectedReaderEntryId ? "true" : null)"
                                                aria-controls="quick-reader-detail" @ref="_readerEntryButtons[entry.RecordId]"
                                                @onclick="() => SelectReaderEntry(entry.RecordId)">
                                            <span class="quick-reader-item-meta"><time datetime="@entry.CreatedAtUtc.ToString("o")">@entry.CreatedAtUtc.ToString("dd MMM yyyy HH:mm") UTC</time><span>by @entry.CreatedBy</span></span>
                                            <strong>@entry.Subject</strong>
                                            @if (entry.IsSoftDeleted) { <span class="sk-badge sk-badge--warning">Deleted</span> }
                                        </button>
                                    </li>
                                }
                            </ul>
                            @if (HasEntryPager) { @EntryPager() }
                        </section>
                        <section @key="SelectedReaderEntry?.RecordId" id="quick-reader-detail" class="quick-reader-detail" aria-label="Selected journal entry" tabindex="-1" @ref="_readerDetailFocus">
                            @if (SelectedReaderEntry is { } readingEntry)
                            {
                                <article @key="readingEntry.RecordId" aria-labelledby="quick-reader-title">
                                    <header class="quick-reader-detail-heading">
                                        <button type="button" class="sk-button sk-button--ghost sk-button--sm quick-reader-back" @onclick="ClearReaderSelection"><span aria-hidden="true">←</span> Back to entries</button>
                                        <div class="quick-reader-entry-meta"><time datetime="@readingEntry.CreatedAtUtc.ToString("o")">@readingEntry.CreatedAtUtc.ToString("dd MMM yyyy HH:mm") UTC</time><span>by @readingEntry.CreatedBy</span>@if (readingEntry.IsSoftDeleted) { <span class="sk-badge sk-badge--warning">Deleted</span> }</div>
                                        <h3 id="quick-reader-title">@readingEntry.Subject</h3>
                                    </header>
                                    <div class="quick-reader-content">
                                        <JournalEntryContent Entry="readingEntry" ReturnUrl="@ProjectsUrl(_selectedProjectId, includeEntryState: true)" HeadingLevel="4" ShowCreatedMetadata="false" QuickRead="true" />
                                    </div>
                                </article>
                            }
                            else
                            {
                                <div class="quick-reader-empty" role="status">
                                    <h3>Select an entry</h3>
                                    <p>@(string.IsNullOrWhiteSpace(ReaderEntryQuery) ? "Choose an entry from the list to read its full description, notes, and files here." : "That entry is not available on this page. Choose an entry from the list.")</p>
                                </div>
                            }
                        </section>
                    </div>
                }
                else
                {
                    <ul class="sj-directory-results project-entry-list" aria-label="Journal entries">
                        @foreach (var entry in VisibleEntries)
                        {
                            <li @key="entry.RecordId">
                                <details class="project-entry-card project-entry-disclosure">
                                    <summary class="project-entry-summary">
                                        <time class="project-entry-date" datetime="@entry.CreatedAtUtc.ToString("o")">@entry.CreatedAtUtc.ToString("dd MMM yyyy HH:mm") UTC</time>
                                        <span class="project-entry-author">by @entry.CreatedBy</span>
                                        <span class="project-entry-subject">
                                            <strong class="project-entry-title">@entry.Subject</strong>
                                            @if (entry.IsSoftDeleted) { <span class="sk-badge sk-badge--warning">Deleted</span> }
                                        </span>
                                        <span class="project-entry-toggle"><span class="entry-show-label">Show entry</span><span class="entry-hide-label">Hide entry</span><svg aria-hidden="true" focusable="false" width="16" height="16"><use href="#sk-icon-chevron-down" /></svg></span>
                                    </summary>
                                    <div class="project-entry-expanded">
                                        <JournalEntryContent Entry="entry" ReturnUrl="@ProjectsUrl(_selectedProjectId, includeEntryState: true)" HeadingLevel="3" ShowCreatedMetadata="false" />
                                        @EntryActions(entry)
                                    </div>
                                </details>
                            </li>
                        }
                    </ul>
                    @if (HasEntryPager) { @EntryPager() }
                }
            }
        </section>
    </div>
}
else
{
    <div class="sj-directory">
        <PageHeader Title="My projects" Description="Find a project, then open its journal.">
            <Actions>
                @if (_currentUser?.Role == AppRole.Administrator)
                {
                    <a href="/admin/projects/create" class="sk-button sk-button--secondary">Create project</a>
                }
            </Actions>
        </PageHeader>
        <PageAlerts Error="@(_projectSelectionError ?? _error ?? _favoritesError)" />

        <form class="panel-card sk-field-row sj-directory-toolbar" role="search" aria-label="Search projects" @onsubmit="SearchProjects" @onsubmit:preventDefault>
            <div class="sk-field">
                <label class="sk-field__label" for="projectListSearch">Search projects</label>
                <div class="sk-field__control"><input id="projectListSearch" @ref="_directorySearch" class="sk-input" type="search" @bind="_projectSearchInput" @bind:event="oninput" placeholder="Project name, code, or description" /></div>
            </div>
            <div class="sk-field-row__actions">
                <div class="sk-field-row__action-group">
                    <button type="submit" class="sk-button sk-button--primary">Search</button>
                    <button type="button" class="sk-button sk-button--secondary" @onclick="ShowProjects">Show my projects</button>
                    <button type="button" class="sk-button sk-button--secondary" @onclick="ShowFavorites">Show favorites</button>
                </div>
            </div>
        </form>

        @if (_projects.Count == 0)
        {
            <section class="panel-card sk-empty-state">
                <h2 class="sk-empty-state__heading">No projects yet</h2>
                <p class="sk-empty-state__body">Projects appear here when you have access.</p>
                @if (_currentUser?.Role == AppRole.Administrator)
                {
                    <a class="sk-button sk-button--primary" href="/admin/projects/create">Create your first project</a>
                }
                else
                {
                    <p class="sk-empty-state__body">Ask an administrator to add you to a project group.</p>
                }
            </section>
        }
        else if (!_showProjects)
        {
            <p class="sj-muted project-directory-prompt">Search by name or code, or show all @_projects.Count @(_projects.Count == 1 ? "project" : "projects") you can access.</p>
        }
        else
        {
            @if (_favoritesOnly || !string.IsNullOrWhiteSpace(_projectSearchText))
            {
                <div class="sj-filter-chips" aria-label="Active project filters">
                    @if (_favoritesOnly)
                    {
                        <button class="sk-button sk-button--secondary sk-button--sm" type="button" @onclick="ClearFavoriteFilter" aria-label="Remove favorites filter">Favorites <span aria-hidden="true">×</span></button>
                    }
                    @if (!string.IsNullOrWhiteSpace(_projectSearchText))
                    {
                        <button class="sk-button sk-button--secondary sk-button--sm" type="button" @onclick="ClearProjectSearch" aria-label="@($"Remove project search: {_projectSearchText}")">Search: @_projectSearchText <span aria-hidden="true">×</span></button>
                    }
                </div>
            }
            <section class="project-directory-results" aria-labelledby="project-results-heading">
                <div class="sj-results-summary">
                    <h2 id="project-results-heading" class="sj-subheading" tabindex="-1" @ref="_favoriteResultsFocus">@(_favoritesOnly ? "Favorite projects" : "Projects")</h2>
                    <p class="sj-muted" role="status">@ProjectRangeLabel</p>
                </div>
                @if (_favoritesOnly && _favoritesLoadFailed)
                {
                    <div class="panel-card sk-empty-state">
                        <h3 class="sk-empty-state__heading">Favorites could not be loaded</h3>
                        <p class="sk-empty-state__body">Try loading your saved favorites again.</p>
                        <button class="sk-button sk-button--secondary" type="button" @onclick="ShowFavorites">Try again</button>
                    </div>
                }
                else if (_favoritesOnly && _favoriteProjectIds.Count == 0)
                {
                    <div class="panel-card sk-empty-state">
                        <h3 class="sk-empty-state__heading">No favorite projects yet</h3>
                        <p class="sk-empty-state__body">Choose Favorite beside a project to save it here. Favorites are private to your account.</p>
                        <button class="sk-button sk-button--secondary" type="button" @onclick="ShowProjects">Browse my projects</button>
                    </div>
                }
                else if (FilteredProjectCount == 0)
                {
                    <div class="panel-card sk-empty-state">
                        <h3 class="sk-empty-state__heading">No @(_favoritesOnly ? "favorite projects" : "projects") match “@_projectSearchText”</h3>
                        <p class="sk-empty-state__body">Try another name or clear the search.</p>
                        <button class="sk-button sk-button--secondary" type="button" @onclick="ClearProjectSearch">Clear search</button>
                    </div>
                }
                else
                {
                    <ul class="sj-directory-results" aria-label="Projects">
                        @foreach (var item in VisibleProjects)
                        {
                            <li @key="item.ProjectId">
                                <article class="sj-result-card project-directory-card">
                                <a class="project-directory-link" href="@ProjectsUrl(item.ProjectId)">
                                    <div class="sj-result-card__body">
                                        <h3 class="sj-result-card__title">@item.Name</h3>
                                        <span class="sj-result-card__meta">@item.Code</span>
                                        @if (!string.IsNullOrWhiteSpace(item.Description)) { <p class="sj-result-card__description">@item.Description</p> }
                                    </div>
                                    <span class="project-open-label">Open journal <svg aria-hidden="true" focusable="false" width="16" height="16"><use href="#sk-icon-arrow-right" /></svg></span>
                                </a>
                                <ProjectFavoriteButton ProjectName="@item.Name" IsFavorite="@_favoriteProjectIds.Contains(item.ProjectId)"
                                                       Disabled="@_favoritesLoadFailed" OnToggle="() => ToggleFavorite(item)" />
                                </article>
                            </li>
                        }
                    </ul>
                    @if (ProjectListTotalPages > 1 || FilteredProjectCount > _projectListPageSizeOptions[0])
                    {
                        <nav class="pager-bar" aria-label="Project pages">
                            @if (ProjectListTotalPages > 1)
                            {
                                <p class="sj-muted">Page @_projectListPage of @ProjectListTotalPages</p>
                                <div class="sj-result-card__actions">
                                    <button type="button" class="sk-button sk-button--secondary sk-button--sm" disabled="@(_projectListPage <= 1)" @onclick="GoToPreviousProjectListPage">Previous</button>
                                    <button type="button" class="sk-button sk-button--secondary sk-button--sm" disabled="@(_projectListPage >= ProjectListTotalPages)" @onclick="GoToNextProjectListPage">Next</button>
                                </div>
                            }
                            <div class="project-page-size">
                                <label for="projectListPageSize">Per page</label>
                                <div class="sk-select-wrapper"><select id="projectListPageSize" class="sk-select sk-select--sm" value="@_projectListPageSize" @onchange="OnProjectListPageSizeChanged">@foreach (var size in _projectListPageSizeOptions) { <option value="@size">@size</option> }</select></div>
                            </div>
                        </nav>
                    }
                }
            </section>
        }
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "projectId")] public string? ProjectIdQuery { get; set; }
    [SupplyParameterFromQuery(Name = "saved")] public string? SavedEntryQuery { get; set; }
    [SupplyParameterFromQuery(Name = "q")] public string? ProjectQuery { get; set; }
    [SupplyParameterFromQuery(Name = "browse")] public string? BrowseQuery { get; set; }
    [SupplyParameterFromQuery(Name = "favorites")] public string? FavoritesQuery { get; set; }
    [SupplyParameterFromQuery(Name = "projectPage")] public string? ProjectPageQuery { get; set; }
    [SupplyParameterFromQuery(Name = "projectSize")] public string? ProjectSizeQuery { get; set; }
    [SupplyParameterFromQuery(Name = "entryQuery")] public string? EntryQuery { get; set; }
    [SupplyParameterFromQuery(Name = "page")] public string? EntryPageQuery { get; set; }
    [SupplyParameterFromQuery(Name = "size")] public string? EntrySizeQuery { get; set; }
    [SupplyParameterFromQuery(Name = "sort")] public string? Sort { get; set; }
    [SupplyParameterFromQuery(Name = "deleted")] public string? IncludeDeletedQuery { get; set; }
    [SupplyParameterFromQuery(Name = "view")] public string? ReadingViewQuery { get; set; }
    [SupplyParameterFromQuery(Name = "entryId")] public string? ReaderEntryQuery { get; set; }

    private Guid? ProjectId => Guid.TryParse(ProjectIdQuery, out var id) ? id : null;
    private Guid? SavedEntryId => Guid.TryParse(SavedEntryQuery, out var id) ? id : null;
    private bool Browse => bool.TryParse(BrowseQuery, out var value) && value;
    private bool FavoritesOnly => bool.TryParse(FavoritesQuery, out var value) && value;
    private bool IncludeDeleted => bool.TryParse(IncludeDeletedQuery, out var value) && value;
    private int? ProjectPage => ParseNumber(ProjectPageQuery);
    private int? ProjectSize => ParseNumber(ProjectSizeQuery);
    private int? EntryPage => ParseNumber(EntryPageQuery);
    private int? EntrySize => ParseNumber(EntrySizeQuery);
    private static int? ParseNumber(string? value) => int.TryParse(value, out var number) ? number : null;

    private const string DateSortNewest = "newest";
    private const string DateSortOldest = "oldest";
    private readonly int[] _pageSizeOptions = [5, 10, 20, 50];
    private readonly int[] _projectListPageSizeOptions = [10, 20, 50, 100];
    private UserContext? _currentUser;
    private List<ProjectOverview> _projects = new();
    private List<JournalEntryView> _entries = new();
    private Guid? _selectedProjectId;
    private Guid? _entriesProjectId;
    private bool _entriesIncludeDeleted;
    private bool _entriesLoadFailed;
    private bool _includeSoftDeleted;
    private bool _showProjects;
    private bool _favoritesOnly;
    private HashSet<Guid> _favoriteProjectIds = [];
    private bool _favoritesLoadFailed;
    private string? _favoritesError;
    private string? _favoriteStatus;
    private bool _focusFavoriteResults;
    private ElementReference _favoriteResultsFocus;
    private bool _quickRead;
    private Guid? _selectedReaderEntryId;
    private Guid? _readerEntryToFocus;
    private readonly Dictionary<Guid, ElementReference> _readerEntryButtons = new();
    private ElementReference _readerListFocus;
    private ElementReference _readerDetailFocus;
    private bool _focusReaderDetail;
    private bool _focusReaderList;
    private string _searchText = string.Empty;
    private string _entrySearchInput = string.Empty;
    private string _projectSearchText = string.Empty;
    private string _projectSearchInput = string.Empty;
    private int _pageSize = 20;
    private int _currentPage = 1;
    private string _dateSortOrder = DateSortNewest;
    private int _projectListPageSize = 20;
    private int _projectListPage = 1;
    private string? _message;
    private string? _error;
    private string? _projectSelectionError;
    private Guid? _lastSavedEntryId;
    private ElementReference _workspaceFocus;
    private ElementReference _directorySearch;
    private bool _focusChangedView;
    private bool _parametersLoaded;

    private ProjectOverview? SelectedProject => _projects.FirstOrDefault(p => p.ProjectId == _selectedProjectId);
    private IEnumerable<ProjectOverview> FilteredProjects => _projects.Where(p => !_favoritesOnly || _favoriteProjectIds.Contains(p.ProjectId))
        .Where(p => string.IsNullOrWhiteSpace(_projectSearchText) || p.Code.Contains(_projectSearchText, StringComparison.OrdinalIgnoreCase) || p.Name.Contains(_projectSearchText, StringComparison.OrdinalIgnoreCase) || p.Description.Contains(_projectSearchText, StringComparison.OrdinalIgnoreCase));
    private int FilteredProjectCount => FilteredProjects.Count();
    private int ProjectListTotalPages => Math.Max(1, (int)Math.Ceiling(FilteredProjectCount / (double)_projectListPageSize));
    private IEnumerable<ProjectOverview> VisibleProjects => FilteredProjects.Skip((_projectListPage - 1) * _projectListPageSize).Take(_projectListPageSize);
    private IEnumerable<JournalEntryView> FilteredEntries => _entries.Where(e => string.IsNullOrWhiteSpace(_searchText) || e.Subject.Contains(_searchText, StringComparison.OrdinalIgnoreCase) || e.Description.Contains(_searchText, StringComparison.OrdinalIgnoreCase) || e.Notes.Contains(_searchText, StringComparison.OrdinalIgnoreCase));
    private int FilteredEntryCount => FilteredEntries.Count();
    private IEnumerable<JournalEntryView> SortedEntries => _dateSortOrder == DateSortOldest ? FilteredEntries.OrderBy(e => e.CreatedAtUtc) : FilteredEntries.OrderByDescending(e => e.CreatedAtUtc);
    private IEnumerable<JournalEntryView> VisibleEntries => SortedEntries.Skip((_currentPage - 1) * _pageSize).Take(_pageSize);
    private JournalEntryView? SelectedReaderEntry => _quickRead ? VisibleEntries.FirstOrDefault(entry => entry.RecordId == _selectedReaderEntryId) : null;
    private bool HasEntryPager => TotalPages > 1 || FilteredEntryCount > _pageSizeOptions[0];
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(FilteredEntryCount / (double)_pageSize));
    private string ProjectRangeLabel => RangeLabel(_projectListPage, _projectListPageSize, FilteredProjectCount, "project", "projects");
    private string EntryRangeLabel => RangeLabel(_currentPage, _pageSize, FilteredEntryCount, "entry", "entries");
    private string WorkspaceReturnUrl => Uri.EscapeDataString(ProjectsUrl(_selectedProjectId, includeEntryState: true));
    private string NewEntryUrl => $"/journal?projectId={_selectedProjectId:D}&returnUrl={WorkspaceReturnUrl}";

    protected override async Task OnInitializedAsync()
    {
        if (!await JournalApp.HasCurrentUserAsync()) { Navigation.NavigateTo("/"); return; }
        _currentUser = await JournalApp.GetCurrentUserAsync();
        if (_currentUser.Role == AppRole.Auditor) { Navigation.NavigateTo("/audit", replace: true); return; }
        _projects = JournalApp.GetProjects().Where(p => p.HasAccessForCurrentUser).ToList();
        LoadFavorites();
    }

    protected override void OnParametersSet()
    {
        if (_currentUser is null || _currentUser.Role == AppRole.Auditor) return;
        var previousProject = _selectedProjectId;
        var previousReaderEntry = _selectedReaderEntryId;
        _selectedProjectId = ProjectId is { } id && _projects.Any(p => p.ProjectId == id) ? id : null;
        _projectSearchInput = _projectSearchText = ProjectQuery?.Trim() ?? string.Empty;
        _favoritesOnly = FavoritesOnly;
        _showProjects = Browse || _favoritesOnly || !string.IsNullOrWhiteSpace(_projectSearchText);
        _projectListPageSize = ProjectSize is { } ps && _projectListPageSizeOptions.Contains(ps) ? ps : 20;
        _projectListPage = Math.Clamp(ProjectPage ?? 1, 1, ProjectListTotalPages);
        _entrySearchInput = _searchText = EntryQuery?.Trim() ?? string.Empty;
        _pageSize = EntrySize is { } es && _pageSizeOptions.Contains(es) ? es : 20;
        _dateSortOrder = Sort == DateSortOldest ? DateSortOldest : DateSortNewest;
        _quickRead = ReadingViewQuery == "quick";
        _includeSoftDeleted = IncludeDeleted && _currentUser.Role == AppRole.Administrator;
        _currentPage = Math.Max(1, EntryPage ?? 1);
        if (_selectedProjectId != _entriesProjectId || _includeSoftDeleted != _entriesIncludeDeleted) RefreshSelectedProjectEntries();
        _currentPage = Math.Clamp(_currentPage, 1, TotalPages);
        _selectedReaderEntryId = _quickRead && Guid.TryParse(ReaderEntryQuery, out var readerId)
            && VisibleEntries.Any(entry => entry.RecordId == readerId) ? readerId : null;
        if (_parametersLoaded && previousReaderEntry != _selectedReaderEntryId && _quickRead)
        {
            _focusReaderDetail = _selectedReaderEntryId.HasValue;
            _focusReaderList = !_selectedReaderEntryId.HasValue && previousReaderEntry.HasValue;
            _readerEntryToFocus = previousReaderEntry;
        }
        if (previousProject != _selectedProjectId)
        {
            _message = null;
            _focusChangedView = _parametersLoaded;
            _focusReaderDetail = _focusReaderList = false;
        }
        _parametersLoaded = true;
        _projectSelectionError = !string.IsNullOrWhiteSpace(ProjectIdQuery) && SelectedProject is null
            ? "This project is unavailable or you do not have access. Choose another project below."
            : null;
        if (SavedEntryId != _lastSavedEntryId)
        {
            _lastSavedEntryId = SavedEntryId;
            _message = SavedEntryId is { } savedId && _entries.FirstOrDefault(e => e.RecordId == savedId) is { } saved ? $"“{saved.Subject}” was saved to this project." : null;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusFavoriteResults && _selectedProjectId is null)
        {
            _focusFavoriteResults = false;
            await _favoriteResultsFocus.FocusAsync();
        }
        var visibleReaderIds = _quickRead ? VisibleEntries.Select(entry => entry.RecordId).ToHashSet() : new HashSet<Guid>();
        foreach (var id in _readerEntryButtons.Keys.Where(id => !visibleReaderIds.Contains(id)).ToArray()) _readerEntryButtons.Remove(id);
        if (_focusChangedView)
        {
            _focusChangedView = false;
            if (_selectedProjectId.HasValue) await _workspaceFocus.FocusAsync();
            else await _directorySearch.FocusAsync();
            return;
        }
        if (_focusReaderDetail && SelectedReaderEntry is not null)
        {
            _focusReaderDetail = false;
            await _readerDetailFocus.FocusAsync();
        }
        else if (_focusReaderList && _quickRead && FilteredEntryCount > 0)
        {
            _focusReaderList = false;
            if (_readerEntryToFocus is { } id && VisibleEntries.Any(entry => entry.RecordId == id)
                && _readerEntryButtons.TryGetValue(id, out var button)) await button.FocusAsync();
            else await _readerListFocus.FocusAsync();
        }
    }

    private string ProjectsUrl(Guid? projectId, bool includeEntryState = false)
    {
        var values = new Dictionary<string, string?>
        {
            ["projectId"] = projectId?.ToString("D"),
            ["q"] = string.IsNullOrWhiteSpace(_projectSearchText) ? null : _projectSearchText,
            ["browse"] = _showProjects ? "true" : null,
            ["favorites"] = _favoritesOnly ? "true" : null,
            ["projectPage"] = _projectListPage > 1 ? _projectListPage.ToString() : null,
            ["projectSize"] = _projectListPageSize != 20 ? _projectListPageSize.ToString() : null,
            ["entryQuery"] = includeEntryState && !string.IsNullOrWhiteSpace(_searchText) ? _searchText : null,
            ["page"] = includeEntryState && _currentPage > 1 ? _currentPage.ToString() : null,
            ["size"] = includeEntryState && _pageSize != 20 ? _pageSize.ToString() : null,
            ["sort"] = includeEntryState && _dateSortOrder == DateSortOldest ? DateSortOldest : null,
            ["deleted"] = includeEntryState && _includeSoftDeleted ? "true" : null,
            ["view"] = includeEntryState && _quickRead ? "quick" : null,
            ["entryId"] = includeEntryState && _quickRead ? _selectedReaderEntryId?.ToString("D") : null
        };
        var query = string.Join("&", values.Where(p => p.Value is not null).Select(p => $"{p.Key}={Uri.EscapeDataString(p.Value!)}"));
        return string.IsNullOrEmpty(query) ? "/projects" : $"/projects?{query}";
    }

    private void NavigateState() => Navigation.NavigateTo(ProjectsUrl(_selectedProjectId, includeEntryState: _selectedProjectId.HasValue));
    private void SearchProjects() { _projectSearchText = _projectSearchInput.Trim(); _showProjects = true; _projectListPage = 1; _error = null; NavigateState(); }
    private void ShowProjects() { _favoritesOnly = false; _projectSearchText = _projectSearchInput = string.Empty; _showProjects = true; _projectListPage = 1; _error = null; NavigateState(); }
    private void ShowFavorites() { LoadFavorites(); _favoritesOnly = true; _projectSearchText = _projectSearchInput = string.Empty; _showProjects = true; _projectListPage = 1; _error = null; NavigateState(); }
    private void ClearProjectSearch() { _projectSearchText = _projectSearchInput = string.Empty; _projectListPage = 1; NavigateState(); }
    private void ClearFavoriteFilter() { _favoritesOnly = false; _projectListPage = 1; NavigateState(); }

    private void LoadFavorites()
    {
        try
        {
            _favoriteProjectIds = JournalApp.GetFavoriteProjectIds().ToHashSet();
            _favoritesLoadFailed = false;
            _favoritesError = null;
        }
        catch (Exception)
        {
            _favoritesLoadFailed = true;
            _favoritesError = "Your favorites could not be loaded. Try Show favorites again.";
        }
    }

    private void ToggleFavorite(ProjectOverview project)
    {
        if (_favoritesLoadFailed) return;
        _favoritesError = null;
        try
        {
            var isFavorite = JournalApp.SetProjectFavorite(project.ProjectId, !_favoriteProjectIds.Contains(project.ProjectId));
            if (isFavorite) _favoriteProjectIds.Add(project.ProjectId);
            else _favoriteProjectIds.Remove(project.ProjectId);
            _favoriteStatus = isFavorite ? $"{project.Name} added to favorites." : $"{project.Name} removed from favorites.";
            if (!isFavorite && _favoritesOnly && _selectedProjectId is null)
            {
                _projectListPage = Math.Clamp(_projectListPage, 1, ProjectListTotalPages);
                _focusFavoriteResults = true;
                NavigateState();
            }
        }
        catch (Exception)
        {
            _favoritesError = "Your favorites could not be updated. Please try again.";
        }
    }
    private void SetReadingView(bool quickRead) { _quickRead = quickRead; _selectedReaderEntryId = null; NavigateState(); }
    private void SelectReaderEntry(Guid entryId)
    {
        if (!_quickRead || !VisibleEntries.Any(entry => entry.RecordId == entryId)) return;
        _selectedReaderEntryId = entryId;
        _focusReaderDetail = true;
        _focusReaderList = false;
        NavigateState();
    }
    private void ClearReaderSelection()
    {
        _readerEntryToFocus = _selectedReaderEntryId;
        _selectedReaderEntryId = null;
        _focusReaderList = true;
        _focusReaderDetail = false;
        NavigateState();
    }
    private void ClearReaderForListChange() { _selectedReaderEntryId = null; _focusReaderDetail = false; }
    private void SearchEntries() { ClearReaderForListChange(); _searchText = _entrySearchInput.Trim(); _currentPage = 1; NavigateState(); }
    private void ClearEntrySearch() { ClearReaderForListChange(); _searchText = _entrySearchInput = string.Empty; _currentPage = 1; NavigateState(); }
    private void PreviousPage() { if (_currentPage > 1) { ClearReaderForListChange(); _currentPage--; NavigateState(); } }
    private void NextPage() { if (_currentPage < TotalPages) { ClearReaderForListChange(); _currentPage++; NavigateState(); } }
    private void GoToPreviousProjectListPage() { if (_projectListPage > 1) { _projectListPage--; NavigateState(); } }
    private void GoToNextProjectListPage() { if (_projectListPage < ProjectListTotalPages) { _projectListPage++; NavigateState(); } }
    private void OnPageSizeChanged(ChangeEventArgs args) { if (int.TryParse(args.Value?.ToString(), out var size) && _pageSizeOptions.Contains(size)) { ClearReaderForListChange(); _pageSize = size; _currentPage = 1; NavigateState(); } }
    private void OnProjectListPageSizeChanged(ChangeEventArgs args) { if (int.TryParse(args.Value?.ToString(), out var size) && _projectListPageSizeOptions.Contains(size)) { _projectListPageSize = size; _projectListPage = 1; NavigateState(); } }
    private void OnSortOrderChanged(ChangeEventArgs args) { ClearReaderForListChange(); _dateSortOrder = args.Value?.ToString() == DateSortOldest ? DateSortOldest : DateSortNewest; _currentPage = 1; NavigateState(); }
    private void OnIncludeSoftDeletedChanged(ChangeEventArgs args) { ClearReaderForListChange(); _includeSoftDeleted = args.Value is true; _currentPage = 1; NavigateState(); }

    private void RefreshSelectedProjectEntries()
    {
        _error = null;
        _entriesLoadFailed = false;
        _entriesProjectId = _selectedProjectId;
        _entriesIncludeDeleted = _includeSoftDeleted;
        if (!_selectedProjectId.HasValue || _currentUser?.Role == AppRole.Auditor) { _entries.Clear(); _currentPage = 1; return; }
        try
        {
            _entries = JournalApp.GetJournalEntries(_selectedProjectId.Value, includeSoftDeleted: _includeSoftDeleted).ToList();
            _currentPage = Math.Clamp(_currentPage, 1, TotalPages);
        }
        catch (Exception ex) { _entriesLoadFailed = true; _entries.Clear(); _error = ex.Message; _currentPage = 1; }
    }

    private async Task SoftDeleteAsync(JournalEntryView entry)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"Delete “{entry.Subject}”? The entry will be hidden from the project journal. Its history is retained, and an administrator can restore it.")) return;
        _message = null; _error = null;
        try
        {
            var deleted = JournalApp.SoftDeleteJournalEntry(entry.RecordId);
            _message = deleted ? $"“{entry.Subject}” was deleted. An administrator can restore it." : "Entry was already deleted or not found.";
            RefreshSelectedProjectEntries();
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private void Restore(Guid recordId)
    {
        _message = null; _error = null;
        try
        {
            var restored = JournalApp.RestoreJournalEntry(recordId);
            _message = restored ? "Entry restored." : "Entry was already active or not found.";
            RefreshSelectedProjectEntries();
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private RenderFragment EntryPager() => @<nav class="pager-bar" aria-label="Journal entry pages">
        @if (TotalPages > 1)
        {
            <p class="sj-muted">Page @_currentPage of @TotalPages</p>
            <div class="sj-result-card__actions">
                <button type="button" class="sk-button sk-button--secondary sk-button--sm" disabled="@(_currentPage <= 1)" @onclick="PreviousPage">Previous</button>
                <button type="button" class="sk-button sk-button--secondary sk-button--sm" disabled="@(_currentPage >= TotalPages)" @onclick="NextPage">Next</button>
            </div>
        }
        <div class="project-page-size">
            <label for="projectJournalPageSize">Per page</label>
            <div class="sk-select-wrapper"><select id="projectJournalPageSize" class="sk-select sk-select--sm" value="@_pageSize" @onchange="OnPageSizeChanged">@foreach (var size in _pageSizeOptions) { <option value="@size">@size</option> }</select></div>
        </div>
    </nav>;

    private RenderFragment EntryActions(JournalEntryView entry) => @<div class="project-entry-actions">
        @if (!entry.IsSoftDeleted)
        {
            <button type="button" class="sk-button sk-button--ghost sk-button--sm" @onclick="() => SoftDeleteAsync(entry)">Delete<span class="sk-visually-hidden">: @entry.Subject</span></button>
        }
        else if (_currentUser?.Role == AppRole.Administrator)
        {
            <button type="button" class="sk-button sk-button--secondary sk-button--sm" @onclick="() => Restore(entry.RecordId)">Restore<span class="sk-visually-hidden">: @entry.Subject</span></button>
        }
    </div>;

    private static string RangeLabel(int page, int size, int count, string singular, string plural)
        => count == 0 ? $"0 {plural}" : count <= size ? $"{count} {(count == 1 ? singular : plural)}" : $"{(page - 1) * size + 1}–{Math.Min(page * size, count)} of {count} {plural}";
}
