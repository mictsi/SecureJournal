@page "/admin/projects/trash"
@attribute [Authorize(Roles = "Administrator")]
@inject ISecureJournalAppService JournalApp
@inject ILogger<ProjectTrash> Logger

<PageTitle>Project Trash</PageTitle>

<PageHeader Title="Project trash"
            Description="Soft-deleted projects awaiting restore or permanent deletion." />

<PageAlerts Message="@_message" Error="@_error" />

@if (_deletedProjects.Count == 0)
{
    <section class="panel-card">
        <p>No deleted projects.</p>
    </section>
}
else
{
    <section class="panel-card">
        <div class="panel-card-header">
            <h3>Deleted Projects</h3>
            <span class="sj-muted">@FilteredDeletedProjects.Count item(s)</span>
        </div>

        <div class="sk-stack sk-stack--gap-16">
            <div class="sk-field">
                <label class="sk-field__label" for="trashSearch">Search projects</label>
                <input id="trashSearch"
                       class="sk-input"
                       type="text"
                       value="@_searchText"
                       @oninput="OnSearchChanged"
                       placeholder="Search by code or name..." />
            </div>
            <div class="sk-field">
                <label class="sk-field__label" for="trashPageSize">Page size</label>
                <div class="sk-select-wrapper">
                    <select id="trashPageSize" class="sk-select" @onchange="OnPageSizeChanged">
                    @foreach (var pageSize in _pageSizeOptions)
                    {
                        <option value="@pageSize" selected="@(pageSize == _pageSize)">@pageSize</option>
                    }
                </select>
                </div>
            </div>
            <div class="sk-cluster">
                <small class="sj-muted">Page @_currentPage of @TotalPages</small>
            </div>
        </div>

        @if (FilteredDeletedProjects.Count == 0)
        {
            <p>No deleted projects match the current search text.</p>
        }
        else
        {
            <div class="sk-table" role="region" aria-label="Deleted projects" tabindex="0">
                <table>
                    <thead>
                        <tr>
                            <th>Code</th>
                            <th>Name</th>
                            <th>Deleted</th>
                            <th>Permanent deletion</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var project in PagedDeletedProjects)
                        {
                            <tr>
                                <td>@project.Code</td>
                                <td>@project.Name</td>
                                <td>@project.DeletedAtUtc.ToString("yyyy-MM-dd") UTC</td>
                                <td>@project.ScheduledDeletionAtUtc.ToString("yyyy-MM-dd") UTC</td>
                                <td>
                                    <button type="button"
                                            class="sk-button sk-button--secondary sk-button--sm"
                                            @onclick="() => RestoreProjectAsync(project)">
                                        Restore
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="sk-cluster">
                <small class="sj-muted">Showing @PagedDeletedProjects.Count of @FilteredDeletedProjects.Count deleted project(s)</small>
                <div class="sk-cluster">
                    <button type="button" class="sk-button sk-button--secondary sk-button--sm" disabled="@(_currentPage <= 1)" @onclick="GoToPreviousPage">Previous</button>
                    <button type="button" class="sk-button sk-button--secondary sk-button--sm" disabled="@(_currentPage >= TotalPages)" @onclick="GoToNextPage">Next</button>
                </div>
            </div>
        }
    </section>
}

@code {
    private List<DeletedProjectOverview> _deletedProjects = new();
    private string? _message;
    private string? _error;
    private string _searchText = string.Empty;
    private int _currentPage = 1;
    private int _pageSize = 10;
    private readonly int[] _pageSizeOptions = new[] { 10, 20, 50 };

    private List<DeletedProjectOverview> FilteredDeletedProjects =>
        _deletedProjects
            .Where(project =>
                string.IsNullOrWhiteSpace(_searchText)
                || project.Code.Contains(_searchText, StringComparison.OrdinalIgnoreCase)
                || project.Name.Contains(_searchText, StringComparison.OrdinalIgnoreCase))
            .ToList();

    private List<DeletedProjectOverview> PagedDeletedProjects =>
        FilteredDeletedProjects
            .Skip((_currentPage - 1) * _pageSize)
            .Take(_pageSize)
            .ToList();

    private int TotalPages => Math.Max(1, (int)Math.Ceiling((double)FilteredDeletedProjects.Count / _pageSize));

    protected override Task OnInitializedAsync()
    {
        LoadDeletedProjects();
        return Task.CompletedTask;
    }

    private void LoadDeletedProjects()
    {
        _deletedProjects = JournalApp.GetDeletedProjects().ToList();
        EnsureValidPage();
    }

    private void OnSearchChanged(ChangeEventArgs args)
    {
        _searchText = args.Value?.ToString() ?? string.Empty;
        _currentPage = 1;
    }

    private void OnPageSizeChanged(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var newSize) && _pageSizeOptions.Contains(newSize))
        {
            _pageSize = newSize;
            _currentPage = 1;
        }
    }

    private void GoToPreviousPage()
    {
        if (_currentPage > 1)
        {
            _currentPage--;
        }
    }

    private void GoToNextPage()
    {
        if (_currentPage < TotalPages)
        {
            _currentPage++;
        }
    }

    private void EnsureValidPage()
    {
        if (_currentPage < 1)
        {
            _currentPage = 1;
        }

        if (_currentPage > TotalPages)
        {
            _currentPage = TotalPages;
        }
    }

    private Task RestoreProjectAsync(DeletedProjectOverview project)
    {
        _message = null;
        _error = null;

        try
        {
            var restored = JournalApp.RestoreProject(project.ProjectId);
            _message = restored
                ? $"Project '{project.Code}' restored."
                : $"Project '{project.Code}' is not in trash.";
            LoadDeletedProjects();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Project restore failed");
            _error = ex.Message;
        }

        return Task.CompletedTask;
    }
}
