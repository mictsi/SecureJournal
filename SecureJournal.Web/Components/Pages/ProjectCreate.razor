@page "/admin/projects/create"
@page "/admin/projects/create/{Step:int}"
@attribute [Authorize(Roles = "Administrator")]
@implements IAsyncDisposable
@inject ISecureJournalAppService JournalApp
@inject ProjectCreateWizardState WizardState
@inject NavigationManager Navigation
@inject ILogger<ProjectCreate> Logger
@inject IJSRuntime JS

<PageTitle>Create project</PageTitle>

<div class="sj-focused-page">
<PageHeader Title="Create project"
            Description="Define the project, choose its groups, then review before creating." />

<section class="panel-card project-create-progress">
    <div class="project-create-progress-labels">
        <span>Step @DisplayStep of @TotalSteps</span>
        <span>@StepTitle</span>
    </div>
    <ol class="project-create-steps" aria-label="Create project steps">
        <li class="@(CurrentStep == 1 ? "is-current" : string.Empty)" aria-current="@(CurrentStep == 1 ? "step" : null)">Project details</li>
        <li class="@(CurrentStep == 2 ? "is-current" : string.Empty)" aria-current="@(CurrentStep == 2 ? "step" : null)">Group access</li>
        @if (!WizardState.UseExistingGroups)
        {
            <li class="@(CurrentStep == 3 ? "is-current" : string.Empty)" aria-current="@(CurrentStep == 3 ? "step" : null)">Group members</li>
        }
        <li class="@(CurrentStep == 4 ? "is-current" : string.Empty)" aria-current="@(CurrentStep == 4 ? "step" : null)">Review &amp; create</li>
    </ol>
</section>

<PageAlerts Message="@_message" Error="@_error" />
<NavigationLock ConfirmExternalNavigation="@HasUnsavedChanges" OnBeforeInternalNavigation="ConfirmNavigationAsync" />

@if (_currentUser is null)
{
    <p>Loading current user...</p>
}
else if (_currentUser.Role != AppRole.Administrator)
{
    <div class="sk-alert sk-alert--warning" role="alert">
    <svg class="sk-alert__icon" aria-hidden="true" focusable="false" width="20" height="20"><use href="#sk-icon-warning" /></svg>
    <div class="sk-alert__content"><p class="sk-alert__body">Administrator access is required. Current user: <strong>@_currentUser.DisplayName</strong> (@_currentUser.Role).</p></div>
    </div>
}
else if (_createdProject is { } createdProject)
{
    <section class="panel-card">
        <h2>Project created; finish access setup</h2>
        <p><strong>@createdProject.Name</strong> (@createdProject.Code) was created, but its group setup could not finish. Open Manage projects to review access before using it.</p>
        <div class="sk-cluster sj-form-actions">
            <a href="@($"/admin/projects?projectId={createdProject.ProjectId:D}")" class="sk-button sk-button--primary">Review project access</a>
            <a href="@($"/projects?projectId={createdProject.ProjectId:D}")" class="sk-button sk-button--secondary">View project</a>
        </div>
    </section>
}
else if (CurrentStep == 1)
{
    <section class="panel-card project-create-card">
        <div class="panel-card-header">
            <h2>Project details</h2>
        </div>
        <p class="project-create-step-copy">Give the project a name. The remaining details are optional and can be updated later.</p>

        <EditForm Model="WizardState.ProjectDraft" OnValidSubmit="GoToStepTwoAsync" FormName="admin-project-create-step-1">
            <AntiforgeryToken />
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="project-metadata-grid">
                <div class="project-metadata-main">
                    <label class="sk-field__label" for="projectName">Name</label>
                    <InputText id="projectName" class="sk-input" maxlength="100" aria-required="true" @bind-Value="WizardState.ProjectDraft.Name" @oninput="e => WizardState.ProjectDraft.Name = e.Value?.ToString() ?? string.Empty" />
                </div>

                <div class="project-metadata-main">
                    <label class="sk-field__label" for="projectDescription">Description</label>
                    <div class="journal-editor-shell">
                        <InputTextArea id="projectDescription"
                                       class="sk-input journal-rich-editor-source"
                                       rows="8"
                                       maxlength="500"
                                       @bind-Value="WizardState.ProjectDraft.Description" @oninput="e => WizardState.ProjectDraft.Description = e.Value?.ToString() ?? string.Empty" />
                        <p class="journal-editor-hint">Use the editor toolbar for project context, lists, tables and links.</p>
                    </div>
                    <small class="sj-muted">Project code is generated automatically (for example PRJ0001).</small>
                </div>

                <div class="sk-field">
                    <label class="sk-field__label" for="projectOwner">Project Owner</label>
                    <InputText id="projectOwner" class="sk-input" maxlength="100" @bind-Value="WizardState.ProjectDraft.ProjectOwner" @oninput="e => WizardState.ProjectDraft.ProjectOwner = e.Value?.ToString() ?? string.Empty" />
                </div>
                <div class="sk-field">
                    <label class="sk-field__label" for="projectDepartment">Department</label>
                    <InputText id="projectDepartment" class="sk-input" maxlength="100" @bind-Value="WizardState.ProjectDraft.Department" @oninput="e => WizardState.ProjectDraft.Department = e.Value?.ToString() ?? string.Empty" />
                </div>
                <div class="sk-field">
                    <label class="sk-field__label" for="projectEmail">Project owner email</label>
                    <InputText id="projectEmail" class="sk-input" maxlength="254" @bind-Value="WizardState.ProjectDraft.ProjectEmail" @oninput="e => WizardState.ProjectDraft.ProjectEmail = e.Value?.ToString() ?? string.Empty" />
                </div>
                <div class="sk-field">
                    <label class="sk-field__label" for="projectPhone">Project owner phone</label>
                    <InputText id="projectPhone" class="sk-input" maxlength="32" @bind-Value="WizardState.ProjectDraft.ProjectPhone" @oninput="e => WizardState.ProjectDraft.ProjectPhone = e.Value?.ToString() ?? string.Empty" />
                </div>
            </div>

            <div class="sk-cluster sj-form-actions">
                <button type="button" class="sk-button sk-button--secondary" @onclick="CancelWizard">Cancel</button>
                <button type="submit" class="sk-button sk-button--primary">Continue to group access</button>
            </div>
        </EditForm>
    </section>
}
else if (CurrentStep == 2)
{
    <section class="panel-card project-create-card">
        <div class="panel-card-header">
            <h2>Group access</h2>
        </div>

        <p class="project-create-step-copy">Choose existing groups or create new groups to assign to this project.</p>

        <div class="project-create-mode-toggle">
            <label class="sk-radio">
                <input class="sk-radio__input" id="useExistingGroups" type="radio" name="groupMode" checked="@WizardState.UseExistingGroups" @onchange="() => SetGroupMode(true)" />
                <span class="sk-radio__control" aria-hidden="true"></span>
                <span class="sk-radio__content">
                    <span class="sk-radio__label">Choose existing groups</span>
                </span>
            </label>
            <label class="sk-radio">
                <input class="sk-radio__input" id="createNewGroups" type="radio" name="groupMode" checked="@(!WizardState.UseExistingGroups)" @onchange="() => SetGroupMode(false)" />
                <span class="sk-radio__control" aria-hidden="true"></span>
                <span class="sk-radio__content">
                    <span class="sk-radio__label">Create new group</span>
                </span>
            </label>
        </div>

        @if (WizardState.UseExistingGroups)
        {
            @if (_existingGroups.Count == 0)
            {
                <p>No groups exist yet. Create a new group, or continue to review and assign access later.</p>
            }
            else
            {
                <div class="project-create-selection-panel">
                    @foreach (var group in _existingGroups)
                    {
                        <label class="sk-checkbox">
                            <input class="sk-checkbox__input"
                                   type="checkbox"
                                   checked="@WizardState.SelectedExistingGroupIds.Contains(group.GroupId)"
                                   @onchange="args => ToggleExistingGroup(group.GroupId, args)" />
                            <span class="sk-checkbox__box" aria-hidden="true"></span>
                            <span class="sk-checkbox__content">
                                <span class="sk-checkbox__label">@group.Name</span>
                                <span class="sk-checkbox__description">@RenderValueOrDash(group.Description)</span>
                            </span>
                        </label>
                    }
                </div>
            }
        }
        else
        {
            <div class="project-create-selection-panel">
                <div class="sk-field">
                    <label class="sk-field__label" for="newGroupName">Group Name</label>
                    <input id="newGroupName" class="sk-input" maxlength="100" @bind="_newGroupDraft.Name" @bind:event="oninput" />
                </div>
                <div class="sk-field">
                    <label class="sk-field__label" for="newGroupDescription">Group Description</label>
                    <div class="journal-editor-shell">
                        <textarea id="newGroupDescription"
                                  class="sk-input journal-rich-editor-source"
                                  rows="6"
                                  maxlength="500"
                                  @bind="_newGroupDraft.Description"></textarea>
                        <p class="journal-editor-hint">Use rich text if you want to describe group responsibilities or access scope.</p>
                    </div>
                </div>
                <button type="button" class="sk-button sk-button--secondary" @onclick="AddNewGroupAsync">Add New Group</button>
            </div>

            @if (WizardState.NewGroups.Count == 0)
            {
                <p>Add at least one group to continue.</p>
            }
            else
            {
                <ul class="list-group project-create-list">
                    @foreach (var group in WizardState.NewGroups)
                    {
                        <li class="sj-list-item sk-cluster">
                            <div>
                                <strong>@group.Name</strong>
                                <div class="sj-muted">@RenderValueOrDash(group.Description)</div>
                            </div>
                            <button type="button" class="sk-button sk-button--danger sk-button--sm" @onclick="() => RemoveNewGroup(group.DraftId)">Remove</button>
                        </li>
                    }
                </ul>
            }
        }

        <div class="sk-cluster">
            <div class="sk-cluster sj-form-actions">
                <button type="button" class="sk-button sk-button--secondary" @onclick="CancelWizard">Cancel</button>
                <button type="button" class="sk-button sk-button--secondary" @onclick="GoToStepOne">Back</button>
            </div>
            @if (WizardState.UseExistingGroups)
            {
                <button type="button" class="sk-button sk-button--primary" @onclick="GoToReview">Review project</button>
            }
            else
            {
                <button type="button" class="sk-button sk-button--primary" @onclick="GoToStepThree">Continue to members</button>
            }
        </div>
    </section>
}
else if (CurrentStep == 3)
{
    <section class="panel-card project-create-card">
        <div class="panel-card-header">
            <h2>Group members</h2>
        </div>

        <p class="project-create-step-copy">Choose who needs access. You can also add members later in group management.</p>

        @if (_users.Count == 0)
        {
            <p>No users are available to assign as group members.</p>
        }
        else
        {
            @foreach (var group in WizardState.NewGroups)
            {
                <div class="project-create-member-card">
                    <h4 class="sj-subheading">@group.Name</h4>
                    <p class="sj-muted">@RenderValueOrDash(group.Description)</p>
                    <div class="sk-grid sk-grid--cols-2">
                        @foreach (var user in _users)
                        {
                            <div>
                                <label class="sk-checkbox">
                                    <input class="sk-checkbox__input"
                                           type="checkbox"
                                           checked="@group.MemberUserIds.Contains(user.UserId)"
                                           @onchange="args => ToggleGroupMember(group, user.UserId, args)" />
                                    <span class="sk-checkbox__box" aria-hidden="true"></span>
                                    <span class="sk-checkbox__content">
                                        <span class="sk-checkbox__label">@user.DisplayName</span>
                                        <span class="sk-checkbox__description">@user.Username</span>
                                    </span>
                                </label>
                            </div>
                        }
                    </div>
                </div>
            }
        }

        <div class="sk-cluster">
            <div class="sk-cluster sj-form-actions">
                <button type="button" class="sk-button sk-button--secondary" @onclick="CancelWizard">Cancel</button>
                <button type="button" class="sk-button sk-button--secondary" @onclick="GoToStepTwo">Back</button>
            </div>
            <button type="button" class="sk-button sk-button--primary" @onclick="GoToReview">Review project</button>
        </div>
    </section>
}
else
{
    <section class="panel-card project-create-card">
        <div class="panel-card-header">
            <h2>Review &amp; create</h2>
        </div>
        <p class="project-create-step-copy">Check the project details and who will have access before creating it.</p>

        <dl class="project-create-review">
            <div><dt>Project name</dt><dd>@WizardState.ProjectDraft.Name</dd></div>
            <div><dt>Owner</dt><dd>@RenderValueOrDash(WizardState.ProjectDraft.ProjectOwner)</dd></div>
            <div><dt>Department</dt><dd>@RenderValueOrDash(WizardState.ProjectDraft.Department)</dd></div>
            <div><dt>Owner email</dt><dd>@RenderValueOrDash(WizardState.ProjectDraft.ProjectEmail)</dd></div>
            <div><dt>Owner phone</dt><dd>@RenderValueOrDash(WizardState.ProjectDraft.ProjectPhone)</dd></div>
        </dl>

        @if (!string.IsNullOrWhiteSpace(WizardState.ProjectDraft.Description))
        {
            <div class="project-create-review-content">
                <h3>Description</h3>
                @SimpleMarkupPreview.Render(WizardState.ProjectDraft.Description)
            </div>
        }

        <div class="project-create-review-content">
            <h3>Group access</h3>
            @if (WizardState.UseExistingGroups)
            {
                @if (WizardState.SelectedExistingGroupIds.Count == 0)
                {
                    <p>No groups selected. Only administrators will have access until you assign a group.</p>
                }
                else
                {
                    <ul class="project-create-review-groups">
                        @foreach (var group in _existingGroups.Where(group => WizardState.SelectedExistingGroupIds.Contains(group.GroupId)))
                        {
                            <li><strong>@group.Name</strong><span>Existing members will receive project access.</span></li>
                        }
                    </ul>
                }
            }
            else
            {
                <ul class="project-create-review-groups">
                    @foreach (var group in WizardState.NewGroups)
                    {
                        <li>
                            <strong>@group.Name <span class="sk-badge sk-badge--neutral">New group</span></strong>
                            <span>@(group.MemberUserIds.Count == 0 ? "No members yet. Add members later to give them access." : $"{group.MemberUserIds.Count} member(s): {string.Join(", ", _users.Where(user => group.MemberUserIds.Contains(user.UserId)).Select(user => user.DisplayName))}")</span>
                        </li>
                    }
                </ul>
            }
        </div>

        <div class="sk-cluster sj-form-actions">
            <button type="button" class="sk-button sk-button--secondary" @onclick="GoBackFromReview" disabled="@_isSubmitting">Back</button>
            <button type="button" class="sk-button sk-button--primary" @onclick="CreateProjectAsync" disabled="@_isSubmitting">@(_isSubmitting ? "Creating project…" : "Create project")</button>
            <button type="button" class="sk-button sk-button--ghost" @onclick="CancelWizard" disabled="@_isSubmitting">Cancel</button>
        </div>
    </section>
}

</div>

@code {
    [Parameter] public int? Step { get; set; }

    private const int MinStep = 1;
    private const int MaxStep = 4;
    private const string WizardBaseRoute = "/admin/projects/create";
    private const string StepOneRoute = $"{WizardBaseRoute}/1";
    private const string StepTwoRoute = $"{WizardBaseRoute}/2";
    private const string StepThreeRoute = $"{WizardBaseRoute}/3";
    private const string ReviewRoute = $"{WizardBaseRoute}/4";
    private const string StartPageRoute = "/projects";

    private UserContext? _currentUser;
    private string? _message;
    private string? _error;
    private bool _isSubmitting;
    private bool _allowNavigation;
    private ProjectOverview? _createdProject;
    private bool HasUnsavedChanges => !_allowNavigation && _createdProject is null &&
        (!string.IsNullOrWhiteSpace(WizardState.ProjectDraft.Name)
         || !string.IsNullOrWhiteSpace(WizardState.ProjectDraft.Description)
         || !string.IsNullOrWhiteSpace(WizardState.ProjectDraft.ProjectOwner)
         || !string.IsNullOrWhiteSpace(WizardState.ProjectDraft.Department)
         || !string.IsNullOrWhiteSpace(WizardState.ProjectDraft.ProjectEmail)
         || !string.IsNullOrWhiteSpace(WizardState.ProjectDraft.ProjectPhone)
         || WizardState.SelectedExistingGroupIds.Count > 0 || WizardState.NewGroups.Count > 0
         || !string.IsNullOrWhiteSpace(_newGroupDraft.Name) || !string.IsNullOrWhiteSpace(_newGroupDraft.Description));
    private CreateGroupRequest _newGroupDraft = new();
    private List<GroupOverview> _existingGroups = [];
    private List<UserOverview> _users = [];
    // JavaScript interop is only legal once the component has rendered
    // interactively. A form POST re-renders the page statically, and the editor
    // calls made during that pass threw "JavaScript interop calls cannot be issued
    // at this time", which surfaced as an unhandled error on every submit.
    private bool _jsReady;

    private readonly string[] _editorIds = ["projectDescription", "newGroupDescription"];

    private int CurrentStep { get; set; } = MinStep;

    private string StepTitle => CurrentStep switch
    {
        1 => "Project details",
        2 => "Group access",
        3 => "Group members",
        _ => "Review & create"
    };

    private int TotalSteps => WizardState.UseExistingGroups ? 3 : 4;
    private int DisplayStep => CurrentStep == 4 ? TotalSteps : CurrentStep;

    protected override async Task OnInitializedAsync()
    {
        if (!await JournalApp.HasCurrentUserAsync())
        {
            Navigation.NavigateTo("/", forceLoad: false);
            return;
        }

        _currentUser = await JournalApp.GetCurrentUserAsync();
        _existingGroups = JournalApp.GetGroups().OrderBy(g => g.Name, StringComparer.OrdinalIgnoreCase).ToList();
        _users = JournalApp.GetUsers().OrderBy(u => u.Username, StringComparer.OrdinalIgnoreCase).ToList();
    }

    protected override void OnParametersSet()
    {
        CurrentStep = Step.GetValueOrDefault(1);
        if (CurrentStep < MinStep || CurrentStep > MaxStep)
        {
            CurrentStep = MinStep;
            Navigation.NavigateTo(StepOneRoute, forceLoad: false);
            return;
        }

        if (CurrentStep >= 2 && string.IsNullOrWhiteSpace(WizardState.ProjectDraft.Name))
        {
            Navigation.NavigateTo(StepOneRoute, forceLoad: false);
            return;
        }

        if (CurrentStep == 3 && (WizardState.UseExistingGroups || WizardState.NewGroups.Count == 0))
        {
            Navigation.NavigateTo(StepTwoRoute, forceLoad: false);
        }

        if (CurrentStep == 4 && !WizardState.UseExistingGroups && WizardState.NewGroups.Count == 0)
        {
            Navigation.NavigateTo(StepTwoRoute, forceLoad: false);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        _jsReady = true;
        var editors = new List<object>();

        if (CurrentStep == 1)
        {
            editors.Add(new
            {
                id = "projectDescription",
                value = WizardState.ProjectDraft.Description ?? string.Empty,
                minHeight = 220
            });
        }
        else if (CurrentStep == 2 && !WizardState.UseExistingGroups)
        {
            editors.Add(new
            {
                id = "newGroupDescription",
                value = _newGroupDraft.Description ?? string.Empty,
                minHeight = 180
            });
        }

        try
        {
            if (editors.Count == 0)
            {
                await JS.InvokeVoidAsync("secureJournalEditors.dispose", _editorIds);
            }
            else
            {
                await JS.InvokeVoidAsync("secureJournalEditors.syncTinyMce", editors, _editorIds);
            }
        }
        catch (JSDisconnectedException)
        {
            // Reconnection restores the interactive editor.
        }
        catch (JSException ex)
        {
            _jsReady = false;
            Logger.LogWarning(ex, "Project editor unavailable; using the text field");
        }
    }

    private async Task GoToStepTwoAsync()
    {
        ClearMessages();
        await SyncEditorValuesAsync();
        Navigation.NavigateTo(StepTwoRoute, forceLoad: false);
    }

    private void GoToStepOne()
    {
        ClearMessages();
        Navigation.NavigateTo(StepOneRoute, forceLoad: false);
    }

    private void GoToStepTwo()
    {
        ClearMessages();
        Navigation.NavigateTo(StepTwoRoute, forceLoad: false);
    }

    private void GoToStepThree()
    {
        ClearMessages();
        if (WizardState.NewGroups.Count == 0)
        {
            _error = "Add at least one new group before continuing.";
            return;
        }

        Navigation.NavigateTo(StepThreeRoute, forceLoad: false);
    }

    private void GoToReview()
    {
        ClearMessages();
        Navigation.NavigateTo(ReviewRoute, forceLoad: false);
    }

    private void GoBackFromReview()
    {
        ClearMessages();
        Navigation.NavigateTo(WizardState.UseExistingGroups ? StepTwoRoute : StepThreeRoute, forceLoad: false);
    }

    private async Task CancelWizard()
    {
        if (HasUnsavedChanges && !await JS.InvokeAsync<bool>("confirm", "Discard this project setup? Your unsaved project details and group selections will be lost."))
        {
            return;
        }

        _allowNavigation = true;
        WizardState.Reset();
        Navigation.NavigateTo(StartPageRoute, forceLoad: false);
    }

    private async Task ConfirmNavigationAsync(LocationChangingContext context)
    {
        var path = new Uri(context.TargetLocation).AbsolutePath.TrimEnd('/');
        var isWizardStep = path == WizardBaseRoute ||
            (path.StartsWith(WizardBaseRoute + "/", StringComparison.Ordinal) &&
             int.TryParse(path[(WizardBaseRoute.Length + 1)..], out var step) && step >= MinStep && step <= MaxStep);
        if (!HasUnsavedChanges || isWizardStep)
        {
            return;
        }

        if (!await JS.InvokeAsync<bool>("confirm", "Leave project setup? Your unsaved details and group selections will be lost."))
        {
            context.PreventNavigation();
            return;
        }

        _allowNavigation = true;
        WizardState.Reset();
    }

    private void SetGroupMode(bool useExistingGroups)
    {
        ClearMessages();
        WizardState.UseExistingGroups = useExistingGroups;
    }

    private void ToggleExistingGroup(Guid groupId, ChangeEventArgs args)
    {
        if (ParseCheckboxValue(args))
        {
            WizardState.SelectedExistingGroupIds.Add(groupId);
            return;
        }

        WizardState.SelectedExistingGroupIds.Remove(groupId);
    }

    private async Task AddNewGroupAsync()
    {
        ClearMessages();
        await SyncEditorValuesAsync();
        var name = (_newGroupDraft.Name ?? string.Empty).Trim();
        var description = (_newGroupDraft.Description ?? string.Empty).Trim();

        if (string.IsNullOrWhiteSpace(name))
        {
            _error = "Group name is required.";
            return;
        }

        if (_existingGroups.Any(group => string.Equals(group.Name, name, StringComparison.OrdinalIgnoreCase))
            || WizardState.NewGroups.Any(group => string.Equals(group.Name, name, StringComparison.OrdinalIgnoreCase)))
        {
            _error = $"Group '{name}' already exists.";
            return;
        }

        WizardState.NewGroups.Add(new WizardGroupDraft
        {
            Name = name,
            Description = description
        });

        _newGroupDraft = new();
    }

    private void RemoveNewGroup(Guid draftId)
    {
        ClearMessages();
        WizardState.NewGroups.RemoveAll(group => group.DraftId == draftId);
    }

    private void ToggleGroupMember(WizardGroupDraft group, Guid userId, ChangeEventArgs args)
    {
        if (ParseCheckboxValue(args))
        {
            group.MemberUserIds.Add(userId);
            return;
        }

        group.MemberUserIds.Remove(userId);
    }

    private Task CreateProjectAsync()
    {
        if (_isSubmitting || CurrentStep != 4 || _createdProject is not null)
        {
            return Task.CompletedTask;
        }

        ClearMessages();
        _isSubmitting = true;
        Logger.LogInformation("Admin project wizard submit: CreateProject");

        try
        {
            var project = JournalApp.CreateProject(new CreateProjectRequest
            {
                Code = WizardState.ProjectDraft.Code,
                Name = WizardState.ProjectDraft.Name,
                Description = WizardState.ProjectDraft.Description,
                ProjectEmail = WizardState.ProjectDraft.ProjectEmail,
                ProjectPhone = WizardState.ProjectDraft.ProjectPhone,
                ProjectOwner = WizardState.ProjectDraft.ProjectOwner,
                Department = WizardState.ProjectDraft.Department
            });
            _createdProject = project;

            if (WizardState.UseExistingGroups)
            {
                foreach (var groupId in WizardState.SelectedExistingGroupIds)
                {
                    JournalApp.AssignGroupToProject(new AssignGroupToProjectRequest
                    {
                        ProjectId = project.ProjectId,
                        GroupId = groupId
                    });
                }
            }
            else
            {
                foreach (var draft in WizardState.NewGroups)
                {
                    var group = JournalApp.CreateGroup(new CreateGroupRequest
                    {
                        Name = draft.Name,
                        Description = draft.Description
                    });

                    JournalApp.AssignGroupToProject(new AssignGroupToProjectRequest
                    {
                        ProjectId = project.ProjectId,
                        GroupId = group.GroupId
                    });

                    foreach (var userId in draft.MemberUserIds)
                    {
                        JournalApp.AssignUserToGroup(new AssignUserToGroupRequest
                        {
                            UserId = userId,
                            GroupId = group.GroupId
                        });
                    }
                }
            }

            _allowNavigation = true;
            WizardState.Reset();
            Navigation.NavigateTo($"/projects?projectId={project.ProjectId:D}", forceLoad: false);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Admin project wizard create failed");
            _error = ex.Message;
            if (_createdProject is not null)
            {
                // Creation is already committed. Never offer a retry that would
                // create a second project after a later group operation fails.
                _allowNavigation = true;
                WizardState.Reset();
            }
        }
        finally
        {
            _isSubmitting = false;
        }

        return Task.CompletedTask;
    }

    private void ClearMessages()
    {
        _message = null;
        _error = null;
    }

    private static bool ParseCheckboxValue(ChangeEventArgs args)
    {
        return args.Value switch
        {
            bool boolValue => boolValue,
            string text when bool.TryParse(text, out var parsed) => parsed,
            _ => false
        };
    }

    private static string RenderValueOrDash(string? value)
        => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private async Task SyncEditorValuesAsync()
    {
        if (_jsReady)
        {
            await JS.InvokeVoidAsync("secureJournalEditors.flush", _editorIds);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (!_jsReady)
        {
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("secureJournalEditors.dispose", _editorIds);
        }
        catch (JSDisconnectedException)
        {
            // The circuit is already gone.
        }
        catch (InvalidOperationException)
        {
            // Teardown during a static render; there is no interop to make.
        }
    }
}
