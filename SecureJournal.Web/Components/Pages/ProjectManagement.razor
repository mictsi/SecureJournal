@page "/admin/projects"
@attribute [Authorize(Roles = "Administrator")]
@inject ISecureJournalAppService JournalApp
@inject NavigationManager Navigation
@inject ILogger<ProjectManagement> Logger
@inject IJSRuntime JS

<PageTitle>Project Management</PageTitle>

<PageHeader Title="Project management"
            Description="Find a project, then manage its details, access, or availability.">
    <Actions>
        <NavLink class="sk-button sk-button--primary" href="/admin/projects/create">
            <svg class="sk-button__icon" aria-hidden="true" focusable="false" width="16" height="16"><use href="#sk-icon-plus" /></svg>
            Create project
        </NavLink>
    </Actions>
</PageHeader>

<PageAlerts Message="@_message" Error="@_error" />
<NavigationLock ConfirmExternalNavigation="@HasUnsavedChanges" OnBeforeInternalNavigation="ConfirmLeaveAsync" />

@if (_currentUser is null){<p role="status">Loading project management…</p>}
else if (_currentUser.Role != AppRole.Administrator){<p role="alert">Administrator access is required.</p>}
else if (!HasRequestedRecord)
{
<section class="sj-directory management-directory" aria-label="Find projects">
    <form class="panel-card management-search" role="search" @onsubmit="SearchDirectory" @onsubmit:preventDefault>
        <div class="sk-field-row sj-directory-toolbar">
            <div class="sk-field management-search-field">
                <label class="sk-field__label" for="projectSearch">Search projects</label>
                <div class="sk-field__control"><input id="projectSearch" class="sk-input" type="search" @bind="_searchDraft" @bind:event="oninput" placeholder="Project name, code, or owner" /></div>
            </div>
            <div class="sk-field-row__actions"><div class="sk-field-row__action-group">
                <button type="submit" class="sk-button sk-button--primary">Search</button>
                <button type="button" class="sk-button sk-button--secondary" @onclick="ShowAllDirectory">Show all projects</button>
            </div></div>
        </div>
    </form>
    @if (!_showResults)
    {
        <div class="management-start">
            <h2>Find a project to get started</h2>
            <p>Search for a specific project, or choose <strong>Show all projects</strong> to browse. Open a result to manage its details.</p>
        </div>
    }
    else
    {
        <div class="management-results-toolbar">
            <p role="status" aria-live="polite">@_projectPage.TotalCount @(_projectPage.TotalCount == 1 ? "project" : "projects") found</p>
            <div class="management-sort">
                <label for="projectSort">Sort by</label>
                <div class="sk-select-wrapper"><select id="projectSort" class="sk-select" @onchange="OnDirectorySortChanged"><option value="name" selected="@(_projectQuery.SortField == "name")">Name</option>
<option value="code" selected="@(_projectQuery.SortField == "code")">Code</option>
<option value="projectOwner" selected="@(_projectQuery.SortField == "projectOwner")">Owner</option></select></div>
                <button type="button" class="sk-button sk-button--secondary" @onclick="ToggleDirectorySortDirection" aria-label="@(_projectQuery.SortDirection == SortDirection.Asc ? "Sort descending" : "Sort ascending")">@(_projectQuery.SortDirection == SortDirection.Asc ? "A–Z" : "Z–A")</button>
            </div>
        </div>
        @if (!string.IsNullOrWhiteSpace(_projectQuery.FilterText))
        {
            <div class="management-active-filter"><span>Search: <strong>@_projectQuery.FilterText</strong></span><button type="button" class="sk-button sk-button--ghost" @onclick="ShowAllDirectory" aria-label="Clear search filter">Clear search</button></div>
        }
        @if (_projectPage.TotalCount == 0)
        {
            <section class="panel-card management-empty"><h2>No projects found</h2><p>@(string.IsNullOrWhiteSpace(_projectQuery.FilterText) ? "Create a project to start building your directory." : $"Nothing matched ‘{_projectQuery.FilterText}’. Try another search or clear the filter.")</p></section>
        }
        else
        {
            <div class="sj-directory-results" aria-label="Projects results">
                @foreach (var project in _projectPage.Items)
                {
                    <a class="sj-result-card project-directory-item" href="@DirectoryUrl(project.ProjectId)">
                        <span class="management-result-copy"><span class="management-result-kicker">@project.Code</span><strong>@project.Name</strong><span>Owner: @RenderValueOrDash(project.ProjectOwner)</span></span><span class="management-result-meta"><span>@project.AssignedGroups.Count @(project.AssignedGroups.Count == 1 ? "group" : "groups")</span><span class="sk-badge @(project.IsDisabled ? "sk-badge--warning" : "sk-badge--success")">@(project.IsDisabled ? "Disabled" : "Enabled")</span></span>
                        <span class="management-open">Open project<span aria-hidden="true"> →</span></span>
                    </a>
                }
            </div>
            <nav class="management-pagination" aria-label="Projects pages">
                <p>Page @_projectPage.Page of @_projectPage.TotalPages · @VisibleProjectRangeLabel()</p>
                <div class="management-pagination-actions">
                    <div class="management-page-size"><label for="projectPageSize">Per page</label><div class="sk-select-wrapper"><select id="projectPageSize" class="sk-select" @onchange="OnDirectoryPageSizeChanged">@foreach (var size in _pageSizeOptions){<option value="@size" selected="@(size == _projectQuery.PageSize)">@size</option>}</select></div></div>
                    <button type="button" class="sk-button sk-button--secondary" @onclick="PreviousDirectoryPage" disabled="@(_projectPage.Page <= 1)">Previous</button>
                    <button type="button" class="sk-button sk-button--secondary" @onclick="NextDirectoryPage" disabled="@(_projectPage.Page >= _projectPage.TotalPages)">Next</button>
                </div>
            </nav>
        }
    }
</section>
}
else
{
 <div class="sj-workspace project-workspace">
  <nav class="sj-workspace-nav" aria-label="Project navigation"><a class="sk-link sj-workspace-back" href="@DirectoryUrl()">← Back to project results</a></nav>
  @if (SelectedProject is null){<section class="panel-card management-empty"><h2>Project unavailable</h2><p>This project may have been removed or moved to trash. Return to your results to choose another project.</p></section>}
  else
  {
   <section class="panel-card sj-workspace-header management-identity"><div><p class="management-result-kicker">@SelectedProject.Code</p><h2>@SelectedProject.Name</h2><p>Owner: @RenderValueOrDash(SelectedProject.ProjectOwner) · @SelectedProject.AssignedGroups.Count @(SelectedProject.AssignedGroups.Count == 1 ? "group" : "groups")</p></div><div class="management-identity-actions"><span class="sk-badge @(SelectedProject.IsDisabled ? "sk-badge--warning" : "sk-badge--success")">@(SelectedProject.IsDisabled ? "Disabled" : "Enabled")</span><a class="sk-button sk-button--secondary" href="@($"/projects?projectId={SelectedProject.ProjectId:D}")">Open journal</a></div></section>
   <nav class="management-sections" aria-label="Project settings">
    <button type="button" class="sk-button @(_activeSection == "details" ? "sk-button--primary" : "sk-button--secondary")" @onclick='() => _activeSection = "details"' aria-pressed="@(_activeSection == "details")">Details @if (MetadataDirty){<span aria-label="Unsaved details">•</span>}</button>
    <button type="button" class="sk-button @(_activeSection == "access" ? "sk-button--primary" : "sk-button--secondary")" @onclick='() => _activeSection = "access"' aria-pressed="@(_activeSection == "access")">Group access @if (_isDirty){<span aria-label="Unsaved access">•</span>}</button>
    <button type="button" class="sk-button @(_activeSection == "availability" ? "sk-button--primary" : "sk-button--secondary")" @onclick='() => _activeSection = "availability"' aria-pressed="@(_activeSection == "availability")">Availability</button>
   </nav>
   @if (_activeSection == "details")
   {
<section class="panel-card project-metadata-card">
                    <div class="panel-card-header project-section-header">
                        <div>
                            <p class="project-section-kicker">Project information</p>
                            <h3>Project details</h3>
                            <p class="project-section-copy">Update descriptive metadata and owner information for this project.</p>
                        </div>
                        @if (!IsEditingSelectedProject)
                        {
                            <div class="panel-card-header-actions">
                                <button type="button" class="sk-button sk-button--secondary" @onclick="() => StartEditProject(SelectedProject.ProjectId)">
                                    Edit details
                                </button>
                            </div>
                        }
                    </div>

                    @if (IsEditingSelectedProject)
                    {
                        <EditForm Model="_projectEditDraft" OnValidSubmit="SaveProjectMetadataAsync">
                            <DataAnnotationsValidator />
                            <ValidationSummary />

                            <div class="project-metadata-grid">
                                <div class="project-metadata-main">
                                    <label class="sk-field__label" for="projectEditName">Name</label>
                                    <InputText id="projectEditName" class="sk-input" maxlength="100" @bind-Value="_projectEditDraft.Name" @oninput="args => _projectEditDraft.Name = args.Value?.ToString() ?? string.Empty" />
                                </div>

                                <div class="project-metadata-main">
                                    <label class="sk-field__label" for="projectEditDescription">Description</label>
                                    <InputTextArea id="projectEditDescription" class="sk-input" rows="3" maxlength="500" @bind-Value="_projectEditDraft.Description" @oninput="args => _projectEditDraft.Description = args.Value?.ToString() ?? string.Empty" />
                                </div>

                                <div class="sk-field">
                                    <label class="sk-field__label" for="projectEditOwner">Project Owner</label>
                                    <InputText id="projectEditOwner" class="sk-input" maxlength="100" @bind-Value="_projectEditDraft.ProjectOwner" @oninput="args => _projectEditDraft.ProjectOwner = args.Value?.ToString() ?? string.Empty" />
                                </div>
                                <div class="sk-field">
                                    <label class="sk-field__label" for="projectEditDepartment">Department</label>
                                    <InputText id="projectEditDepartment" class="sk-input" maxlength="100" @bind-Value="_projectEditDraft.Department" @oninput="args => _projectEditDraft.Department = args.Value?.ToString() ?? string.Empty" />
                                </div>
                                <div class="sk-field">
                                    <label class="sk-field__label" for="projectEditEmail">Project owner email</label>
                                    <InputText id="projectEditEmail" class="sk-input" maxlength="254" @bind-Value="_projectEditDraft.ProjectEmail" @oninput="args => _projectEditDraft.ProjectEmail = args.Value?.ToString() ?? string.Empty" />
                                </div>
                                <div class="sk-field">
                                    <label class="sk-field__label" for="projectEditPhone">Project owner phone</label>
                                    <InputText id="projectEditPhone" class="sk-input" maxlength="32" @bind-Value="_projectEditDraft.ProjectPhone" @oninput="args => _projectEditDraft.ProjectPhone = args.Value?.ToString() ?? string.Empty" />
                                </div>
                            </div>

                            <div class="project-section-actions">
                                <button type="submit" class="sk-button sk-button--primary" disabled="@_isSavingMetadata">
                                    @(_isSavingMetadata ? "Saving..." : "Save details")
                                </button>
                                <button type="button" class="sk-button sk-button--secondary" @onclick="CancelProjectEditAsync" disabled="@_isSavingMetadata">Cancel</button>
                            </div>
                        </EditForm>
                    }
                    else
                    {
                        <div class="project-metadata-grid project-metadata-readonly">
                            <div class="project-metadata-main">
                                <span class="project-field-label">Name</span>
                                <span class="project-field-value">@SelectedProject.Name</span>
                            </div>
                            <div class="project-metadata-main">
                                <span class="project-field-label">Description</span>
                                <div class="rich-content project-field-value">@SimpleMarkupPreview.Render(ProjectDescriptionOrFallback(SelectedProject))</div>
                            </div>
                            <div>
                                <span class="project-field-label">Project Owner</span>
                                <span class="project-field-value">@RenderValueOrDash(SelectedProject.ProjectOwner)</span>
                            </div>
                            <div>
                                <span class="project-field-label">Department</span>
                                <span class="project-field-value">@RenderValueOrDash(SelectedProject.Department)</span>
                            </div>
                            <div>
                                <span class="project-field-label">Project owner email</span>
                                <span class="project-field-value">@RenderValueOrDash(SelectedProject.ProjectEmail)</span>
                            </div>
                            <div>
                                <span class="project-field-label">Project owner phone</span>
                                <span class="project-field-value">@RenderValueOrDash(SelectedProject.ProjectPhone)</span>
                            </div>
                        </div>
                    }
                </section>
   }
   else if (_activeSection == "access")
   {
<section class="panel-card management-membership">
 <div class="management-panel-heading"><div><h2>Group access</h2><p>@SelectedProject.AssignedGroups.Count @(SelectedProject.AssignedGroups.Count == 1 ? "group" : "groups") currently assigned</p></div><button type="button" class="sk-button sk-button--secondary" @onclick="ToggleGroupAccessBrowser" aria-expanded="@_showGroupAccessBrowser" aria-controls="projectGroupBrowser">@(_showGroupAccessBrowser ? "Close access editor" : "Edit group access")</button></div>
 <div class="management-pills">@if (SelectedProject.AssignedGroups.Count == 0){<span class="sj-muted">None assigned yet.</span>}else{@foreach(var name in SelectedProject.AssignedGroups){<span class="sk-badge sk-badge--neutral">@name</span>}}</div>
 @if (_showGroupAccessBrowser)
 {
  <div id="projectGroupBrowser" class="management-membership-browser">
   <form class="sk-field-row management-filter-row" role="search" @onsubmit="ApplyMembershipFilterAsync" @onsubmit:preventDefault><div class="sk-field"><label class="sk-field__label" for="projectGroupSearch">Filter groups</label><div class="sk-field__control"><input id="projectGroupSearch" class="sk-input" @bind="_membershipSearchDraft" @bind:event="oninput" placeholder="Filter by name" /></div></div><div class="sk-field"><label class="sk-field__label" for="projectGroupPageSize">Per page</label><div class="sk-field__control sk-select-wrapper"><select id="projectGroupPageSize" class="sk-select" @onchange="OnGroupPageSizeChanged">@foreach(var option in _pageSizeOptions){<option value="@option" selected="@(option == _groupAccessQuery.PageSize)">@option</option>}</select></div></div><div class="sk-field-row__actions"><div class="sk-field-row__action-group"><button type="submit" class="sk-button sk-button--secondary">Apply filter</button><button type="button" class="sk-button sk-button--ghost" @onclick="ClearMembershipFilterAsync">Clear filter</button></div></div></form>
   <p role="status" aria-live="polite">@_groupAccessPage.TotalCount available @(_groupAccessPage.TotalCount == 1 ? "choice" : "choices"). Select changes, then save.</p>
   @if (_groupAccessPage.TotalCount == 0){<p>No matches. Try another name or remove the filter.</p>}
   <div class="management-membership-list">@foreach(var group in _groupAccessPage.Items){<label class="management-membership-choice"><input type="checkbox" aria-label="@($"Give {group.Name} access to {SelectedProject.Name}")" checked="@IsGroupAssigned(group)" @onchange="args => ToggleGroupLocal(group, args)" disabled="@_isSaving" /><span><strong>@group.Name</strong><span>@PlainDescription(group.Description)</span></span><span class="management-choice-state">@(IsGroupAssigned(group) ? "Assigned" : "Not assigned")</span></label>}</div>
   <nav class="management-pagination" aria-label="Group access pages"><span>Page @_groupAccessPage.Page of @_groupAccessPage.TotalPages</span><div class="management-pagination-actions"><button type="button" class="sk-button sk-button--secondary" @onclick="GoToPreviousGroupPageAsync" disabled="@(_groupAccessPage.Page <= 1)">Previous</button><button type="button" class="sk-button sk-button--secondary" @onclick="GoToNextGroupPageAsync" disabled="@(_groupAccessPage.Page >= _groupAccessPage.TotalPages)">Next</button></div></nav>
  </div>
 }
 @if (_showGroupAccessBrowser || _isDirty){<div class="management-savebar"><span role="status">@(_isDirty ? "Unsaved access changes" : "No pending changes")</span><div class="sk-cluster"><button type="button" class="sk-button sk-button--secondary" @onclick="ResetProjectGroupEdits" disabled="@(!_isDirty || _isSaving)">Discard changes</button><button type="button" class="sk-button sk-button--primary" @onclick="SaveProjectGroupsAsync" disabled="@(!_isDirty || _isSaving)">@(_isSaving ? "Saving…" : "Save group access")</button></div></div>}
</section>
   }
   else
   {
<section class="panel-card project-danger-card">
                    <div class="panel-card-header project-section-header">
                        <div>
                            <p class="project-section-kicker project-danger-kicker">Danger Zone</p>
                            <h3>Status and deletion</h3>
                            <p class="project-section-copy">Disable access or move this project to trash.</p>
                        </div>
                    </div>

                    <div class="project-danger-actions">
                        <div class="project-danger-copy">
                            <strong>@(SelectedProject.IsDisabled ? "Project access is disabled" : "Manage project availability")</strong>
                            <span>Disabling blocks project users. Trash hides the project; restore it before its scheduled deletion date.</span>
                        </div>
                        <div class="sk-cluster">
                            <button type="button"
                                    class="sk-button @(SelectedProject.IsDisabled ? "sk-button--success" : "sk-button--secondary")"
                                    disabled="@_isUpdatingStatus"
                                    @onclick="() => ToggleProjectEnabledAsync(SelectedProject)">
                                @(SelectedProject.IsDisabled ? "Enable Project" : "Disable Project")
                            </button>
                            <button type="button"
                                    class="sk-button sk-button--danger"
                                    disabled="@_isUpdatingStatus"
                                    @onclick="() => MoveProjectToTrashAsync(SelectedProject)">
                                Move to trash
                            </button>
                        </div>
                    </div>
                </section>
   }
  }
 </div>
}

@code {
    [SupplyParameterFromQuery(Name = "projectId")] public string? RequestedId { get; set; }
    [SupplyParameterFromQuery(Name = "q")] public string? SearchQuery { get; set; }
    [SupplyParameterFromQuery(Name = "all")] public string? BrowseAllQuery { get; set; }
    [SupplyParameterFromQuery(Name = "page")] public string? RequestedPageQuery { get; set; }
    [SupplyParameterFromQuery(Name = "size")] public string? RequestedPageSizeQuery { get; set; }
    [SupplyParameterFromQuery(Name = "sort")] public string? RequestedSort { get; set; }
    [SupplyParameterFromQuery(Name = "desc")] public string? SortDescendingQuery { get; set; }
    private bool BrowseAll => bool.TryParse(BrowseAllQuery, out var value) && value;
    private bool SortDescending => bool.TryParse(SortDescendingQuery, out var value) && value;
    private int? RequestedPage => int.TryParse(RequestedPageQuery, out var value) ? value : null;
    private int? RequestedPageSize => int.TryParse(RequestedPageSizeQuery, out var value) ? value : null;
    private string _searchDraft = string.Empty;
    private string _membershipSearchDraft = string.Empty;
    private bool _showResults;
    private bool _allowNavigation;
    private string? _appliedRoute;
    private string _activeSection = "details";
    private bool HasRequestedRecord => !string.IsNullOrWhiteSpace(RequestedId);

    private readonly int[] _pageSizeOptions = [10, 20, 50];
    private readonly UpdateProjectRequest _projectEditDraft = new();
    private UserContext? _currentUser;
    private PagedResult<ProjectOverview> _projectPage = new(Array.Empty<ProjectOverview>(), 0, 1, 10, 1);
    private PagedResult<GroupAccessRow> _groupAccessPage = new(Array.Empty<GroupAccessRow>(), 0, 1, 10, 1);
    private ProjectListQuery _projectQuery = new() { PageSize = 10, SortField = "code", IncludeDescriptionInFilter = false };
    private ProjectGroupAccessQuery _groupAccessQuery = new() { PageSize = 10, SortField = "name" };
    private Guid? _selectedProjectId;
    private ProjectOverview? _selectedProject;
    private Guid? _editingProjectId;
    private readonly Dictionary<Guid, bool> _pendingGroupAssignments = [];
    private bool _showGroupAccessBrowser;
    private bool _isSaving;
    private bool _isSavingMetadata;
    private bool _isUpdatingStatus;
    private string? _message;
    private string? _error;

    private bool _isDirty => _pendingGroupAssignments.Count > 0;
    private bool MetadataDirty => EditingProject is { } project &&
        (_projectEditDraft.Name != project.Name || _projectEditDraft.Description != project.Description ||
         _projectEditDraft.ProjectOwner != project.ProjectOwner || _projectEditDraft.Department != project.Department ||
         _projectEditDraft.ProjectEmail != project.ProjectEmail || _projectEditDraft.ProjectPhone != project.ProjectPhone);
    private bool HasUnsavedChanges => _isDirty || MetadataDirty;
    private bool IsEditingSelectedProject => EditingProject?.ProjectId == SelectedProject?.ProjectId;

    private ProjectOverview? SelectedProject => _selectedProject;

    private ProjectOverview? EditingProject
        => _editingProjectId is { } id
            ? (_selectedProject?.ProjectId == id ? _selectedProject : _projectPage.Items.FirstOrDefault(p => p.ProjectId == id))
            : null;

    protected override async Task OnInitializedAsync()
    {
        if (!await JournalApp.HasCurrentUserAsync())
        {
            Navigation.NavigateTo("/", forceLoad: false);
            return;
        }

        _currentUser = await JournalApp.GetCurrentUserAsync();

    }

    private Task LoadProjectsAsync()
    {
        _projectPage = _showResults ? JournalApp.GetProjects(_projectQuery) : new PagedResult<ProjectOverview>(Array.Empty<ProjectOverview>(), 0, 1, _projectQuery.PageSize, 1);
        _projectQuery.Page = _projectPage.Page;
        if (_selectedProjectId is { } id) _selectedProject = _projectPage.Items.FirstOrDefault(project => project.ProjectId == id) ?? _selectedProject;
        return LoadGroupAccessAsync();
    }

    private Task LoadGroupAccessAsync()
    {
        if (!_selectedProjectId.HasValue)
        {
            _groupAccessPage = new PagedResult<GroupAccessRow>(Array.Empty<GroupAccessRow>(), 0, 1, _groupAccessQuery.PageSize, 1);
            return Task.CompletedTask;
        }

        _groupAccessQuery.ProjectId = _selectedProjectId.Value;
        _groupAccessPage = JournalApp.GetProjectGroupAccess(_groupAccessQuery);
        return Task.CompletedTask;
    }

    private void StartEditProject(Guid projectId)
    {
        var project = SelectedProject?.ProjectId == projectId ? SelectedProject : _projectPage.Items.FirstOrDefault(x => x.ProjectId == projectId);
        if (project is null)
        {
            return;
        }

        _editingProjectId = project.ProjectId;
        _projectEditDraft.ProjectId = project.ProjectId;
        _projectEditDraft.Name = project.Name;
        _projectEditDraft.Description = project.Description;
        _projectEditDraft.ProjectOwner = project.ProjectOwner;
        _projectEditDraft.Department = project.Department;
        _projectEditDraft.ProjectEmail = project.ProjectEmail;
        _projectEditDraft.ProjectPhone = project.ProjectPhone;
        ClearMessages();
    }

    private async Task SaveProjectMetadataAsync()
    {
        if (_projectEditDraft.ProjectId == Guid.Empty)
        {
            _error = "Select a project to edit first.";
            return;
        }

        ClearMessages();
        _isSavingMetadata = true;

        try
        {
            var updated = JournalApp.UpdateProject(_projectEditDraft);
            _selectedProject = updated;
            await LoadProjectsAsync();
            StartEditProject(updated.ProjectId);
            _message = $"Project '{updated.Code}' details saved.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Admin project metadata update failed");
            _error = ex.Message;
        }
        finally
        {
            _isSavingMetadata = false;
        }
    }

    private async Task ToggleProjectEnabledAsync(ProjectOverview project)
    {
        if (_isUpdatingStatus) return;
        ClearMessages();
        _isUpdatingStatus = true;

        try
        {
            if (!project.IsDisabled && !await JS.InvokeAsync<bool>("confirm", $"Disable project '{project.Code} — {project.Name}'? Project users will lose access until an administrator enables it again."))
            {
                return;
            }

            var changed = project.IsDisabled
                ? JournalApp.EnableProject(project.ProjectId)
                : JournalApp.DisableProject(project.ProjectId);

            _selectedProject = JournalApp.GetProjects().FirstOrDefault(item => item.ProjectId == _selectedProjectId);

            _message = changed
                ? $"Project '{project.Code}' {(project.IsDisabled ? "enabled" : "disabled")}."
                : $"Project '{project.Code}' is already {(project.IsDisabled ? "enabled" : "disabled")}.";

            await LoadProjectsAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Project enable/disable update failed");
            _error = ex.Message;
        }
        finally
        {
            _isUpdatingStatus = false;
        }
    }

    private async Task MoveProjectToTrashAsync(ProjectOverview project)
    {
        if (_isUpdatingStatus) return;
        ClearMessages();
        _isUpdatingStatus = true;

        try
        {
            if (!await JS.InvokeAsync<bool>("confirm", $"Move project '{project.Code} — {project.Name}' to trash? It will be hidden from project users and scheduled for deletion. An administrator can restore it from Project trash before the scheduled deletion date."))
            {
                return;
            }

            var deleted = JournalApp.DeleteProject(project.ProjectId);
            _message = deleted
                ? $"Project '{project.Code}' moved to trash."
                : $"Project '{project.Code}' is already in trash.";
            _selectedProject = null;
            _selectedProjectId = null;
            _pendingGroupAssignments.Clear();
            CancelProjectEdit();
            await LoadProjectsAsync();
            _allowNavigation = true;
            Navigation.NavigateTo(DirectoryUrl(), replace: true);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Project delete failed");
            _error = ex.Message;
        }
        finally
        {
            _isUpdatingStatus = false;
        }
    }

    private async Task SaveProjectGroupsAsync()
    {
        var selectedProject = SelectedProject;
        if (selectedProject is null)
        {
            _error = "Select a project first.";
            return;
        }

        if (!_isDirty)
        {
            _message = "No group access changes to save.";
            _error = null;
            return;
        }

        ClearMessages();
        _isSaving = true;

        try
        {
            foreach (var (groupId, shouldBeAssigned) in _pendingGroupAssignments)
            {
                if (shouldBeAssigned)
                {
                    JournalApp.AssignGroupToProject(new AssignGroupToProjectRequest
                    {
                        ProjectId = selectedProject.ProjectId,
                        GroupId = groupId
                    });
                }
                else
                {
                    JournalApp.RemoveGroupFromProject(new AssignGroupToProjectRequest
                    {
                        ProjectId = selectedProject.ProjectId,
                        GroupId = groupId
                    });
                }
            }

            Logger.LogInformation("Saved project-group memberships for {ProjectCode}", selectedProject.Code);
            _pendingGroupAssignments.Clear();
            _selectedProject = JournalApp.GetProjects().FirstOrDefault(project => project.ProjectId == _selectedProjectId);
            _message = $"Group access changes saved for project '{selectedProject.Code}'.";
            await LoadProjectsAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Project group membership save failed");
            _error = ex.Message;
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task<bool> ConfirmDiscardAsync()
        => !HasUnsavedChanges || await JS.InvokeAsync<bool>("confirm",
            $"Discard unsaved changes for '{SelectedProject?.Name}'? Project details and group access changes have not been saved.");

    private async Task ConfirmLeaveAsync(LocationChangingContext context)
    {
        if (_allowNavigation) return;
        if (_isSaving || _isSavingMetadata || _isUpdatingStatus || !await ConfirmDiscardAsync())
        {
            context.PreventNavigation();
        }
    }

    private async Task CancelProjectEditAsync()
    {
        if (!MetadataDirty || await JS.InvokeAsync<bool>("confirm", $"Discard unsaved project details for '{SelectedProject?.Name}'?"))
        {
            CancelProjectEdit();
        }
    }

    private void ToggleGroupAccessBrowser()
    {
        _showGroupAccessBrowser = !_showGroupAccessBrowser;
    }

    private void ToggleGroupLocal(GroupAccessRow group, ChangeEventArgs args)
    {
        var isChecked = ParseCheckboxValue(args);
        if (isChecked == group.IsAssigned)
        {
            _pendingGroupAssignments.Remove(group.GroupId);
            return;
        }

        _pendingGroupAssignments[group.GroupId] = isChecked;
    }

    private bool IsGroupAssigned(GroupAccessRow row)
        => _pendingGroupAssignments.TryGetValue(row.GroupId, out var value) ? value : row.IsAssigned;

    private Task ResetProjectGroupEdits()
    {
        _pendingGroupAssignments.Clear();
        return LoadGroupAccessAsync();
    }

    private async Task OnGroupSearchChanged(ChangeEventArgs args)
    {
        _groupAccessQuery.FilterText = args.Value?.ToString() ?? string.Empty;
        _groupAccessQuery.Page = 1;
        await LoadGroupAccessAsync();
    }

    private async Task OnGroupPageSizeChanged(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var pageSize) && _pageSizeOptions.Contains(pageSize))
        {
            _groupAccessQuery.PageSize = pageSize;
            _groupAccessQuery.Page = 1;
            await LoadGroupAccessAsync();
        }
    }

    private async Task GoToPreviousGroupPageAsync()
    {
        if (_groupAccessQuery.Page > 1)
        {
            _groupAccessQuery.Page--;
            await LoadGroupAccessAsync();
        }
    }

    private async Task GoToNextGroupPageAsync()
    {
        if (_groupAccessQuery.Page < _groupAccessPage.TotalPages)
        {
            _groupAccessQuery.Page++;
            await LoadGroupAccessAsync();
        }
    }

    private static string RenderValueOrDash(string? value)
        => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private static bool ParseCheckboxValue(ChangeEventArgs args)
    {
        if (args.Value is bool boolValue)
        {
            return boolValue;
        }

        return bool.TryParse(args.Value?.ToString(), out var parsed) && parsed;
    }

    private static string ProjectDescriptionOrFallback(ProjectOverview project)
        => string.IsNullOrWhiteSpace(project.Description) ? "No description provided." : project.Description;

    private string VisibleProjectRangeLabel()
    {
        if (_projectPage.TotalCount == 0)
        {
            return "Showing 0 projects";
        }

        var start = ((_projectPage.Page - 1) * _projectPage.PageSize) + 1;
        var end = Math.Min(_projectPage.Page * _projectPage.PageSize, _projectPage.TotalCount);
        return $"Showing {start}-{end} of {_projectPage.TotalCount} projects";
    }

    private void ClearMessages()
    {
        _message = null;
        _error = null;
    }

    private void CancelProjectEdit()
    {
        _editingProjectId = null;
        _projectEditDraft.ProjectId = Guid.Empty;
        _projectEditDraft.Name = string.Empty;
        _projectEditDraft.Description = string.Empty;
        _projectEditDraft.ProjectEmail = string.Empty;
        _projectEditDraft.ProjectPhone = string.Empty;
        _projectEditDraft.ProjectOwner = string.Empty;
        _projectEditDraft.Department = string.Empty;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_currentUser?.Role != AppRole.Administrator || _appliedRoute == Navigation.Uri) return;
        _appliedRoute = Navigation.Uri;
        _allowNavigation = false;
        _showResults = BrowseAll || !string.IsNullOrWhiteSpace(SearchQuery) || HasRequestedRecord;
        _projectQuery.FilterText = SearchQuery?.Trim() ?? string.Empty;
        _searchDraft = _projectQuery.FilterText;
        _projectQuery.Page = Math.Max(1, RequestedPage ?? 1);
        _projectQuery.PageSize = _pageSizeOptions.Contains(RequestedPageSize ?? 10) ? RequestedPageSize ?? 10 : 10;
        _projectQuery.SortField = RequestedSort is "code" or "name" or "projectOwner" ? RequestedSort : "name";
        _projectQuery.SortDirection = SortDescending ? SortDirection.Desc : SortDirection.Asc;
        var nextId = Guid.TryParse(RequestedId, out var id) ? id : (Guid?)null;
        if (nextId != _selectedProjectId || (HasRequestedRecord && _selectedProject is null))
        {
            _selectedProjectId = nextId;
            _selectedProject = nextId is { } recordId ? JournalApp.GetProjects().FirstOrDefault(item => item.ProjectId == recordId) : null;
            _pendingGroupAssignments.Clear();
            _showGroupAccessBrowser = false;
            _groupAccessQuery = new ProjectGroupAccessQuery { PageSize = _groupAccessQuery.PageSize, SortField = "name" };
            _membershipSearchDraft = string.Empty;
            CancelProjectEdit();
            _activeSection = "details";
            await LoadGroupAccessAsync();
        }
        await LoadProjectsAsync();
    }

    private string DirectoryUrl(Guid? recordId = null)
    {
        var parts = new List<string>();
        if (_showResults || recordId.HasValue) parts.Add("all=true");
        if (!string.IsNullOrWhiteSpace(_projectQuery.FilterText)) parts.Add("q=" + Uri.EscapeDataString(_projectQuery.FilterText));
        if (_showResults || recordId.HasValue)
        {
            parts.Add($"page={_projectQuery.Page}&size={_projectQuery.PageSize}&sort={Uri.EscapeDataString(_projectQuery.SortField)}&desc={_projectQuery.SortDirection == SortDirection.Desc}");
        }
        if (recordId.HasValue) parts.Add($"projectId={recordId:D}");
        return "/admin/projects" + (parts.Count == 0 ? string.Empty : "?" + string.Join("&", parts));
    }

    private void SearchDirectory()
    {
        if (string.IsNullOrWhiteSpace(_searchDraft))
        {
            _error = "Enter a search term or choose Show all projects.";
            return;
        }
        ClearMessages();
        _projectQuery.FilterText = _searchDraft.Trim();
        _projectQuery.Page = 1;
        _showResults = true;
        Navigation.NavigateTo(DirectoryUrl());
    }

    private void ShowAllDirectory()
    {
        ClearMessages();
        _searchDraft = _projectQuery.FilterText = string.Empty;
        _projectQuery.Page = 1;
        _showResults = true;
        Navigation.NavigateTo(DirectoryUrl());
    }

    private void OnDirectorySortChanged(ChangeEventArgs args)
    {
        _projectQuery.SortField = args.Value?.ToString() ?? "name";
        _projectQuery.Page = 1;
        Navigation.NavigateTo(DirectoryUrl());
    }

    private void ToggleDirectorySortDirection()
    {
        _projectQuery.SortDirection = _projectQuery.SortDirection == SortDirection.Asc ? SortDirection.Desc : SortDirection.Asc;
        _projectQuery.Page = 1;
        Navigation.NavigateTo(DirectoryUrl());
    }

    private void OnDirectoryPageSizeChanged(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var size) && _pageSizeOptions.Contains(size))
        {
            _projectQuery.PageSize = size;
            _projectQuery.Page = 1;
            Navigation.NavigateTo(DirectoryUrl());
        }
    }

    private void PreviousDirectoryPage()
    {
        if (_projectPage.Page <= 1) return;
        _projectQuery.Page = _projectPage.Page - 1;
        Navigation.NavigateTo(DirectoryUrl());
    }

    private void NextDirectoryPage()
    {
        if (_projectPage.Page >= _projectPage.TotalPages) return;
        _projectQuery.Page = _projectPage.Page + 1;
        Navigation.NavigateTo(DirectoryUrl());
    }


    private Task ApplyMembershipFilterAsync()
        => OnGroupSearchChanged(new ChangeEventArgs { Value = _membershipSearchDraft });

    private Task ClearMembershipFilterAsync()
    {
        _membershipSearchDraft = string.Empty;
        return OnGroupSearchChanged(new ChangeEventArgs { Value = string.Empty });
    }

    private static string PlainDescription(string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return "—";
        var markup = SimpleMarkupPreview.Render(value).Value;
        var text = System.Net.WebUtility.HtmlDecode(System.Text.RegularExpressions.Regex.Replace(markup, "<[^>]+>", " "));
        return System.Text.RegularExpressions.Regex.Replace(text, @"\s+", " ").Trim();
    }
}
