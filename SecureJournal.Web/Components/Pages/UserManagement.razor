    private string VisibleUserRangeLabel()
    {
        if (_userPage.TotalCount == 0)
        {
            return "Showing 0 users";
        }

        var start = ((_userPage.Page - 1) * _userPage.PageSize) + 1;
        var end = Math.Min(_userPage.Page * _userPage.PageSize, _userPage.TotalCount);
        return $"Showing {start}-{end} of {_userPage.TotalCount} users";
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_currentUser?.Role != AppRole.Administrator || _appliedRoute == Navigation.Uri) return;
        _appliedRoute = Navigation.Uri;
        _allowNavigation = false;
        _showResults = BrowseAll || !string.IsNullOrWhiteSpace(SearchQuery) || HasRequestedRecord;
        _userQuery.FilterText = SearchQuery?.Trim() ?? string.Empty;
        _searchDraft = _userQuery.FilterText;
        _userQuery.Page = Math.Max(1, RequestedPage ?? 1);
        _userQuery.PageSize = _pageSizeOptions.Contains(RequestedPageSize ?? 10) ? RequestedPageSize ?? 10 : 10;
        _userQuery.SortField = RequestedSort is "displayName" or "username" ? RequestedSort : "displayName";
        _userQuery.SortDirection = SortDescending ? SortDirection.Desc : SortDirection.Asc;
        var nextId = Guid.TryParse(RequestedId, out var id) ? id : (Guid?)null;
        if (nextId != _selectedUserId || (HasRequestedRecord && _selectedUser is null))
        {
            _selectedUserId = nextId;
            _selectedUser = nextId is { } recordId ? JournalApp.GetUsers().FirstOrDefault(item => item.UserId == recordId) : null;
            InitializeSelectedUserEdits();
            _membershipSearchDraft = string.Empty;
            _activeSection = "access";
            await LoadGroupsAsync();
        }
        await LoadUsersAsync();
    }

    private string DirectoryUrl(Guid? recordId = null)
    {
        var parts = new List<string>();
        if (_showResults || recordId.HasValue) parts.Add("all=true");
        if (!string.IsNullOrWhiteSpace(_userQuery.FilterText)) parts.Add("q=" + Uri.EscapeDataString(_userQuery.FilterText));
        if (_showResults || recordId.HasValue)
        {
            parts.Add($"page={_userQuery.Page}&size={_userQuery.PageSize}&sort={Uri.EscapeDataString(_userQuery.SortField)}&desc={_userQuery.SortDirection == SortDirection.Desc}");
        }
        if (recordId.HasValue) parts.Add($"userId={recordId:D}");
        return "/admin/users" + (parts.Count == 0 ? string.Empty : "?" + string.Join("&", parts));
    }

    private void SearchDirectory()
    {
        if (string.IsNullOrWhiteSpace(_searchDraft))
        {
            _error = "Enter a search term or choose Show all users.";
            return;
        }
        ClearMessages();
        _userQuery.FilterText = _searchDraft.Trim();
        _userQuery.Page = 1;
        _showResults = true;
        Navigation.NavigateTo(DirectoryUrl());
    }

    private void ShowAllDirectory()
    {
        ClearMessages();
        _searchDraft = _userQuery.FilterText = string.Empty;
        _userQuery.Page = 1;
        _showResults = true;
        Navigation.NavigateTo(DirectoryUrl());
    }

    private void OnDirectorySortChanged(ChangeEventArgs args)
    {
        _userQuery.SortField = args.Value?.ToString() ?? "displayName";
        _userQuery.Page = 1;
        Navigation.NavigateTo(DirectoryUrl());
    }

    private void ToggleDirectorySortDirection()
    {
        _userQuery.SortDirection = _userQuery.SortDirection == SortDirection.Asc ? SortDirection.Desc : SortDirection.Asc;
        _userQuery.Page = 1;
        Navigation.NavigateTo(DirectoryUrl());
    }

    private void OnDirectoryPageSizeChanged(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var size) && _pageSizeOptions.Contains(size))
        {
            _userQuery.PageSize = size;
            _userQuery.Page = 1;
            Navigation.NavigateTo(DirectoryUrl());
        }
    }

    private void PreviousDirectoryPage()
    {
        if (_userPage.Page <= 1) return;
        _userQuery.Page = _userPage.Page - 1;
        Navigation.NavigateTo(DirectoryUrl());
    }

    private void NextDirectoryPage()
    {
        if (_userPage.Page >= _userPage.TotalPages) return;
        _userQuery.Page = _userPage.Page + 1;
        Navigation.NavigateTo(DirectoryUrl());
    }


    private Task ApplyMembershipFilterAsync()
        => OnGroupSearchChanged(new ChangeEventArgs { Value = _membershipSearchDraft });

    private Task ClearMembershipFilterAsync()
    {
