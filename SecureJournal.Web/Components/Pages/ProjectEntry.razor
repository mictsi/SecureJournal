@page "/projects/entry/{RecordId:guid}"
@attribute [Authorize]
@inject ISecureJournalAppService JournalApp
@inject NavigationManager Navigation
@using SecureJournal.Web.Components.Journal

<PageTitle>Journal entry · Secure Journal</PageTitle>

<div class="entry-page">
    <a href="@BackUrl" class="sj-workspace-back">← Back to project entries</a>
    <PageHeader Title="@(_entry?.Subject ?? "Journal entry")"
                Description="@(_entry is null ? "A saved record in your project's history." : $"{_entry.ProjectCode} · {_entry.ProjectName}")" />
    <PageAlerts Error="@_error" Message="@(Saved && _entry is not null ? "Entry saved. Your text and files are now part of this project's history." : null)" />

    @if (_loading)
    {
        <p role="status">Loading entry…</p>
    }
    else if (_entry is not null)
    {
        <article class="panel-card entry-detail-card">
            <JournalEntryContent Entry="_entry" ReturnUrl="@BackUrl" HeadingLevel="2" />
        </article>
    }
</div>

@code {
    [Parameter] public Guid RecordId { get; set; }
    [SupplyParameterFromQuery(Name = "projectId")] public string? ProjectIdQuery { get; set; }
    private Guid? ProjectId => Guid.TryParse(ProjectIdQuery, out var id) ? id : null;
    [SupplyParameterFromQuery(Name = "returnUrl")] public string? ReturnUrl { get; set; }
    [SupplyParameterFromQuery(Name = "saved")] public string? SavedQuery { get; set; }
    private bool Saved => bool.TryParse(SavedQuery, out var saved) && saved;

    private JournalEntryView? _entry;
    private string? _error;
    private bool _loading = true;
    private string BackUrl => ProjectReturnUrl.Resolve(ReturnUrl,
        (_entry?.ProjectId ?? ProjectId) is { } id ? $"/projects?projectId={id:D}" : "/projects");

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _error = null;
        _entry = null;
        try
        {
            if (!await JournalApp.HasCurrentUserAsync())
            {
                Navigation.NavigateTo("/", forceLoad: false);
                return;
            }
            var user = await JournalApp.GetCurrentUserAsync();
            if (user.Role == AppRole.Auditor)
            {
                _error = "Auditors cannot view full journal entry details.";
                return;
            }
            _entry = JournalApp.GetJournalEntries(ProjectId, includeSoftDeleted: true).FirstOrDefault(entry => entry.RecordId == RecordId);
            if (_entry is null && ProjectId.HasValue)
                _entry = JournalApp.GetJournalEntries(includeSoftDeleted: true).FirstOrDefault(entry => entry.RecordId == RecordId);
            if (_entry is null) _error = "Journal entry was not found or is not accessible for your account.";
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loading = false; }
    }
}
