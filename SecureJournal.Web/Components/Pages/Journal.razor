@page "/journal"
@attribute [Authorize]
@implements IAsyncDisposable
@inject ISecureJournalAppService JournalApp
@inject NavigationManager Navigation
@inject IJSRuntime JS
@using SecureJournal.Web.Components.Forms
@using Microsoft.AspNetCore.WebUtilities

<PageTitle>New Journal Entry</PageTitle>

<div class="journal-page">
<a href="@BackUrl" class="sj-workspace-back">← Back to project</a>
<PageHeader Title="New journal entry"
            Description="Write what happened and attach the files that support it." />

<NavigationLock ConfirmExternalNavigation="@HasUnsavedChanges" OnBeforeInternalNavigation="ConfirmNavigationAsync" />

<PageAlerts Message="@_message" Error="@_error" />

<section class="panel-card journal-compose-card">
    <div class="panel-card-header">
        <h2>Entry information</h2>
        <span class="sk-badge sk-badge--neutral">Unsaved draft</span>
    </div>

    @if (_projects.Count == 0)
    {
        <div class="sk-empty-state">
            <h3 class="sk-empty-state__heading">A project is needed first</h3>
            <p class="sk-empty-state__body">Ask an administrator for project access, then return to create an entry.</p>
            <a href="/projects" class="sk-button sk-button--secondary">View projects</a>
        </div>
    }
    else if (_currentUser?.Role == AppRole.Auditor)
    {
        <p>Auditors can access audit logs only and cannot create or read journal entries.</p>
    }
    else
    {
        <EditForm Model="DraftModel" OnValidSubmit="CreateEntryAsync" FormName="journal-create-entry">
            <AntiforgeryToken />
            <DataAnnotationsValidator />
            <ValidationSummary />

            <p class="journal-persistence-note" id="journal-save-guidance">Entries cannot be edited after saving. Check the project and content before you save.</p>

            <div class="sk-stack sk-stack--gap-24" aria-busy="@(_isSubmitting ? "true" : "false")">
                <div class="sk-field">
                    <label class="sk-field__label" for="projectSelect">Project</label>
                    <div class="sk-select-wrapper">
                        <InputSelect id="projectSelect" class="sk-select" TValue="Guid" @bind-Value="DraftModel.ProjectId" disabled="@_isSubmitting">
                            <option value="@Guid.Empty">Choose a project</option>
                            @foreach (var project in _projects)
                            {
                                <option value="@project.ProjectId">@project.Code - @project.Name</option>
                            }
                        </InputSelect>
                    </div>
                </div>

                <div class="sk-field">
                    <label class="sk-field__label" for="subjectInput">Subject</label>
                    <p class="sk-field__hint" id="subjectInput-hint">A short, specific title that will be easy to find later.</p>
                    <InputText id="subjectInput" class="sk-input" maxlength="@FieldLimits.SubjectMax" aria-describedby="subjectInput-hint" @bind-Value="DraftModel.Subject" @oninput="OnSubjectInput" disabled="@_isSubmitting" />
                    <ValidationMessage For="@(() => DraftModel.Subject)" />
                </div>

                <div class="sk-field">
                    <label class="sk-field__label" for="descriptionInput">Description</label>
                    <p class="sk-field__hint" id="descriptionInput-hint">What happened, why it matters, and any next steps.</p>
                    <div class="journal-editor-shell">
                        <InputTextArea id="descriptionInput"
                                       class="sk-input journal-rich-editor-source"
                                       maxlength="@FieldLimits.DescriptionMax"
                                       rows="8"
                                       aria-describedby="descriptionInput-hint"
                                       @bind-Value="DraftModel.Description" @oninput="OnDescriptionInput" />
                    </div>
                    <ValidationMessage For="@(() => DraftModel.Description)" />
                </div>

                <div class="sk-field">
                    <label class="sk-field__label" for="notesInput">
                        Notes
                        <span class="sk-field__optional">Optional</span>
                    </label>
                    <p class="sk-field__hint" id="notesInput-hint">Add supporting details or references. Visible to everyone who can read this entry.</p>
                    <div class="journal-editor-shell">
                        <InputTextArea id="notesInput"
                                       class="sk-input"
                                       maxlength="@FieldLimits.NotesMax"
                                       rows="3"
                                       aria-describedby="notesInput-hint"
                                       @bind-Value="DraftModel.Notes" @oninput="OnNotesInput" />
                    </div>
                </div>

                <section class="journal-files" aria-labelledby="journal-files-title">
                    <h3 id="journal-files-title">Files <span class="sk-field__optional">Optional</span></h3>
                    <p class="sk-field__hint">Attach documents, images, or other supporting files. People who can read this entry can download them.</p>
                    <AttachmentPicker @ref="_attachmentPicker" @bind-Files="DraftModel.Attachments"
                                      Disabled="@_isSubmitting" ReadyChanged="OnAttachmentsReady" />
                </section>
            </div>

            <div class="journal-compose-actions sj-form-actions">
                <div class="sk-cluster sk-cluster--gap-8">
                    <button type="submit" class="sk-button sk-button--primary" disabled="@(_isSubmitting || !_attachmentsReady)" aria-describedby="journal-save-guidance">@(_isSubmitting ? "Saving…" : "Save entry")</button>
                    <a href="@BackUrl" class="sk-button sk-button--secondary">Cancel</a>
                </div>
                <button type="button" class="sk-button sk-button--ghost" disabled="@(_isSubmitting || !HasUnsavedChanges)" @onclick="ResetDraftAsync">Clear draft</button>
            </div>
        </EditForm>
    }
</section>
</div>

@code {
    [SupplyParameterFromQuery(Name = "projectId")]
    public string? ProjectIdQuery { get; set; }
    private Guid? ProjectId => Guid.TryParse(ProjectIdQuery, out var id) ? id : null;

    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    [SupplyParameterFromForm(FormName = "journal-create-entry")]
    private CreateJournalEntryRequest? PostedDraftModel { get; set; }
    private CreateJournalEntryRequest DraftModel => PostedDraftModel ??= new();

    private UserContext? _currentUser;
    private List<ProjectOverview> _projects = new();
    private string? _message;
    private string? _error;
    private bool _isSubmitting;
    private bool _isSaved;
    private bool _hasAppliedProjectQuery;
    private Guid? _lastProjectQuery;
    private bool _discardDraftOnNavigation;
    private AttachmentPicker? _attachmentPicker;
    private bool _attachmentsReady = true;
    private bool HasUnsavedChanges => !_isSaved &&
        (!string.IsNullOrWhiteSpace(DraftModel.Subject) ||
         !string.IsNullOrWhiteSpace(DraftModel.Description) ||
         !string.IsNullOrWhiteSpace(DraftModel.Notes) || DraftModel.Attachments.Count > 0 || !_attachmentsReady);
    private string BackUrl => ProjectReturnUrl.Resolve(ReturnUrl, DraftModel.ProjectId != Guid.Empty
        ? $"/projects?projectId={DraftModel.ProjectId:D}"
        : "/projects");
    // JavaScript interop is only legal once the component has rendered
    // interactively. A form POST re-renders the page statically, and the editor
    // calls made during that pass threw "JavaScript interop calls cannot be issued
    // at this time", which surfaced as an unhandled error on every submit.
    private bool _jsReady;

    private readonly string[] _editorIds = ["descriptionInput"];

    private bool CanUseRichEditor
        => _projects.Count > 0 && _currentUser?.Role != AppRole.Auditor;

    protected override async Task OnInitializedAsync()
    {
        if (!await JournalApp.HasCurrentUserAsync())
        {
            Navigation.NavigateTo("/", forceLoad: false);
            return;
        }

        await LoadDataAsync();
    }

    protected override void OnParametersSet()
    {
        if (_currentUser is null || (_hasAppliedProjectQuery && ProjectId == _lastProjectQuery))
        {
            return;
        }

        if (_discardDraftOnNavigation)
        {
            ClearDraft();
            _discardDraftOnNavigation = false;
        }

        // A posted form already contains the user's explicit project choice.
        // A draft is only discarded after NavigationLock receives confirmation.
        if (!HasUnsavedChanges && !_isSubmitting && !_isSaved &&
            (_hasAppliedProjectQuery || DraftModel.ProjectId == Guid.Empty))
        {
            ApplyProjectQuery();
        }

        _lastProjectQuery = ProjectId;
        _hasAppliedProjectQuery = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        _jsReady = true;

        if (!CanUseRichEditor)
        {
            await JS.InvokeVoidAsync("secureJournalEditors.dispose", _editorIds);
            return;
        }

        await JS.InvokeVoidAsync("secureJournalEditors.syncTinyMce", new object[] {
            new
            {
                id = "descriptionInput",
                value = DraftModel.Description ?? string.Empty,
                minHeight = 240
            }
        }, _editorIds);
    }

    private async Task LoadDataAsync()
    {
        _currentUser = await JournalApp.GetCurrentUserAsync();
        _projects = JournalApp.GetProjects().Where(p => p.HasAccessForCurrentUser).ToList();
    }

    private void ApplyProjectQuery()
    {
        DraftModel.ProjectId = Guid.Empty;
        _error = null;
        if (!string.IsNullOrWhiteSpace(ProjectIdQuery) && ProjectId is null)
        {
            _error = "The project link is invalid. Choose a project to continue.";
        }
        else if (ProjectId is { } requestedId)
        {
            if (_projects.Any(project => project.ProjectId == requestedId))
            {
                DraftModel.ProjectId = requestedId;
            }
            else
            {
                _error = "That project is unavailable to your account. Choose an accessible project to continue.";
            }
        }
        else if (_projects.Count == 1)
        {
            DraftModel.ProjectId = _projects[0].ProjectId;
        }
    }

    private void OnSubjectInput(ChangeEventArgs args) => DraftModel.Subject = args.Value?.ToString() ?? string.Empty;
    private void OnDescriptionInput(ChangeEventArgs args) => DraftModel.Description = args.Value?.ToString() ?? string.Empty;
    private void OnNotesInput(ChangeEventArgs args) => DraftModel.Notes = args.Value?.ToString() ?? string.Empty;
    private void OnAttachmentsReady(bool ready) => _attachmentsReady = ready;

    private async Task CreateEntryAsync()
    {
        if (_isSubmitting || _isSaved || !_attachmentsReady)
        {
            return;
        }

        _message = null;
        _error = null;
        if (!_projects.Any(project => project.ProjectId == DraftModel.ProjectId))
        {
            _error = "Choose a project before saving this entry.";
            return;
        }

        _isSubmitting = true;

        try
        {
            if (_jsReady)
            {
                await JS.InvokeVoidAsync("secureJournalEditors.flush", _editorIds);
            }

            var selectedProject = DraftModel.ProjectId;
            var savedEntry = JournalApp.CreateJournalEntry(DraftModel);
            _isSaved = true;
            Navigation.NavigateTo(QueryHelpers.AddQueryString($"/projects/entry/{savedEntry.RecordId:D}", new Dictionary<string, string?>
            {
                ["projectId"] = selectedProject.ToString("D"), ["saved"] = "true", ["returnUrl"] = BackUrl
            }));
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private async Task ResetDraftAsync()
    {
        if (!await JS.InvokeAsync<bool>("confirm", "Clear this draft? The text and selected files will be discarded."))
        {
            return;
        }

        if (_attachmentPicker is not null) await _attachmentPicker.ClearAsync();
        ClearDraft();
    }

    private void ClearDraft()
    {
        DraftModel.Subject = string.Empty;
        DraftModel.Description = string.Empty;
        DraftModel.Notes = string.Empty;
        foreach (var file in DraftModel.Attachments) System.Security.Cryptography.CryptographicOperations.ZeroMemory(file.Content);
        DraftModel.Attachments = Array.Empty<JournalAttachmentUpload>();
        _message = null;
        _error = null;
    }

    private async Task ConfirmNavigationAsync(LocationChangingContext context)
    {
        if (HasUnsavedChanges)
        {
            if (!await JS.InvokeAsync<bool>("confirm", "Leave without saving? Your journal entry draft and selected files will be discarded."))
            {
                context.PreventNavigation();
                return;
            }

            if (_attachmentPicker is not null) await _attachmentPicker.ClearAsync();
            _discardDraftOnNavigation = true;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (!_jsReady)
        {
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("secureJournalEditors.dispose", _editorIds);
        }
        catch (JSDisconnectedException)
        {
            // The circuit is already gone.
        }
        catch (InvalidOperationException)
        {
            // Teardown during a static render; there is no interop to make.
        }
    }
}
