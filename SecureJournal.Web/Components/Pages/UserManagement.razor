    private static string RoleLabel(AppRole role)
        => role == AppRole.ProjectUser ? "Project User" : role.ToString();

    private static string RoleDescription(AppRole role)
        => role switch
        {
            AppRole.Administrator => "Full system access and administrative control.",
            AppRole.ProjectUser => "Create and read journal entries in assigned projects.",
            AppRole.Auditor => "Search audit activity and review linked journal evidence.",
