    private static bool ParseCheckboxValue(ChangeEventArgs args)
    {
        if (args.Value is bool boolValue)
        {
            return boolValue;
        }

        return bool.TryParse(args.Value?.ToString(), out var parsed) && parsed;
    }

    private static string RenderValueOrDash(string? value)
        => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private static IReadOnlyList<AppRole> UserRoles(UserOverview user)
        => user.Roles.Count > 0 ? user.Roles : [user.Role];

    private static string UserInitial(UserOverview user)
    {
        var source = string.IsNullOrWhiteSpace(user.DisplayName) ? user.Username : user.DisplayName;
        return string.IsNullOrWhiteSpace(source) ? "U" : source.Trim()[0].ToString().ToUpperInvariant();
