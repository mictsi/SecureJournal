@page "/exports"
@attribute [Authorize(Roles = "Administrator,Auditor")]
@inject ISecureJournalAppService JournalApp
@inject IJSRuntime JS
@inject NavigationManager Navigation

<PageTitle>Exports</PageTitle>

<PageHeader Title="Exports"
            Description="Choose the records you need, review the scope, then download a copy." />

<PageAlerts Message="@_message" Error="@_error" />

<div class="export-layout">
<section class="panel-card export-main" aria-busy="@(_isGenerating ? "true" : "false")">
        <div class="panel-card-header">
            <div>
                <p class="export-step">@(_isReviewing ? "Step 2 of 2" : "Step 1 of 2")</p>
                <h2>@(_isReviewing ? "Review your export" : "Choose your records")</h2>
            </div>
        </div>

        @if (_currentUser is null)
        {
            <p>Loading user context...</p>
        }
        else
        {
            @if (!CanExportAnything)
            {
                <p>Exports are available to administrators and auditors. Your account cannot export records.</p>
            }
            else if (_isReviewing)
            {
                <dl class="export-summary">
                    <dt>Records</dt><dd>@DatasetLabel</dd>
                    <dt>File format</dt><dd>@_selectedFormat</dd>
                    <dt>Project scope</dt><dd>@ProjectScopeLabel</dd>
                    <dt>From (UTC)</dt><dd>@(_fromDateText ?? "Beginning of records")</dd>
                    <dt>To (UTC)</dt><dd>@(_toDateText ?? "Latest record")</dd>
                    @if (_selectedDataset == ExportDatasetKind.JournalEntries)
                    {
                        <dt>Deleted entries</dt><dd>@(_includeSoftDeleted ? "Included" : "Excluded")</dd>
                    }
                    else
                    {
                        <dt>Username contains</dt><dd>@FilterLabel(_auditActorUsername)</dd>
                        <dt>Outcome</dt><dd>@FilterLabel(_auditOutcomeValue)</dd>
                        <dt>Action</dt><dd>@FilterLabel(_auditActionValue)</dd>
                        <dt>Entity type</dt><dd>@FilterLabel(_auditEntityValue)</dd>
                    }
                </dl>
                <div class="export-notice">
                    <strong>This download contains readable, unencrypted records.</strong>
                    <p>Keep it in an approved location and share it only with people authorized to view these records. Access controls in Secure Journal do not protect downloaded files.</p>
                </div>
                <div class="sk-cluster sj-form-actions">
                    <button type="button" class="sk-button sk-button--primary" disabled="@_isGenerating" @onclick="GenerateExportAsync">@(_isGenerating ? "Preparing download…" : "Download export")</button>
                    <button type="button" class="sk-button sk-button--secondary" disabled="@_isGenerating" @onclick="EditConfiguration">Back to configuration</button>
                </div>
            }
            else
            {
                <div class="export-fields">
                    <div class="sk-field">
                        <label class="sk-field__label" for="datasetKind">Dataset</label>
                        <div class="sk-select-wrapper">
                            <select id="datasetKind" class="sk-select" @bind="_selectedDataset">
                            @if (CanExportJournal)
                            {
                                <option value="@ExportDatasetKind.JournalEntries">Journal Entries</option>
                            }
                            @if (CanExportAudit)
                            {
                                <option value="@ExportDatasetKind.AuditLogs">Audit Logs</option>
                            }
                        </select>
                        </div>
                    </div>

                    <div class="sk-field">
                        <label class="sk-field__label" for="formatKind">Format</label>
                        <div class="sk-select-wrapper">
                            <select id="formatKind" class="sk-select" @bind="_selectedFormat">
                            <option value="@ExportFormat.Json">JSON</option>
                            <option value="@ExportFormat.Csv">CSV</option>
                        </select>
                        </div>
                    </div>

                    <div class="sk-field">
                        <label class="sk-field__label" for="projectScope">Project Scope</label>
                        <div class="sk-select-wrapper">
                            <select id="projectScope" class="sk-select" @bind="_projectExportScope" @bind:after="OnProjectScopeChanged">
                            <option value="@ProjectExportScope.SpecificProject">Specific Project</option>
                            <option value="@ProjectExportScope.AllProjects">All Projects</option>
                        </select>
                        </div>
                    </div>

                    <div class="sk-field">
                        <label class="sk-field__label" for="projectFilter">Project</label>
                        <div class="sk-select-wrapper">
                            <select id="projectFilter" class="sk-select" @bind="_projectFilterValue" disabled="@(_projectExportScope != ProjectExportScope.SpecificProject)">
                            <option value="">
                                @(_projectExportScope == ProjectExportScope.SpecificProject ? "Select a project" : "All projects selected")
                            </option>
                            @foreach (var project in _projects)
                            {
                                <option value="@project.ProjectId">@project.Code - @project.Name</option>
                            }
                        </select>
                        </div>
                    </div>

                    <div class="sk-field">
                        <label class="sk-field__label" for="fromDate">From (UTC date)</label>
                        <input id="fromDate" class="sk-input" type="date" value="@_fromDateText" @onchange="OnFromDateChanged" />
                    </div>

                    <div class="sk-field">
                        <label class="sk-field__label" for="toDate">To (UTC date)</label>
                        <input id="toDate" class="sk-input" type="date" value="@_toDateText" @onchange="OnToDateChanged" />
                    </div>

                    <p class="sk-field__hint export-full-width">Leave dates empty for all dates. Both selected dates are included, using UTC.</p>

                    @if (_selectedDataset == ExportDatasetKind.JournalEntries)
                    {
                        <div class="export-full-width">
                            <label class="sk-checkbox">
                                    <input id="includeSoftDeleted" class="sk-checkbox__input" type="checkbox" @bind="_includeSoftDeleted" />
                                <span class="sk-checkbox__box" aria-hidden="true"></span>
                                <span class="sk-checkbox__content">
                                    <span class="sk-checkbox__label">Include soft-deleted journal entries (admin only)</span>
                                </span>
                            </label>
                        </div>
                    }
                    else if (_selectedDataset == ExportDatasetKind.AuditLogs)
                    {
                        <div class="sk-field">
                            <label class="sk-field__label" for="actorUsername">Actor username contains</label>
                            <input id="actorUsername" class="sk-input" @bind="_auditActorUsername" />
                        </div>

                        <div class="sk-field">
                            <label class="sk-field__label" for="auditOutcome">Outcome</label>
                            <div class="sk-select-wrapper">
                                <select id="auditOutcome" class="sk-select" @bind="_auditOutcomeValue">
                                <option value="">Any</option>
                                @foreach (var outcome in _auditOutcomes)
                                {
                                    <option value="@outcome">@outcome</option>
                                }
                            </select>
                            </div>
                        </div>

                        <div class="sk-field">
                            <label class="sk-field__label" for="auditAction">Action</label>
                            <div class="sk-select-wrapper">
                                <select id="auditAction" class="sk-select" @bind="_auditActionValue">
                                <option value="">Any</option>
                                @foreach (var action in _auditActions)
                                {
                                    <option value="@action">@action</option>
                                }
                            </select>
                            </div>
                        </div>

                        <div class="sk-field">
                            <label class="sk-field__label" for="auditEntity">Entity Type</label>
                            <div class="sk-select-wrapper">
                                <select id="auditEntity" class="sk-select" @bind="_auditEntityValue">
                                <option value="">Any</option>
                                @foreach (var entity in _auditEntities)
                                {
                                    <option value="@entity">@entity</option>
                                }
                            </select>
                            </div>
                        </div>
                    }
                </div>

                <div class="sk-cluster sj-form-actions">
                    <button type="button" class="sk-button sk-button--primary" disabled="@_isGenerating" @onclick="ReviewExport">Review export</button>
                    <button type="button" class="sk-button sk-button--secondary" disabled="@_isGenerating" @onclick="ClearFilters">Reset filters</button>
                    @if (_exportResult is not null)
                    {
                        <button type="button" class="sk-button sk-button--secondary" disabled="@_isGenerating" @onclick="DownloadAgainAsync">Download previous file again</button>
                    }
                </div>
            }
        }
</section>
<aside class="panel-card export-guide" aria-label="Export guidance">
    <h2>Before you export</h2>
    <ol>
        <li><strong>Keep the scope focused.</strong><span>Select a project and date range for the records you need.</span></li>
        <li><strong>Choose a useful format.</strong><span>CSV works with spreadsheets. JSON preserves the record structure for other tools.</span></li>
        <li><strong>Check before downloading.</strong><span>Review the scope and how you will store the file.</span></li>
    </ol>
    @if (_exportResult is not null)
    {
        <div class="export-last-file" role="status">
            <strong>Last prepared file</strong>
            <p>@_exportResult.FileName</p>
        </div>
    }
</aside>
</div>

@code {
    private enum ExportDatasetKind
    {
        JournalEntries,
        AuditLogs
    }

    private enum ProjectExportScope
    {
        AllProjects,
        SpecificProject
    }

    private readonly AuditActionType[] _auditActions = Enum.GetValues<AuditActionType>();
    private readonly AuditEntityType[] _auditEntities = Enum.GetValues<AuditEntityType>();
    private readonly AuditOutcome[] _auditOutcomes = Enum.GetValues<AuditOutcome>();

    private UserContext? _currentUser;
    private List<ProjectOverview> _projects = new();

    private ExportDatasetKind _selectedDataset = ExportDatasetKind.JournalEntries;
    private ExportFormat _selectedFormat = ExportFormat.Json;
    private ProjectExportScope _projectExportScope = ProjectExportScope.SpecificProject;

    private string? _projectFilterValue;
    private string? _fromDateText;
    private string? _toDateText;
    private bool _includeSoftDeleted;

    private string? _auditActorUsername;
    private string? _auditActionValue;
    private string? _auditEntityValue;
    private string? _auditOutcomeValue;

    private ExportFileResult? _exportResult;
    private string? _error;
    private string? _message;
    private bool _isReviewing;
    private bool _isGenerating;

    private string DatasetLabel => _selectedDataset == ExportDatasetKind.JournalEntries ? "Journal entries" : "Audit events";
    private string ProjectScopeLabel => _projectExportScope == ProjectExportScope.AllProjects
        ? "All projects"
        : _projects.FirstOrDefault(candidate => candidate.ProjectId == SelectedProjectIdForExport()) is { } project
            ? $"{project.Code} — {project.Name}"
            : "No project selected";

    private static string FilterLabel(string? value) => string.IsNullOrWhiteSpace(value) ? "Any" : value;

    private bool CanExportJournal => _currentUser?.Role == AppRole.Administrator;
    private bool CanExportAudit => _currentUser?.Role is AppRole.Administrator or AppRole.Auditor;
    private bool CanExportAnything => CanExportJournal || CanExportAudit;

    protected override async Task OnInitializedAsync()
    {
        if (!await JournalApp.HasCurrentUserAsync())
        {
            Navigation.NavigateTo("/", forceLoad: false);
            return;
        }

        _currentUser = await JournalApp.GetCurrentUserAsync();
        _projects = JournalApp.GetProjects().ToList();

        if (!CanExportJournal && CanExportAudit)
        {
            _selectedDataset = ExportDatasetKind.AuditLogs;
        }

        OnProjectScopeChanged();
    }

    private void ReviewExport()
    {
        if (_isGenerating) return;
        _error = null;
        _message = null;
        if (!ValidateSelection())
        {
            return;
        }

        _exportResult = null;
        _isReviewing = true;
    }

    private bool ValidateSelection()
    {
        if (_projectExportScope == ProjectExportScope.SpecificProject && SelectedProjectIdForExport() is null)
        {
            _error = "Choose a project, or explicitly select All Projects.";
            return false;
        }

        if (ParseFromDate(_fromDateText) is { } from && ParseToDate(_toDateText) is { } to && from > to)
        {
            _error = "The end date must be on or after the start date.";
            return false;
        }

        return true;
    }

    private void EditConfiguration()
    {
        if (_isGenerating) return;
        _isReviewing = false;
        _error = null;
    }

    private async Task GenerateExportAsync()
    {
        if (_isGenerating || !_isReviewing || !ValidateSelection()) return;
        _error = null;
        _message = null;
        _isGenerating = true;

        try
        {
            _exportResult = _selectedDataset switch
            {
                ExportDatasetKind.JournalEntries => JournalApp.ExportJournalEntries(new JournalExportRequest
                {
                    Format = _selectedFormat,
                    Filter = new JournalExportFilter
                    {
                        ProjectId = SelectedProjectIdForExport(),
                        FromUtc = ParseFromDate(_fromDateText),
                        ToUtc = ParseToDate(_toDateText),
                        IncludeSoftDeleted = _includeSoftDeleted
                    }
                }),
                ExportDatasetKind.AuditLogs => JournalApp.ExportAuditLogs(new AuditExportRequest
                {
                    Format = _selectedFormat,
                    Filter = new AuditSearchFilter
                    {
                        ProjectId = SelectedProjectIdForExport(),
                        FromUtc = ParseFromDate(_fromDateText),
                        ToUtc = ParseToDate(_toDateText),
                        ActorUsername = _auditActorUsername,
                        Action = Enum.TryParse<AuditActionType>(_auditActionValue, out var action) ? action : null,
                        EntityType = Enum.TryParse<AuditEntityType>(_auditEntityValue, out var entityType) ? entityType : null,
                        Outcome = Enum.TryParse<AuditOutcome>(_auditOutcomeValue, out var outcome) ? outcome : null
                    }
                }),
                _ => throw new InvalidOperationException("Unsupported export dataset.")
            };

            await DownloadExport();
            _message = $"{_exportResult.Summary} Download started. Check your browser's downloads.";
            _isReviewing = false;
        }
        catch (Exception ex)
        {
            _exportResult = null;
            _error = ex.Message;
        }
        finally
        {
            _isGenerating = false;
        }
    }

    private async Task DownloadAgainAsync()
    {
        if (_isGenerating || _exportResult is null) return;
        _isGenerating = true;
        _error = null;
        try
        {
            await DownloadExport();
            _message = "Download started. Check your browser's downloads.";
        }
        catch (Exception)
        {
            _error = "The download could not start. Try downloading the file again.";
        }
        finally
        {
            _isGenerating = false;
        }
    }

    private async Task DownloadExport()
    {
        if (_exportResult is null)
        {
            return;
        }

        await JS.InvokeVoidAsync(
            "secureJournalDownloads.downloadText",
            _exportResult.FileName,
            _exportResult.ContentType,
            _exportResult.ContentText);
    }

    private void ClearFilters()
    {
        if (_isGenerating) return;
        _projectFilterValue = null;
        _projectExportScope = ProjectExportScope.SpecificProject;
        _fromDateText = null;
        _toDateText = null;
        _includeSoftDeleted = false;
        _auditActorUsername = null;
        _auditActionValue = null;
        _auditEntityValue = null;
        _auditOutcomeValue = null;
        _error = null;
        _message = null;
        _exportResult = null;
        _isReviewing = false;
    }

    private void OnFromDateChanged(ChangeEventArgs args) => _fromDateText = EmptyToNull(args.Value?.ToString());

    private void OnToDateChanged(ChangeEventArgs args) => _toDateText = EmptyToNull(args.Value?.ToString());

    private static string? EmptyToNull(string? value) => string.IsNullOrWhiteSpace(value) ? null : value;

    private void OnProjectScopeChanged()
    {
        if (_projectExportScope != ProjectExportScope.SpecificProject)
        {
            _projectFilterValue = null;
        }
    }

    private Guid? SelectedProjectIdForExport()
        => _projectExportScope == ProjectExportScope.SpecificProject
            ? TryParseGuid(_projectFilterValue)
            : null;

    private static Guid? TryParseGuid(string? value)
        => Guid.TryParse(value, out var parsed) ? parsed : null;

    private static DateTime? ParseFromDate(string? value)
    {
        if (!DateTime.TryParse(value, out var parsed))
        {
            return null;
        }

        return DateTime.SpecifyKind(parsed.Date, DateTimeKind.Utc);
    }

    private static DateTime? ParseToDate(string? value)
    {
        if (!DateTime.TryParse(value, out var parsed))
        {
            return null;
        }

        var endOfDay = parsed.Date == DateTime.MaxValue.Date
            ? DateTime.MaxValue
            : parsed.Date.AddDays(1).AddTicks(-1);
        return DateTime.SpecifyKind(endOfDay, DateTimeKind.Utc);
    }
}
