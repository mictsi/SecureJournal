@implements IDisposable
@using Microsoft.AspNetCore.Components.Routing
@using SecureJournal.Core.Domain
@inject ISecureJournalAppService JournalApp
@inject NavigationManager Navigation

<nav class="sk-side-nav sk-app-shell__nav @(IsOpen ? "is-open" : string.Empty)"
     id="primary-nav"
     aria-label="Primary">
    <h2 class="sk-side-nav__group-label" id="nav-workspace">Workspace</h2>
    <ul class="sk-side-nav__list" aria-labelledby="nav-workspace">
        <li>
            <NavLink class="sk-side-nav__item" href="projects" Match="NavLinkMatch.Prefix" @onclick="HandleNavigate">
                <svg aria-hidden="true" focusable="false" width="20" height="20"><use href="#sk-icon-folder" /></svg>
                <span class="sk-side-nav__label">My projects</span>
            </NavLink>
        </li>
        <li>
            <NavLink class="sk-side-nav__item" href="journal" Match="NavLinkMatch.All" @onclick="HandleNavigate">
                <svg aria-hidden="true" focusable="false" width="20" height="20"><use href="#sk-icon-book" /></svg>
                <span class="sk-side-nav__label">New journal entry</span>
            </NavLink>
        </li>
    </ul>

    @if (_canAccessAudit || _canAccessExports)
    {
        <h2 class="sk-side-nav__group-label" id="nav-evidence">Evidence</h2>
        <ul class="sk-side-nav__list" aria-labelledby="nav-evidence">
            @if (_canAccessAudit)
            {
                <li>
                    <NavLink class="sk-side-nav__item" href="audit" Match="NavLinkMatch.All" @onclick="HandleNavigate">
                        <svg aria-hidden="true" focusable="false" width="20" height="20"><use href="#sk-icon-search" /></svg>
                        <span class="sk-side-nav__label">Audit search</span>
                    </NavLink>
                </li>
            }

            @if (_canAccessExports)
            {
                <li>
                    <NavLink class="sk-side-nav__item" href="exports" Match="NavLinkMatch.All" @onclick="HandleNavigate">
                        <svg aria-hidden="true" focusable="false" width="20" height="20"><use href="#sk-icon-download" /></svg>
                        <span class="sk-side-nav__label">Exports</span>
                    </NavLink>
                </li>
            }
        </ul>
    }

    @if (_showAdminLinks)
    {
        <h2 class="sk-side-nav__group-label" id="nav-admin">Administration</h2>
        <ul class="sk-side-nav__list" aria-labelledby="nav-admin">
            <li>
                <NavLink class="sk-side-nav__item" href="admin/projects/create" Match="NavLinkMatch.Prefix" @onclick="HandleNavigate">
                    <svg aria-hidden="true" focusable="false" width="20" height="20"><use href="#sk-icon-plus" /></svg>
                    <span class="sk-side-nav__label">Create project</span>
                </NavLink>
            </li>
            <li>
                <NavLink class="sk-side-nav__item" href="admin/users" Match="NavLinkMatch.All" @onclick="HandleNavigate">
                    <svg aria-hidden="true" focusable="false" width="20" height="20"><use href="#sk-icon-users" /></svg>
                    <span class="sk-side-nav__label">User management</span>
                </NavLink>
            </li>
            <li>
                <NavLink class="sk-side-nav__item" href="admin/groups" Match="NavLinkMatch.All" @onclick="HandleNavigate">
                    <svg aria-hidden="true" focusable="false" width="20" height="20"><use href="#sk-icon-group" /></svg>
                    <span class="sk-side-nav__label">Group management</span>
                </NavLink>
            </li>
            <li>
                <NavLink class="sk-side-nav__item" href="admin/projects" Match="NavLinkMatch.All" @onclick="HandleNavigate">
                    <svg aria-hidden="true" focusable="false" width="20" height="20"><use href="#sk-icon-settings" /></svg>
                    <span class="sk-side-nav__label">Project management</span>
                </NavLink>
            </li>
            <li>
                <NavLink class="sk-side-nav__item" href="admin/projects/trash" Match="NavLinkMatch.All" @onclick="HandleNavigate">
                    <svg aria-hidden="true" focusable="false" width="20" height="20"><use href="#sk-icon-trash" /></svg>
                    <span class="sk-side-nav__label">Trash</span>
                </NavLink>
            </li>
        </ul>
    }
</nav>

@code {
    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public EventCallback OnNavigate { get; set; }

    private bool _showAdminLinks;
    private bool _canAccessAudit;
    private bool _canAccessExports;

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += HandleLocationChanged;
        await LoadCurrentUserAsync();
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= HandleLocationChanged;
    }

    private async Task LoadCurrentUserAsync()
    {
        if (!await JournalApp.HasCurrentUserAsync())
        {
            _showAdminLinks = false;
            _canAccessAudit = false;
            _canAccessExports = false;
            return;
        }

        var currentUser = await JournalApp.GetCurrentUserAsync();
        _showAdminLinks = currentUser.Role == AppRole.Administrator;
        _canAccessAudit = currentUser.Role is AppRole.Administrator or AppRole.Auditor;
        _canAccessExports = _canAccessAudit;
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private Task HandleNavigate() => OnNavigate.InvokeAsync();
}
