@page "/projects/entry/{RecordId:guid}"
@attribute [Authorize]
@inject ISecureJournalAppService JournalApp
@inject NavigationManager Navigation
@using SecureJournal.Web.Utilities

<PageTitle>Journal entry · Secure Journal</PageTitle>

<PageHeader Title="Journal entry"
            Description="A saved record in your project's history.">
    <Actions>
        <a href="@BackUrl" class="sk-button sk-button--secondary">
            <svg class="sk-button__icon" aria-hidden="true" focusable="false" width="16" height="16"><use href="#sk-icon-chevron-left" /></svg>
            Back to project
        </a>
    </Actions>
</PageHeader>

<PageAlerts Error="@_error" />

@if (_entry is not null)
{
    <section class="panel-card entry-detail-card">
        <div class="panel-card-header">
            <div>
                <p class="entry-project-label">@_entry.ProjectCode · @_entry.ProjectName</p>
                <h2>@_entry.Subject</h2>
            </div>
            <span class="sk-badge @(_entry.IsSoftDeleted ? "sk-badge--warning" : "sk-badge--success")">@(_entry.IsSoftDeleted ? "Deleted" : "Saved")</span>
        </div>

        <dl class="meta-list">
            <dt>Created (UTC)</dt>
            <dd><time datetime="@_entry.CreatedAtUtc.ToString("o")">@_entry.CreatedAtUtc.ToString("dd MMM yyyy, HH:mm:ss")</time></dd>
            <dt>Author</dt>
            <dd>@_entry.CreatedBy</dd>
            @if (_entry.IsSoftDeleted)
            {
                <dt>Deleted (UTC)</dt>
                <dd>@_entry.DeletedAtUtc?.ToString("dd MMM yyyy, HH:mm:ss") by @_entry.DeletedBy</dd>
            }
        </dl>
    </section>

    <section class="panel-card entry-detail-card">
        <div class="entry-view-grid">
            <div class="entry-view-block">
                <h3>Description</h3>
                <div class="entry-view-text rich-content">@SimpleMarkupPreview.Render(_entry.Description)</div>
            </div>
            <div class="entry-view-block">
                <h3>Notes</h3>
                @if (string.IsNullOrWhiteSpace(_entry.Notes))
                {
                    <p class="sj-muted">No additional notes.</p>
                }
                else
                {
                    <div class="entry-view-text rich-content">@SimpleMarkupPreview.Render(_entry.Notes)</div>
                }
            </div>
            @if (_entry.IsSoftDeleted && !string.IsNullOrWhiteSpace(_entry.DeleteReason))
            {
                <div class="entry-view-block entry-view-block-full">
                    <h3>Delete reason</h3>
                    <div class="entry-view-text rich-content">@SimpleMarkupPreview.Render(_entry.DeleteReason)</div>
                </div>
            }
        </div>

        <div class="entry-detail-footer">
            <p class="sj-muted">Saved entries cannot be edited. Create a follow-up entry to add new information.</p>
            @if (!_entry.IsSoftDeleted)
            {
                <a href="@($"/journal?projectId={_entry.ProjectId:D}")" class="sk-button sk-button--primary">New entry in this project</a>
            }
        </div>
    </section>
}
else if (string.IsNullOrWhiteSpace(_error))
{
    <section class="panel-card">
        <p>Entry not found or you do not have access to view it.</p>
    </section>
}

@code {
    [Parameter]
    public Guid RecordId { get; set; }

    [SupplyParameterFromQuery(Name = "projectId")]
    public Guid? ProjectId { get; set; }

    private UserContext? _currentUser;
    private JournalEntryView? _entry;
    private string? _error;

    private string BackUrl
        => _entry is not null
            ? $"/projects?projectId={_entry.ProjectId:D}"
            : ProjectId.HasValue
                ? $"/projects?projectId={ProjectId.Value:D}"
                : "/projects";

    protected override async Task OnParametersSetAsync()
    {
        if (!await JournalApp.HasCurrentUserAsync())
        {
            Navigation.NavigateTo("/", forceLoad: false);
            return;
        }

        _currentUser = await JournalApp.GetCurrentUserAsync();
        if (_currentUser.Role == AppRole.Auditor)
        {
            _entry = null;
            _error = "Auditors cannot view full journal entry details.";
            return;
        }

        LoadEntry();
    }

    private void LoadEntry()
    {
        _error = null;
        _entry = null;

        try
        {
            var entries = JournalApp.GetJournalEntries(ProjectId, includeSoftDeleted: true);
            _entry = entries.FirstOrDefault(e => e.RecordId == RecordId);

            if (_entry is null && ProjectId.HasValue)
            {
                _entry = JournalApp.GetJournalEntries(projectId: null, includeSoftDeleted: true)
                    .FirstOrDefault(e => e.RecordId == RecordId);
            }

            if (_entry is null)
            {
                _error = "Journal entry was not found or is not accessible for your account.";
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }
}
