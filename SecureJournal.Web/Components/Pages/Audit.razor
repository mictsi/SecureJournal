@page "/audit"
@attribute [Authorize(Roles = "Administrator,Auditor")]
@inject ISecureJournalAppService JournalApp
@inject NavigationManager Navigation
@using SecureJournal.Web.Utilities

<PageTitle>Audit Search</PageTitle>

<PageHeader Title="Audit search"
            Description="Filter audit events on searchable metadata — time range, user, project, action, entity and outcome — and read the linked journal entry when a row references one. Event details are stored in plaintext per the current specification decision, with SHA-256 checksums for integrity." />

<PageAlerts Error="@_error" />

<section class="sk-card sj-panel">
    <div class="sk-card__header">
        <h2 class="sk-card__title">Filters</h2>
        <div class="sk-cluster sk-cluster--gap-8">
            <button type="button" class="sk-button sk-button--primary sk-button--sm" @onclick="ApplyFilters">Apply filters</button>
            <button type="button" class="sk-button sk-button--secondary sk-button--sm" @onclick="ClearFilters">Clear filters</button>
        </div>
    </div>

    <div class="sk-card__body">
        <div class="sk-grid sk-grid--cols-4 sk-grid--gap-16">
            <div class="sk-field">
                <label class="sk-field__label" for="fromDate">From (UTC date)</label>
                <input id="fromDate" class="sk-input" type="date" value="@_fromDateText" @onchange="OnFromDateChanged" />
            </div>
            <div class="sk-field">
                <label class="sk-field__label" for="toDate">To (UTC date)</label>
                <input id="toDate" class="sk-input" type="date" value="@_toDateText" @onchange="OnToDateChanged" />
            </div>
            <div class="sk-field">
                <label class="sk-field__label" for="actorText">User</label>
                <input id="actorText" class="sk-input" type="text" placeholder="alice.admin" @bind="_actorUsername" />
            </div>
            <div class="sk-field">
                <label class="sk-field__label" for="projectFilter">Project</label>
                <div class="sk-select-wrapper">
                    <select id="projectFilter" class="sk-select" @bind="_projectFilterValue">
                        <option value="">Any</option>
                        @foreach (var project in _projects)
                        {
                            <option value="@project.ProjectId">@project.Code - @project.Name</option>
                        }
                    </select>
                </div>
            </div>
            <div class="sk-field">
                <label class="sk-field__label" for="actionFilter">Action</label>
                <div class="sk-select-wrapper">
                    <select id="actionFilter" class="sk-select" @bind="_actionFilterValue">
                        <option value="">Any</option>
                        @foreach (var action in _auditActions)
                        {
                            <option value="@action">@action</option>
                        }
                    </select>
                </div>
            </div>
            <div class="sk-field">
                <label class="sk-field__label" for="entityFilter">Entity</label>
                <div class="sk-select-wrapper">
                    <select id="entityFilter" class="sk-select" @bind="_entityFilterValue">
                        <option value="">Any</option>
                        @foreach (var entity in _auditEntities)
                        {
                            <option value="@entity">@entity</option>
                        }
                    </select>
                </div>
            </div>
            <div class="sk-field">
                <label class="sk-field__label" for="outcomeFilter">Outcome</label>
                <div class="sk-select-wrapper">
                    <select id="outcomeFilter" class="sk-select" @bind="_outcomeFilterValue">
                        <option value="">Any</option>
                        @foreach (var outcome in _auditOutcomes)
                        {
                            <option value="@outcome">@outcome</option>
                        }
                    </select>
                </div>
            </div>
            <div class="sk-field">
                <label class="sk-field__label" for="textFieldFilter">Text field</label>
                <div class="sk-select-wrapper">
                    <select id="textFieldFilter" class="sk-select" @bind="_textSearchField">
                        @foreach (var field in _textSearchFields)
                        {
                            <option value="@field">@GetTextSearchFieldLabel(field)</option>
                        }
                    </select>
                </div>
            </div>
            <div class="sk-field sk-grid__span-full">
                <label class="sk-field__label" for="textContains">Contains (case-insensitive)</label>
                <input id="textContains" class="sk-input" type="text" placeholder="Search within the selected field…" @bind="_textSearchValue" />
            </div>
        </div>
    </div>
</section>

<section class="sk-card sj-panel">
    <div class="sk-card__header">
        <h2 class="sk-card__title">Results</h2>
        <span class="sk-badge sk-badge--neutral">@_rows.Count event(s)</span>
    </div>

    <div class="sk-card__body">
        @if (_rows.Count == 0)
        {
            <div class="sk-empty-state">
                <svg class="sk-empty-state__icon" aria-hidden="true" focusable="false" width="48" height="48"><use href="#sk-illus-search" /></svg>
                <h3 class="sk-empty-state__heading">No audit events match these filters</h3>
                <p class="sk-empty-state__body">
                    Widen the date range or clear a filter. If you expected results, your role may not permit viewing audit logs.
                </p>
                <div class="sk-empty-state__actions">
                    <button type="button" class="sk-button sk-button--secondary" @onclick="ClearFilters">Clear filters</button>
                </div>
            </div>
        }
        else
        {
            <div class="sk-cluster sk-cluster--between sk-cluster--gap-16 sj-table-toolbar">
                <div class="sk-field sk-field--inline">
                    <label class="sk-field__label" for="auditPageSize">Page size</label>
                    <div class="sk-select-wrapper">
                        <select id="auditPageSize" class="sk-select sk-select--sm" @onchange="OnPageSizeChanged">
                            @foreach (var pageSize in _pageSizeOptions)
                            {
                                <option value="@pageSize" selected="@(pageSize == _pageSize)">@pageSize</option>
                            }
                        </select>
                    </div>
                </div>
                <p class="sk-pagination__status" role="status">Page @_currentPage of @TotalPages</p>
            </div>

            @* Sekura's responsive-tables pattern: scroll the table, never drop a
               column. The region is focusable so the scroll is keyboard-reachable. *@
            <div class="sk-table sj-audit-table" role="region" aria-labelledby="audit-caption" tabindex="0">
                <table>
                    <caption id="audit-caption" class="sk-visually-hidden">
                        Audit events
                        <span class="sk-table__caption-detail">@_rows.Count events, newest first</span>
                    </caption>
                    <thead>
                        <tr>
                            <th scope="col" class="sj-col-timestamp">Timestamp (UTC)</th>
                            <th scope="col" class="sj-col-user">User</th>
                            <th scope="col" class="sj-col-action">Action</th>
                            <th scope="col" class="sj-col-entity">Entity</th>
                            <th scope="col" class="sj-col-project">Project</th>
                            <th scope="col" class="sj-col-outcome">Outcome</th>
                            <th scope="col" class="sj-col-details">Details</th>
                            <th scope="col" class="sj-col-integrity">Integrity</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in PagedRows)
                        {
                            <tr>
                                <td class="sj-col-timestamp">
                                    <time datetime="@row.TimestampUtc.ToString("o")">@row.TimestampUtc.ToString("yyyy-MM-dd")</time>
                                    <span class="sj-cell-secondary">@row.TimestampUtc.ToString("HH:mm:ss")</span>
                                </td>
                                <td class="sj-col-user">@row.ActorUsername</td>
                                <td class="sj-col-action">@row.Action</td>
                                <td class="sj-col-entity">
                                    <div>@row.EntityType</div>
                                    @if (!string.IsNullOrWhiteSpace(row.EntityId))
                                    {
                                        <span class="sj-cell-id sk-truncate" title="@row.EntityId">@row.EntityId</span>
                                    }
                                </td>
                                <td class="sj-col-project">@(row.ProjectCode ?? "—")</td>
                                <td class="sj-col-outcome">
                                    <span class="sk-status @OutcomeStatusClass(row.Outcome)">
                                        <span class="sk-status__dot" aria-hidden="true"></span>
                                        <span class="sk-status__label">@row.Outcome</span>
                                    </span>
                                </td>
                                <td class="sj-col-details">
                                    <div>@row.Details</div>
                                    @if (row.RelatedJournalEntry is not null)
                                    {
                                        @* The preview is what used to crush every other column, so it
                                           is collapsed by default and opens in place. *@
                                        <div class="sk-disclosure sj-journal-preview" data-sk-disclosure>
                                            <button type="button" class="sk-disclosure__trigger"
                                                    id="@($"journal-trigger-{row.AuditId}")"
                                                    aria-expanded="false"
                                                    aria-controls="@($"journal-panel-{row.AuditId}")">
                                                <svg class="sk-disclosure__marker" aria-hidden="true" focusable="false" width="16" height="16"><use href="#sk-icon-chevron-right" /></svg>
                                                <span class="sk-disclosure__label">
                                                    Journal entry @row.RelatedJournalEntry.RecordId
                                                </span>
                                                @if (row.RelatedJournalEntry.IsSoftDeleted)
                                                {
                                                    <span class="sk-badge sk-badge--warning">Soft-deleted</span>
                                                }
                                            </button>
                                            <div class="sk-disclosure__panel sk-stack sk-stack--gap-8"
                                                 id="@($"journal-panel-{row.AuditId}")"
                                                 aria-labelledby="@($"journal-trigger-{row.AuditId}")"
                                                 hidden>
                                                <dl class="sk-dl">
                                                    <div class="sk-dl__group">
                                                        <dt class="sk-dl__term">Project</dt>
                                                        <dd class="sk-dl__detail">@row.RelatedJournalEntry.ProjectCode</dd>
                                                    </div>
                                                    <div class="sk-dl__group">
                                                        <dt class="sk-dl__term">Created</dt>
                                                        <dd class="sk-dl__detail">
                                                            <time datetime="@row.RelatedJournalEntry.CreatedAtUtc.ToString("o")">@row.RelatedJournalEntry.CreatedAtUtc.ToString("yyyy-MM-dd")</time> UTC
                                                        </dd>
                                                    </div>
                                                    <div class="sk-dl__group">
                                                        <dt class="sk-dl__term">Created by</dt>
                                                        <dd class="sk-dl__detail">@row.RelatedJournalEntry.CreatedBy</dd>
                                                    </div>
                                                    <div class="sk-dl__group">
                                                        <dt class="sk-dl__term">Subject</dt>
                                                        <dd class="sk-dl__detail">@row.RelatedJournalEntry.Subject</dd>
                                                    </div>
                                                </dl>
                                                <div>
                                                    <p class="sk-field__label">Description</p>
                                                    <div class="sk-prose rich-content">@SimpleMarkupPreview.Render(row.RelatedJournalEntry.Description)</div>
                                                </div>
                                                @if (!string.IsNullOrWhiteSpace(row.RelatedJournalEntry.Notes))
                                                {
                                                    <div>
                                                        <p class="sk-field__label">Notes</p>
                                                        <div class="sk-prose rich-content">@SimpleMarkupPreview.Render(row.RelatedJournalEntry.Notes)</div>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    }
                                </td>
                                <td class="sj-col-integrity">
                                    <div class="sk-stack sk-stack--gap-4">
                                        <code class="sk-code sj-checksum" title="@row.DetailsChecksum">@row.DetailsChecksum</code>
                                        <button type="button" class="sk-button sk-button--secondary sk-button--sm" @onclick="() => ValidateChecksum(row.AuditId)">
                                            Validate
                                        </button>
                                        @if (_checksumValidationResults.TryGetValue(row.AuditId, out var validation))
                                        {
                                            @if (validation.IsValid)
                                            {
                                                <span class="sk-status sk-status--success">
                                                    <span class="sk-status__dot" aria-hidden="true"></span>
                                                    <span class="sk-status__label">Valid</span>
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="sk-status sk-status--danger" title="@($"Computed: {validation.ComputedChecksum}")">
                                                    <span class="sk-status__dot" aria-hidden="true"></span>
                                                    <span class="sk-status__label">Invalid</span>
                                                </span>
                                            }
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <nav class="sk-pagination" aria-label="Pagination">
                <p class="sk-pagination__status" role="status">Showing @PagedRows.Count() of @_rows.Count results</p>
                <div class="sk-cluster sk-cluster--gap-8">
                    <button type="button" class="sk-button sk-button--secondary sk-button--sm" disabled="@(_currentPage <= 1)" @onclick="PreviousPage">Previous</button>
                    <button type="button" class="sk-button sk-button--secondary sk-button--sm" disabled="@(_currentPage >= TotalPages)" @onclick="NextPage">Next</button>
                </div>
            </nav>
        }
    </div>
</section>

@code {
    private enum AuditTextSearchField
    {
        Details,
        ActorUsername,
        EntityId,
        ProjectCode,
        Action,
        EntityType,
        Outcome
    }

    private static string OutcomeStatusClass(AuditOutcome outcome) => outcome switch
    {
        AuditOutcome.Success => "sk-status--success",
        AuditOutcome.Denied => "sk-status--danger",
        _ => "sk-status--warning"
    };

    private readonly AuditActionType[] _auditActions = Enum.GetValues<AuditActionType>();
    private readonly AuditEntityType[] _auditEntities = Enum.GetValues<AuditEntityType>();
    private readonly AuditOutcome[] _auditOutcomes = Enum.GetValues<AuditOutcome>();
    private readonly int[] _pageSizeOptions = [10, 20, 50, 100];
    private readonly AuditTextSearchField[] _textSearchFields = Enum.GetValues<AuditTextSearchField>();

    private List<ProjectOverview> _projects = new();
    private List<AuditLogView> _rows = new();
    private Dictionary<Guid, AuditChecksumValidationResult> _checksumValidationResults = new();
    private string? _error;
    private int _pageSize = 20;
    private int _currentPage = 1;

    private string? _fromDateText;
    private string? _toDateText;
    private string? _actorUsername;
    private string? _projectFilterValue;
    private string? _actionFilterValue;
    private string? _entityFilterValue;
    private string? _outcomeFilterValue;
    private AuditTextSearchField _textSearchField = AuditTextSearchField.Details;
    private string? _textSearchValue;

    private IEnumerable<AuditLogView> PagedRows
        => _rows.Skip((_currentPage - 1) * _pageSize).Take(_pageSize);

    private int TotalPages
        => Math.Max(1, (int)Math.Ceiling(_rows.Count / (double)_pageSize));

    protected override async Task OnInitializedAsync()
    {
        if (!await JournalApp.HasCurrentUserAsync())
        {
            Navigation.NavigateTo("/", forceLoad: false);
            return;
        }

        _projects = JournalApp.GetProjects().ToList();
        ApplyFilters();
    }

    private void ApplyFilters()
    {
        _error = null;

        try
        {
            var filter = new AuditSearchFilter
            {
                FromUtc = ParseFromDate(_fromDateText),
                ToUtc = ParseToDate(_toDateText),
                ActorUsername = _actorUsername,
                ProjectId = Guid.TryParse(_projectFilterValue, out var projectId) ? projectId : null,
                Action = Enum.TryParse<AuditActionType>(_actionFilterValue, out var action) ? action : null,
                EntityType = Enum.TryParse<AuditEntityType>(_entityFilterValue, out var entityType) ? entityType : null,
                Outcome = Enum.TryParse<AuditOutcome>(_outcomeFilterValue, out var outcome) ? outcome : null
            };

            _rows = JournalApp.SearchAuditLogs(filter)
                .Where(MatchesSelectedTextSearch)
                .ToList();
            _checksumValidationResults.Clear();
            _currentPage = 1;
        }
        catch (Exception ex)
        {
            _rows = new List<AuditLogView>();
            _checksumValidationResults.Clear();
            _error = ex.Message;
            _currentPage = 1;
        }
    }

    private void ClearFilters()
    {
        _fromDateText = null;
        _toDateText = null;
        _actorUsername = null;
        _projectFilterValue = null;
        _actionFilterValue = null;
        _entityFilterValue = null;
        _outcomeFilterValue = null;
        _textSearchField = AuditTextSearchField.Details;
        _textSearchValue = null;
        _currentPage = 1;
        ApplyFilters();
    }

    private static DateTime? ParseFromDate(string? value)
    {
        if (!DateTime.TryParse(value, out var parsed))
        {
            return null;
        }

        return DateTime.SpecifyKind(parsed.Date, DateTimeKind.Utc);
    }

    private static DateTime? ParseToDate(string? value)
    {
        if (!DateTime.TryParse(value, out var parsed))
        {
            return null;
        }

        var endOfDay = parsed.Date.AddDays(1).AddTicks(-1);
        return DateTime.SpecifyKind(endOfDay, DateTimeKind.Utc);
    }

    private void OnFromDateChanged(ChangeEventArgs args)
    {
        _fromDateText = args.Value?.ToString();
    }

    private void OnToDateChanged(ChangeEventArgs args)
    {
        _toDateText = args.Value?.ToString();
    }

    private void OnPageSizeChanged(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var next) && _pageSizeOptions.Contains(next))
        {
            _pageSize = next;
            _currentPage = 1;
        }
    }

    private void PreviousPage()
    {
        if (_currentPage > 1)
        {
            _currentPage--;
        }
    }

    private void NextPage()
    {
        if (_currentPage < TotalPages)
        {
            _currentPage++;
        }
    }

    private void ValidateChecksum(Guid auditId)
    {
        _error = null;

        try
        {
            _checksumValidationResults[auditId] = JournalApp.ValidateAuditLogChecksum(auditId);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private bool MatchesSelectedTextSearch(AuditLogView row)
    {
        var needle = _textSearchValue?.Trim();
        if (string.IsNullOrWhiteSpace(needle))
        {
            return true;
        }

        var haystack = _textSearchField switch
        {
            AuditTextSearchField.Details => row.Details,
            AuditTextSearchField.ActorUsername => row.ActorUsername,
            AuditTextSearchField.EntityId => row.EntityId ?? string.Empty,
            AuditTextSearchField.ProjectCode => row.ProjectCode ?? string.Empty,
            AuditTextSearchField.Action => row.Action.ToString(),
            AuditTextSearchField.EntityType => row.EntityType.ToString(),
            AuditTextSearchField.Outcome => row.Outcome.ToString(),
            _ => row.Details
        };

        return haystack.Contains(needle, StringComparison.OrdinalIgnoreCase);
    }

    private static string GetTextSearchFieldLabel(AuditTextSearchField field)
        => field switch
        {
            AuditTextSearchField.ActorUsername => "Actor Username",
            AuditTextSearchField.EntityId => "Entity Id",
            AuditTextSearchField.ProjectCode => "Project Code",
            AuditTextSearchField.EntityType => "Entity Type",
            _ => field.ToString()
        };
}
